# ─── run mode ────────────────────────────────────────────────
# development (default)  = local DB + local storage + console SMS/M-Pesa,
#                          even if production credentials are present.
# LOCAL_TEST_PROD        = production details rehearsed locally: prod DB
#                          (PROD_DATABASE_URL), real R2, sandbox SMS/M-Pesa.
# production             = real everything (Render sets this).
APP_ENV="development"

# Database used only when APP_ENV=LOCAL_TEST_PROD. Render sets DATABASE_URL
# itself in production — do not copy the prod URL here for everyday use.
PROD_DATABASE_URL=""

# ─── database ───────────────────────────────────────────────
# App connects through PgBouncer (6432). Migrations use DIRECT (5432).
DATABASE_URL="postgresql://esoko:esoko_dev_only@localhost:6432/esoko?pgbouncer=true&connection_limit=10"
DIRECT_DATABASE_URL="postgresql://esoko:esoko_dev_only@localhost:5432/esoko"

# ─── redis ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── secrets — generate real ones for anything but local dev ─
# openssl rand -hex 32
SESSION_SECRET="dev_only_change_me_0000000000000000000000000000000000000000000000"
OTP_PEPPER="dev_only_change_me_1111111111111111111111111111111111111111111111"
AUDIT_CHAIN_SEED="dev_only_change_me_2222222222222222222222222222222222222222222222"

# ─── sms / ussd ─────────────────────────────────────────────
# console = print OTPs/RECEIPTS to stdout. mock = send to the local
# mock-sms catcher (docker-compose.yml, MailHog's counterpart for SMS) —
# view what was "sent" at http://localhost:8026. LOCAL_TEST_PROD defaults
# to sandbox (Africa's Talking sandbox credentials bill nothing). Never
# run a live provider in development — APP_ENV only allows console/mock
# there, whatever this is set to.
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID="ESOKO"
# Base URL for the mock-sms catcher, only used when SMS_PROVIDER=mock.
# Defaults to the docker-compose service name; override for host-side runs.
SMS_MOCK_URL="http://mock-sms:8080"

# ─── email ──────────────────────────────────────────────────
# mailhog (default in development/LOCAL_TEST_PROD) = every email goes to
# the mailhog container — view what was "sent" at http://localhost:8025.
# console = print to stdout instead, for debugging without docker.
# production defaults to console so a misconfigured deploy fails loud
# rather than silently emailing nobody — set EMAIL_PROVIDER=smtp there
# with the SMTP_* vars below filled in.
EMAIL_PROVIDER="mailhog"
EMAIL_FROM="Esoko <no-reply@esoko.co.ke>"
# Defaults to the docker-compose mailhog service; override for
# host-side runs or a real SMTP provider in production.
SMTP_HOST="mailhog"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# ─── m-pesa ─────────────────────────────────────────────────
# console = log the STK push and auto-confirm locally. sandbox/production
# = real Daraja calls (needs every var below). LOCAL_TEST_PROD defaults to
# sandbox; development always forces console regardless of this setting.
# All four of CONSUMER_KEY/CONSUMER_SECRET/SHORTCODE/PASSKEY are required
# together — Daraja rejects an STK push missing any one of them. SHORTCODE
# and PASSKEY come from the same Daraja app as the key/secret pair (Test
# Credentials tab for sandbox, Go-Live pack for production) — a paybill/
# till number alone is not a passkey. CALLBACK_URL must be a public HTTPS
# URL Safaricom's servers can reach — never localhost; in a deployed
# environment this is esoko-core's own /webhooks/mpesa/stk-callback route.
MPESA_PROVIDER="console"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="http://localhost:4000/webhooks/mpesa/stk-callback"

# console = log the Pesapal order and auto-confirm locally. sandbox/
# production = real Pesapal calls (needs every var below). Same gating as
# MPESA_PROVIDER above. PESAPAL_IPN_ID comes from a one-time Pesapal
# URLSetup/RegisterIPN call against PESAPAL_IPN_URL — a static credential
# from then on, not something requested per-order. PESAPAL_IPN_URL must be
# a public HTTPS URL Pesapal's servers can reach — never localhost; in a
# deployed environment this is esoko-core's own /webhooks/pesapal/ipn route.
PESAPAL_PROVIDER="console"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_IPN_ID=""
PESAPAL_IPN_URL="http://localhost:4000/webhooks/pesapal/ipn"

# ─── file storage ───────────────────────────────────────────
# STORAGE_PROVIDER unset: local disk in development (files under
# <repo>/.data/storage, gitignored), R2 in LOCAL_TEST_PROD/production.
# Force either with STORAGE_PROVIDER=r2|local.
LOCAL_STORAGE_DIR=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="esoko"

# ─── urls ───────────────────────────────────────────────────
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_STORE_URL="http://localhost:3003"
CORE_API_URL="http://localhost:4000"
# services/core-go — the mobile REST API (see docs/adr/0005-mobile-api-in-go.md).
# apps/app, apps/store and apps/jamii's subject sign-in Server Actions call
# this for OTP/PIN/session instead of their own copy of packages/auth's
# functions, so both surfaces share one implementation. Same Redis, so a
# session core-go creates is readable by packages/auth's own
# ctxFromToken unchanged — only issuance moved, not validation.
CORE_GO_API_URL="http://localhost:4100"
# Cross-promotion link on /join — CECF's WordPress multisite (services/cecf-wordpress)
NEXT_PUBLIC_CECF_URL="http://childeldercare.test"
# Shared HMAC secret for services/core's /api/cecf/* facade — the CECF
# WordPress site's PHP backend signs every request with this (never the
# browser; see services/cecf-wordpress/.env's own copy of this same
# value). Rotate by updating both sides together.
CECF_SERVICE_SECRET=""

# Our Jamii custom domains — see docs/proposals/our-jamii-custom-domains.md.
# Comma-separated hosts apps/jamii's middleware treats as itself, never
# rewritten. Anything else is looked up as a possible group domain.
JAMII_PRIMARY_HOSTS="ourjamii.co.ke,localhost,127.0.0.1"
# Absolute origin used when a page rendered on a custom domain needs to
# link back to a route middleware deliberately doesn't serve there
# (e.g. "Manage this page" -> /dashboard).
NEXT_PUBLIC_JAMII_PRIMARY_ORIGIN="https://ourjamii.co.ke"
# Shown to a group as the CNAME target when they link their own domain —
# Cloudflare for SaaS's fallback origin for this zone.
NEXT_PUBLIC_JAMII_DOMAIN_TARGET="sites.ourjamii.co.ke"

# Cloudflare for SaaS — Custom Hostnames. Core-plane only (services/core);
# never set in apps/jamii's env. Token needs Zone:SSL and Custom
# Hostnames write, scoped to exactly the zone above.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
# Shared secret the reconcile cron sends as X-Reconcile-Secret when
# calling services/core's POST /internal/jamii-domains/reconcile.
JAMII_DOMAIN_RECONCILE_SECRET=""

# ─── ops ────────────────────────────────────────────────────
OTP_RATE_LIMIT_PER_HOUR="5"
OTP_DAILY_SPEND_CAP_KES="5000"

# ─── admin seed ─────────────────────────────────────────────
# PIN used when seeding the initial super-admin (ops@esoko.co.ke).
# Change this before deploying to any shared environment.
SEED_ADMIN_PIN="482915"

# Pre-computed Argon2id hash of SEED_ADMIN_PIN. When set, the seed
# script uses this value directly instead of hashing at seed time.
# Generate with: node -e "const {hash}=require('@node-rs/argon2'); hash('482915',{memoryCost:19456,timeCost:2,parallelism:1}).then(console.log)"
# SEED_ADMIN_HASH=""
SEED_ADMIN_HASH=""
