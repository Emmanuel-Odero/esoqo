# ─── database ───────────────────────────────────────────────
# App connects through PgBouncer (6432). Migrations use DIRECT (5432).
DATABASE_URL="postgresql://esoko:esoko_dev_only@localhost:6432/esoko?pgbouncer=true&connection_limit=10"
DIRECT_DATABASE_URL="postgresql://esoko:esoko_dev_only@localhost:5432/esoko"

# ─── redis ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── secrets — generate real ones for anything but local dev ─
# openssl rand -hex 32
SESSION_SECRET="dev_only_change_me_0000000000000000000000000000000000000000000000"
OTP_PEPPER="dev_only_change_me_1111111111111111111111111111111111111111111111"
AUDIT_CHAIN_SEED="dev_only_change_me_2222222222222222222222222222222222222222222222"

# ─── sms / ussd ─────────────────────────────────────────────
# console = print OTPs to stdout. Never use in production.
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID="ESOKO"

# ─── m-pesa ─────────────────────────────────────────────────
# console = log the STK push and auto-confirm locally. Never use in
# production. sandbox = real Daraja sandbox calls (needs the vars below).
MPESA_PROVIDER="console"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="http://localhost:4000/webhooks/mpesa/stk-callback"

# ─── urls ───────────────────────────────────────────────────
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_STORE_URL="http://localhost:3003"
CORE_API_URL="http://localhost:4000"
# Cross-promotion link on /join — CECF's WordPress multisite (services/cecf-wordpress)
NEXT_PUBLIC_CECF_URL="http://childeldercare.test"

# ─── ops ────────────────────────────────────────────────────
OTP_RATE_LIMIT_PER_HOUR="5"
OTP_DAILY_SPEND_CAP_KES="5000"

# ─── admin seed ─────────────────────────────────────────────
# PIN used when seeding the initial super-admin (ops@esoko.co.ke).
# Change this before deploying to any shared environment.
SEED_ADMIN_PIN="482915"

# Pre-computed Argon2id hash of SEED_ADMIN_PIN. When set, the seed
# script uses this value directly instead of hashing at seed time.
# Generate with: node -e "const {hash}=require('@node-rs/argon2'); hash('482915',{memoryCost:19456,timeCost:2,parallelism:1}).then(console.log)"
# SEED_ADMIN_HASH=""
SEED_ADMIN_HASH=""
