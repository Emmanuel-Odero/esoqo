# ─── dependencies ─────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ─── build output ─────────────────────────────────────────
.next/
dist/
build/
out/
.turbo/
target/          # Rust (services/ledger, services/channels)
services/core-go/tmp/   # air's dev rebuild output

# ─── PHP (services/cecf-wordpress) ────────────────────────
vendor/
web/wp/

# ─── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# ─── secrets ──────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development

# Filled-in copies of deploy/scripts/secrets.env.template. The template
# itself is tracked; anything matching this pattern holds real cluster
# credentials and must not be.
*.secrets.env
secrets.env

# Locally built Go binary. The deployed one is built inside
# services/core-go/Dockerfile, never copied from a developer's machine.
services/core-go/bin/

# ─── IDE / editor ─────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-*

# ─── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── logs ─────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── testing ─────────────────────────────────────────────
coverage/
playwright-report/
test-results/

# ─── docker ──────────────────────────────────────────────
docker-data/

# ─── misc ────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
.eslintcache

# ─── local dev file storage ────────────────────────────
# Unanchored — every app/service gets its own <LOCAL_STORAGE_DIR>/.data
# (see packages/db/src/storage.ts), not just one at the repo root.
.data/

# ─── Flutter ────────────────────────────────────────────
# The tracked Flutter app (mobile/esoqo_app) carries its own .gitignore.
# mobile/esoko_app is a stray, misspelled Flutter workspace that only ever
# held generated scaffolding — never commit its build output.
mobile/esoko_app/
