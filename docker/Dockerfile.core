# syntax=docker/dockerfile:1.7
# ════════════════════════════════════════════════════════════════════
#  Production image for services/core — the Fastify domain API.
#
#  Unlike the Next apps this image ships TypeScript source and runs it
#  through tsx, rather than shipping a compiled dist/. That is forced
#  by the workspace, not a shortcut: packages/db, /domain, /auth and
#  /payments all declare `"main": "./src/index.ts"` with no build
#  script, so there is no compiled JS for a `tsc`-built core to import.
#  The Next apps get away with it via transpilePackages; a plain Node
#  process does not.
#
#  Consequence: tsx is a devDependency but a RUNTIME requirement here,
#  so this image installs the full workspace rather than --prod. If the
#  image size becomes a problem, the fix is to give the four packages
#  real build outputs — not to prune tsx out of this image.
# ════════════════════════════════════════════════════════════════════
#  Kept in step with docker/Dockerfile.next's NODE_VERSION (see that
#  file's comment on jsdom 30's engines floor) — this service doesn't
#  import jsdom itself, but there is no reason for the two production
#  Node images in this repo to drift apart.
ARG NODE_VERSION=22.23.3

FROM node:${NODE_VERSION}-bookworm-slim AS base
# COREPACK_HOME must be a world-readable path, not the default under
# root's home. The migration Job runs `pnpm` in this image as uid 1001;
# with the cache in /root/.cache it is unreadable, so corepack decides
# pnpm is not installed and tries to fetch the latest version over the
# network — which then fails signature verification and kills the Job.
# An image that must reach the registry to start is not a sealed image.
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1 COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate \
 && chmod -R a+rX /opt/corepack \
 && apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /repo

FROM base AS build

# Manifests only, first — see docker/Dockerfile.next's matching comment
# for why (Kaniko compatibility: it silently drops a `--mount=type=cache`
# target instead of creating it, and a mount-cache tied to one builder
# host is dead weight under Kaniko's one-pod-per-build model anyway).
# This list is pnpm-workspace.yaml's own package list, spelled out —
# wildcard COPY destinations aren't safe to rely on under Kaniko's own
# Dockerfile frontend.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json ./apps/admin/
COPY apps/app/package.json ./apps/app/
COPY apps/jamii/package.json ./apps/jamii/
COPY apps/store/package.json ./apps/store/
COPY apps/web/package.json ./apps/web/
COPY packages/a11y/package.json ./packages/a11y/
COPY packages/auth/package.json ./packages/auth/
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/domain/package.json ./packages/domain/
COPY packages/payments/package.json ./packages/payments/
COPY packages/ui/package.json ./packages/ui/
COPY services/core/package.json ./services/core/
COPY services/cecf-wordpress/web/app/themes/cecf-sage/package.json ./services/cecf-wordpress/web/app/themes/cecf-sage/
# packages/db's own postinstall runs `prisma generate` eagerly during
# `pnpm install` itself (not a separate later step), so the schema has
# to already be on disk before install runs, not just its package.json.
COPY packages/db/prisma ./packages/db/prisma
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @esoqo/db generate
# Typecheck at build time so a broken deploy fails here rather than on
# the first request that happens to hit the broken module — tsx compiles
# lazily per-file and would otherwise surface it in production.
RUN pnpm --filter @esoqo/core-service typecheck

FROM base AS runner
ENV NODE_ENV=production PORT=4000
RUN useradd --system --uid 1001 --gid 0 core
COPY --from=build --chown=1001:0 /repo /repo
USER 1001
EXPOSE 4000

# WORKDIR is the service directory, not /repo, and that is load-bearing:
# tsx is a devDependency of services/core, so pnpm installs it to
# services/core/node_modules rather than hoisting it to the root. Run
# from /repo and Node resolves 'tsx' against /repo/node_modules, does
# not find it, and the container exits immediately with
# ERR_MODULE_NOT_FOUND — a failure that a build cannot catch because the
# image builds perfectly.
#
# The migration Job reuses this image with workingDir: /repo, which
# overrides this and is correct there — pnpm --filter resolves from the
# workspace root.
WORKDIR /repo/services/core

# Bypasses the package.json `start` script, which carries
# --env-file-if-exists=../../.env — harmless but meaningless in a
# cluster where config arrives as env vars from a Secret/ConfigMap.
CMD ["node", "--import", "tsx", "src/index.ts"]
