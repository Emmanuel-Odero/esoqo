{
  "name": "@esoko/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dal": "./src/dal/index.ts",
    "./audit": "./src/audit.ts",
    "./image-compression": "./src/image-compression.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "cd ../../services/core-go && go run ./cmd/seed",
    "seed:abledfirst": "tsx prisma/seed-abledfirst.ts",
    "seed:media": "tsx prisma/seed-media.ts",
    "backfill:rich-text": "tsx prisma/backfill-rich-text.ts",
    "repair:audit-chain": "tsx --env-file-if-exists=../../.env prisma/repair-audit-chain.ts",
    "backfill:registration-org-links": "tsx --env-file-if-exists=../../.env prisma/backfill-registration-org-links.ts",
    "backfill:jamii-site-pages": "tsx prisma/backfill-jamii-site-pages.ts",
    "studio": "prisma studio",
    "audit:verify": "tsx --env-file-if-exists=../../.env src/scripts/verify-chain.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": { "seed": "bash -c 'cd ../../services/core-go && go run ./cmd/seed'" },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@esoko/domain": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.1.0",
    "prisma": "^6.1.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
