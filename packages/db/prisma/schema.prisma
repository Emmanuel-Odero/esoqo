// ════════════════════════════════════════════════════════════════════
//  Esoqo — domain schema
//
//  Design notes that are load-bearing, not decoration:
//
//  · Party is abstract. A Person or an Organisation IS a Party.
//    The CECF platform's single polymorphic `Group` table is the
//    mistake this replaces.
//  · Attestation is the universal trust primitive. Every credential —
//    government registration, county licence, delivery confirmation,
//    field visit — is one row here. New issuers need no schema change.
//  · Balances are DERIVED from Posting. There is no balance column
//    anywhere, and there must never be one.
//  · ConsentGrant is not a boolean. It is a dated, purposed, revocable
//    record, because the Data Protection Act 2019 requires one.
//  · AuditEvent is hash-chained. Tampering breaks the chain.
// ════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────── PARTIES ───────────────────────────

enum PartyKind {
  PERSON
  ORGANISATION
}

/// Which front door a Party first registered through. Sets once, at
/// completeRegistration/ingestCecfRegistration time, from Registration.path
/// — Registration itself is a funnel record that gets superseded, so this
/// is the durable place admin reads "CECF Registrations" from.
enum SourceSystem {
  /// Still spelled ESOKO: this is a value stored in every party row, and
  /// renaming it is a data migration, not a rebrand. The brand is Esoqo.
  ESOKO
  CECF
}

enum OrgKind {
  CHAMA
  SELF_HELP_GROUP
  TABLE_BANKING
  WELFARE_GROUP
  CBO
  FBO
  COOPERATIVE
  SACCO
  NGO
  BUSINESS
  SCHOOL
  CLINIC
  MARKET_ASSOCIATION
  /// A B2B goods supplier — parallel to BUSINESS, not a sub-type of it.
  SUPPLIER
  /// Bulk/trade seller — same commerce engine (Store) as any other business.
  WHOLESALER
  /// A godown — storage/handling fees plus fulfilment-on-behalf-of-others.
  WAREHOUSE
  /// Hosts tenant Stores under one roof — see MallTenancy.
  MALL
  OTHER
}

model Party {
  id           String       @id @default(uuid()) @db.Uuid
  kind         PartyKind
  county       String
  ward         String?
  /// Below county, above ward. Optional — asked mainly of groups and
  /// businesses, who tend to know these as-registered; individuals
  /// aren't pushed for it.
  subCounty    String?
  /// Kenya's pre-2013 administrative unit. Some registration paperwork
  /// (group constitutions, old business permits) still cites it, so we
  /// keep it as free text rather than trying to derive it from county.
  district     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime? // soft delete — DPA erasure keeps the audit trail
  /// Which front door this Party first registered through. See SourceSystem.
  sourceSystem SourceSystem @default(ESOKO)

  person                        Person?
  organisation                  Organisation?
  enterprises                   Enterprise[]
  memberships                   Membership[]                 @relation("MemberParty")
  accounts                      Account[]
  attestations                  Attestation[]                @relation("AttestationSubject")
  consentsGiven                 ConsentGrant[]               @relation("ConsentSubject")
  documents                     Document[]
  registration                  Registration?
  groupJoinRegistrations        Registration[]               @relation("RegistrationGroupParty")
  bizJoinRegistrations          Registration[]               @relation("RegistrationBizParty")
  storeOrdersAsBuyer            StoreOrder[]
  storeCustomerLinks            StoreCustomer[]
  donationsAsDonor              Donation[]
  jamiiTeamMemberships          JamiiTeamMember[]
  jamiiApplications             JamiiInterest[]
  bookingsAsBuyer               Booking[]
  supportTicketsRaised          SupportTicket[]
  bills                         Bill[]
  savedStores                   SavedStore[]
  orgStaffGrants                OrgStaffGrant[]              @relation("OrgStaffGrantParty")
  orgStaffGrantsGranted         OrgStaffGrant[]              @relation("OrgStaffGrantGrantedBy")
  orgStaffGrantsSuspended       OrgStaffGrant[]              @relation("OrgStaffGrantSuspendedBy")
  businessPaymentsAsPayee       BusinessPayment[]            @relation("BusinessPaymentPayee")
  parkingLots                   ParkingLot[]
  walletTopUps                  WalletTopUp[]                @relation("WalletTopUpParty")
  groupActivityEvents           GroupActivityEvent[]         @relation("GroupActivityActor")
  signatoryFeesForMe            SignatoryFeePayment[]        @relation("SignatoryFeePerson")
  signatoryFeesIAdded           SignatoryFeePayment[]        @relation("SignatoryFeeAddedBy")
  proposalsTargetingMe          GroupProposal[]              @relation("ProposalTarget")
  proposalsIProposed            GroupProposal[]              @relation("ProposalProposedBy")
  proposalVotes                 GroupProposalVote[]          @relation("ProposalVoter")
  projectsCreated               GroupProject[]               @relation("ProjectCreatedBy")
  projectSignerships            GroupProjectSigner[]         @relation("ProjectSignerParty")
  projectContributions          GroupProjectContribution[]   @relation("ProjectContributionParty")
  projectContributionsConfirmed GroupProjectContribution[]   @relation("ProjectContributionConfirmedBy")
  projectWithdrawalsRequested   GroupProjectWithdrawal[]     @relation("ProjectWithdrawalRequestedBy")
  projectWithdrawalVotes        GroupProjectWithdrawalVote[] @relation("ProjectWithdrawalVoter")

  // ── Group treasury ──
  meetingsCalled          Meeting[]                    @relation("MeetingCalledBy")
  attendanceRecords       AttendanceRecord[]           @relation("AttendanceParty")
  attendanceMarkedByMe    AttendanceRecord[]           @relation("AttendanceMarkedBy")
  groupSignerships        GroupSigner[]                @relation("GroupSignerParty")
  contributionsMade       GroupContribution[]          @relation("ContributionParty")
  contributionsIConfirmed GroupContribution[]          @relation("ContributionConfirmedBy")
  withdrawalsRequested    WithdrawalRequest[]          @relation("WithdrawalRequestedBy")
  withdrawalSignatures    WithdrawalSignature[]        @relation("WithdrawalSignerParty")
  esoqoPaymentId          EsoqoPaymentId?
  esoqoIdPurchases        EsoqoIdPurchase[]
  creditInsightSnapshots  GroupCreditInsightSnapshot[]

  @@index([county, kind])
  @@index([createdAt])
  @@map("party")
}

model Person {
  partyId String @id @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  /// Name as written on the national ID, kept as a derived display string —
  /// `[firstName, middleName, surname].filter(Boolean).join(' ')`, written
  /// at the same time as the three fields below. Every existing reader
  /// (admin search, registration table, jamii pages) reads this column;
  /// new code should read firstName/middleName/surname directly instead.
  officialName   String
  /// What people actually call them. This is what the product uses day to day.
  knownAs        String?
  /// The three-name split the esoqo ID generator draws from. Two of the
  /// three are compulsory (firstName, surname); middleName is optional —
  /// not everyone's ID carries one.
  firstName      String?
  middleName     String?
  surname        String?
  /// MSISDN in E.164. THE identifier for anyone who can log in, dial
  /// USSD or receive SMS. Null means a staff-added member with no phone
  /// on file yet — pending until someone fills it in.
  msisdn         String?   @unique
  /// SHA-256 of the national ID number. The raw number is never stored
  /// here — see NationalIdRecord for the separate, explicitly consented
  /// vault that holds the raw number for display/KYC purposes.
  nationalIdHash String?   @unique
  email          String?   @db.Citext
  gender         String?
  yearOfBirth    Int?
  /// Full date of birth, captured once ID-card scanning or a DOB field is
  /// filled in at registration. yearOfBirth is kept for older records and
  /// existing consumers; this is the source of truth going forward.
  dateOfBirth    DateTime? @db.Date

  nationalIdRecord NationalIdRecord?

  msisdnVerifiedAt DateTime?
  emailVerifiedAt  DateTime?

  /// Display preferences. Persisted server-side deliberately, so they
  /// follow the person across devices and channels rather than living
  /// in one browser's localStorage.
  displayPrefs Json @default("{}")

  credential UserCredential?

  @@index([msisdn])
  /// Sign-in accepts either a phone number or an email (see dbx's
  /// findPersonByWhere on `pr.email = $1`), but only msisdn was indexed
  /// — so every email sign-in scanned the whole person table. Indexed
  /// rather than @unique deliberately: a uniqueness constraint added
  /// here would fail the migration outright if any duplicate email
  /// already exists, and that is a data-cleanup decision, not this one.
  @@index([email])
  @@map("person")
}

/// The explicit, consented vault for what a scanned national ID card
/// actually says — separate from Person.nationalIdHash, which stays a
/// one-way SHA-256 used only for the platform's existing dedupe check.
/// idNumberEnc/serialNumberEnc are AES-256-GCM (see packages/db/src/crypto.ts
/// encryptPii/decryptPii) — the first reversible-PII storage in this
/// schema, so every decrypt read goes through a DAL function that calls
/// recordAudit. frontDocumentId/backDocumentId point at the existing
/// Document model (plain string FKs, same pattern Document.reviewedById
/// already uses, so no reverse relation array is required on Document).
model NationalIdRecord {
  partyId String @id @db.Uuid
  person  Person @relation(fields: [partyId], references: [partyId], onDelete: Cascade)

  idNumberEnc     Bytes
  serialNumberEnc Bytes?
  sex             String?
  districtOfBirth String?
  dateOfIssue     DateTime? @db.Date

  frontDocumentId String? @db.Uuid
  backDocumentId  String? @db.Uuid

  /// Set once staff (or, later, an automated OCR match) confirms this
  /// record against the Person's existing nationalIdHash — this is what
  /// finally issues the long-dormant NATIONAL_ID_CONFIRMED attestation.
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("national_id_record")
}

model Organisation {
  partyId String @id @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  kind              OrgKind
  /// Free text when kind is OTHER — same shape as businessTypeOther below,
  /// just for the group-kind picker (join flow, admin's Groups screen,
  /// self-serve /me/group) rather than the business-type one.
  kindOther         String?
  officialName      String
  knownAs           String?
  /// Registration number, if held. Verified via Attestation, never trusted raw.
  registrationNo    String?
  memberCount       Int?
  formedOn          DateTime?
  /// What most members deal in — "juakali", "carpentry", "masonry" —
  /// keyed against the same segment dictionary individuals pick their
  /// own work from, so group and personal tags stay comparable.
  tags              String[]  @default([])
  /// Only meaningful when kind is BUSINESS: sole proprietorship,
  /// partnership, limited company, cooperative, etc. Free text in
  /// businessTypeOther when the picked value is "OTHER".
  businessType      String?
  businessTypeOther String?
  /// Business-only: not yet registered, but says they plan to be.
  intendsToRegister Boolean?
  /// Only meaningful when kind is MALL: the slug its public tenant
  /// directory (/m/[mallSlug]) is served at.
  mallSlug          String?   @unique

  members   Membership[] @relation("MemberOrg")
  jamiiPage JamiiPage?

  // ── Group treasury ──
  meetings             Meeting[]
  treasuryPolicy       GroupTreasuryPolicy?
  signers              GroupSigner[]
  contributions        GroupContribution[]
  withdrawalRequests   WithdrawalRequest[]
  activityEvents       GroupActivityEvent[]
  signatoryFeePayments SignatoryFeePayment[]
  proposals            GroupProposal[]
  projects             GroupProject[]

  // Only meaningful when kind is MALL — the stores it hosts as tenants.
  mallTenancies MallTenancy[] @relation("MallTenancies")

  // Only meaningful when kind is WAREHOUSE.
  storageAgreements StorageAgreement[]
  stockLocations    StockLocation[]
  dispatchingStores Store[]            @relation("StoreDispatchWarehouse")

  @@index([kind])
  @@map("organisation")
}

enum MemberRole {
  CHAIRPERSON
  TREASURER
  SECRETARY
  MEMBER
  OTHER
}

/// PENDING is only reachable via a group with a joinFeeKes set on its
/// GroupTreasuryPolicy — see createJoinFeePayment/confirmContribution in
/// dal/treasury.ts, which flips PENDING -> ACTIVE once the fee's
/// GroupContribution is confirmed. Every other join path (self-founding,
/// staff addMember/addNewMember, an invite to a group with no fee) skips
/// straight to ACTIVE, same as before this status existed.
enum MembershipStatus {
  PENDING
  ACTIVE
}

model Membership {
  id         String           @id @default(uuid()) @db.Uuid
  personId   String           @db.Uuid
  orgId      String           @db.Uuid
  role       MemberRole       @default(MEMBER)
  /// Free text position, set only when role is OTHER — "Youth rep",
  /// "Auditor", whatever the group actually calls it. Ignored otherwise.
  customRole String?
  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime         @default(now())
  exitedAt   DateTime?

  person Party        @relation("MemberParty", fields: [personId], references: [id], onDelete: Cascade)
  org    Organisation @relation("MemberOrg", fields: [orgId], references: [partyId], onDelete: Cascade)

  joinFeePayments GroupContribution[] @relation("JoinFeeMembership")

  @@unique([personId, orgId])
  @@index([orgId, role])
  @@index([orgId, status])
  @@map("membership")
}

/// The economic unit. A party may run more than one.
model Enterprise {
  id                String   @id @default(uuid()) @db.Uuid
  partyId           String   @db.Uuid
  party             Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// Free text as the user typed it — "carpentry", "seremala", "mama mboga".
  workRaw           String
  /// Resolved segment key from the shared dictionary.
  segment           String?
  sector            String?
  isRegistered      Boolean  @default(false)
  hasKraPin         Boolean  @default(false)
  /// Operational detail, gathered mainly when the enterprise belongs to
  /// a business Organisation rather than an individual's side-hustle.
  employeeCount     Int?
  revenueGoodDayKes Decimal? @db.Decimal(12, 2)
  revenueBadDayKes  Decimal? @db.Decimal(12, 2)
  bankProvider      String?
  paymentChannels   String[] @default([])
  createdAt         DateTime @default(now())

  stores            Store[]
  ticketOrgs        TicketOrg[]
  parcelOrgs        ParcelOrg[]
  mallTenancies     MallTenancy[]      @relation("TenantEnterprise")
  storageAgreements StorageAgreement[]

  @@index([segment])
  @@index([sector])
  @@map("enterprise")
}

/// A store's tenancy inside a mall — Organisation{kind: MALL} hosting an
/// Enterprise (the tenant operating a store there), not Organisation-to-
/// Organisation: keeps the tenant side consistent with how Store and
/// TicketOrg already hang off Enterprise rather than Organisation.
/// Soft-exit via endedAt, same reinstate-not-delete shape as Membership.
model MallTenancy {
  id                 String    @id @default(uuid()) @db.Uuid
  mallOrgId          String    @db.Uuid
  tenantEnterpriseId String    @db.Uuid
  /// "Shop 14B" — free text, optional.
  unitLabel          String?
  startedAt          DateTime  @default(now())
  endedAt            DateTime?

  mallOrg          Organisation @relation("MallTenancies", fields: [mallOrgId], references: [partyId], onDelete: Cascade)
  tenantEnterprise Enterprise   @relation("TenantEnterprise", fields: [tenantEnterpriseId], references: [id], onDelete: Cascade)

  @@unique([mallOrgId, tenantEnterpriseId])
  @@index([tenantEnterpriseId])
  @@map("mall_tenancy")
}

/// A merchant paying a godown to store/handle goods there — the billing
/// side of a WAREHOUSE Organisation. billingPeriod is display/logic
/// only (no cron reads it): postWarehouseFee is always triggered
/// manually, same as every other recurring-payment-shaped feature in
/// this codebase (see dal/treasury.ts's contribution flow).
model StorageAgreement {
  id                 String    @id @default(uuid()) @db.Uuid
  warehouseOrgId     String    @db.Uuid
  tenantEnterpriseId String    @db.Uuid
  feeKes             Decimal   @db.Decimal(12, 2)
  billingPeriod      String
  unitLabel          String?
  startedAt          DateTime  @default(now())
  endedAt            DateTime?

  warehouseOrg     Organisation @relation(fields: [warehouseOrgId], references: [partyId], onDelete: Cascade)
  tenantEnterprise Enterprise   @relation(fields: [tenantEnterpriseId], references: [id], onDelete: Cascade)

  @@index([tenantEnterpriseId])
  @@index([warehouseOrgId])
  @@map("storage_agreement")
}

/// Whose stock sits where — a godown acting as fulfilment point for
/// another seller's Store. Quantity is a snapshot set by
/// upsertStockLocation, not derived from a movement ledger (no such
/// ledger exists yet); good enough for "does this godown currently
/// hold any of this seller's stock", not stock-movement audit.
model StockLocation {
  id             String   @id @default(uuid()) @db.Uuid
  warehouseOrgId String   @db.Uuid
  storeId        String   @db.Uuid
  productId      String?  @db.Uuid
  variantId      String?  @db.Uuid
  quantity       Int
  updatedAt      DateTime @updatedAt

  warehouseOrg Organisation    @relation(fields: [warehouseOrgId], references: [partyId], onDelete: Cascade)
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseOrgId, storeId, productId, variantId])
  @@index([storeId])
  @@map("stock_location")
}

// ─────────────────────── AUTH & CREDENTIALS ─────────────────────

model UserCredential {
  personId       String    @id @db.Uuid
  person         Person    @relation(fields: [personId], references: [partyId], onDelete: Cascade)
  /// Argon2id. Never anything else, never hand-rolled.
  pinHash        String?
  pinSetAt       DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  frozenAt       DateTime? // SIMAMA — instant freeze from any handset
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("user_credential")
}

enum OtpPurpose {
  REGISTRATION
  SIGN_IN
  PIN_RESET
  STEP_UP
  CONSENT_GRANT
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  msisdn      String
  purpose     OtpPurpose
  /// HMAC-SHA256(code, OTP_PEPPER). The code itself is never stored.
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  ip          String?

  @@index([msisdn, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenge")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @db.Citext
  tokenHash String    @unique
  partyId   String?   @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("email_verification")
}

// ───────────────────────── ATTESTATIONS ─────────────────────────

enum ClaimType {
  MSISDN_VERIFIED
  EMAIL_VERIFIED
  NATIONAL_ID_CONFIRMED
  GROUP_REGISTERED
  BUSINESS_REGISTERED
  KRA_PIN
  ETIMS_ACTIVE
  MEDIATION_TRAINED
  SINGLE_BUSINESS_PERMIT
  FOOD_HANDLER
  HEALTH_CLEARANCE
  SECTOR_LICENCE
  FIELD_VISIT
  DELIVERY_CONFIRMED
  TRADING_RECORD
  /// CECF staff reviewed a Jamii page's registration + treasurer-ID
  /// documents and are satisfied the org is who its page says it is.
  ORG_PAGE_VERIFIED
}

enum AttestationMethod {
  MANUAL
  API
  DOCUMENT
  FIELD_VISIT
  SELF_DECLARED
}

/// The universal trust primitive. Adding an issuer must never require
/// a migration — that is the whole point of this table.
model Attestation {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid
  subject   Party  @relation("AttestationSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  claimType  ClaimType
  claimValue Json      @default("{}")

  issuerOrgId  String?           @db.Uuid
  issuer       Issuer?           @relation(fields: [issuerOrgId], references: [id])
  issuerUserId String?           @db.Uuid
  method       AttestationMethod @default(MANUAL)

  evidenceRefs String[] @default([])
  confidence   Int      @default(100)

  issuedAt         DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revocationReason String?

  /// Signature over the canonical claim. Populated by services/credential.
  signature String?
  /// Hash chain within a subject's attestation history.
  prevHash  String?
  hash      String?

  @@index([subjectId, claimType])
  @@index([expiresAt])
  @@index([claimType, revokedAt])
  @@map("attestation")
}

/// A body with authority to issue claims. Ministry, county, bank, CECF.
model Issuer {
  id            String      @id @default(uuid()) @db.Uuid
  name          String      @unique
  shortName     String?
  kind          String // MINISTRY | COUNTY | AGENCY | JUDICIARY | BANK | INSURER | BUYER | NGO
  /// Which claim types this issuer is permitted to assert.
  allowedClaims ClaimType[] @default([])
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  attestations  Attestation[]
  consentGrants ConsentGrant[] @relation("ConsentGrantee")

  @@map("issuer")
}

// ──────────────────────────── CONSENT ───────────────────────────

enum ConsentPurpose {
  CREDIT_ASSESSMENT
  INSURANCE_QUOTE
  SUPPLY_CONTRACT
  COUNTY_LICENSING
  PROGRAMME_ENROLMENT
  /// A member sharing their GroupCreditInsightSnapshot (never the raw
  /// ledger) with a specific lender for a specific loan application.
  LOAN_UNDERWRITING
}

/// Not a boolean. A dated, purposed, revocable record — because the
/// Data Protection Act 2019 requires one and an auditor will ask for it.
model ConsentGrant {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid
  subject   Party  @relation("ConsentSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  granteeId String @db.Uuid
  grantee   Issuer @relation("ConsentGrantee", fields: [granteeId], references: [id])

  purpose      ConsentPurpose
  /// Field-level scope. Never "everything".
  scope        String[]       @default([])
  /// The exact wording shown to the subject when they agreed.
  wordingShown String
  channel      String // USSD | WEB | AGENT | IVR

  grantedAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revocationChannel String?

  accesses ConsentAccess[]

  @@index([subjectId, revokedAt])
  @@index([granteeId, expiresAt])
  @@map("consent_grant")
}

/// Every look, logged. Producible for the ODPC on request.
model ConsentAccess {
  id         String       @id @default(uuid()) @db.Uuid
  grantId    String       @db.Uuid
  grant      ConsentGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  accessedAt DateTime     @default(now())
  actorId    String?      @db.Uuid
  fields     String[]     @default([])
  ip         String?

  @@index([grantId, accessedAt])
  @@map("consent_access")
}

// ───────────────────────── LEDGER (money) ───────────────────────

enum AccountKind {
  WALLET
  ESCROW
  GROUP_SAVINGS
  FEE_INCOME
  SETTLEMENT
  SUSPENSE
  /// One per Store. Where checkout and PoS sales post; FEE_INCOME
  /// picks up the platform's cut on the same JournalEntry.
  STORE_REVENUE
  /// One per Campaign. Deliberately separate from GROUP_SAVINGS — a
  /// donor's gift to a named campaign never gets lent out table-banking
  /// style, and the org's own savings never look like donor money.
  CAMPAIGN_RECEIVED
  /// One per warehouse Organisation. Where postWarehouseFee posts a
  /// godown's storage/handling fee revenue — the WAREHOUSE-side mirror
  /// of STORE_REVENUE.
  WAREHOUSE_REVENUE
  /// The platform-pooled counterpart to every VoucherCard's balance —
  /// see ConfirmVoucherLoadByCheckoutID/ConfirmVoucherBatchByCheckoutID
  /// in services/core-go. Pre-existing drift closed here: this value
  /// was already live in the database (added by an earlier core-go-only
  /// migration) but had never been added to this schema file.
  VOUCHER_FLOAT
  /// One per bill owner. Where a BillContribution settles — money
  /// raised toward a bill's targetKes, held here until the bill is
  /// marked paid (auto or manual). See dbx.ConfirmBillContributionByCheckoutID.
  BILL_FUNDING
  /// Single platform-pooled account (no partyId), same shape as
  /// VOUCHER_FLOAT — parcels are an Esoqo-run service, not a
  /// per-merchant marketplace, so there's no per-store revenue split
  /// to make. See dbx.ConfirmParcelPaymentByCheckoutID.
  PARCEL_REVENUE
  /// One per courier party — cash-on-delivery money physically in that
  /// rider's pocket, between collecting it at a door and handing it
  /// over. An asset to the platform and a liability of the rider's, and
  /// the only honest way to answer "who is holding our money right
  /// now". Debited when a collection is recorded, credited when the
  /// rider remits. See dbx.RecordCodCollection / RemitCod.
  PARCEL_COD_HELD
  /// One per seller (the parcel's sender) — goods money collected on
  /// their behalf and not yet paid out. Credited at collection, debited
  /// at settlement. Deliberately separate from WALLET: this is money
  /// Esoqo owes a seller for a specific set of parcels, not a balance
  /// they can spend, and conflating the two would let an unsettled
  /// collection look like available funds.
  PARCEL_COD_PAYABLE
  /// One per gig courier — delivery fees earned and not yet paid out.
  /// Credited when a delivery completes, debited at payout. Only ever
  /// used for couriers working directly for Esoqo: a rider employed by
  /// a ParcelOrg is paid by that company out of its own
  /// Parcel.orgEarningsKes, and accruing here too would pay for the
  /// same delivery twice. See dbx.AccrueCourierEarnings.
  PARCEL_COURIER_PAYABLE
  /// Platform-pooled (no partyId) — the cost side of the entry above.
  /// The first genuine expense account in this enum: every other kind
  /// is an asset or a revenue pool, because until couriers had to be
  /// paid nothing here ever cost the platform money on a per-event
  /// basis.
  PARCEL_COURIER_COST
  /// One per ticket org's enterprise party — what a booking is worth to
  /// that operator, and therefore what Esoqo owes them. Replaces the
  /// SUSPENSE placeholder ticketing.go used to post against, which its
  /// own comment flagged as standing in for a "TICKET_REVENUE-equivalent
  /// value". A suspense account means "not yet classified" and is
  /// supposed to trend to zero; parking a real, permanent payable there
  /// meant an operator's balance could not be aged or stated without
  /// knowing which references to filter on. See
  /// dbx.ConfirmBookingPaymentByCheckoutID.
  TICKET_REVENUE
  /// One per fleet operator's enterprise party — the short-route fare
  /// equivalent of TICKET_REVENUE, and the account fleet.go's own
  /// comment was waiting on ("until a FARE_REVENUE account kind is
  /// migrated"). Separate from TICKET_REVENUE because one SACCO can
  /// both sell scheduled tickets and run stage fares, and a single
  /// account would make those two revenue streams unseparable after the
  /// fact. See dbx.postFareLedgerEntry.
  FARE_REVENUE
  /// One per business Organisation that has been paid through the public
  /// /pay page. Where BusinessPayment posts — the ORGANISATION-side
  /// mirror of STORE_REVENUE, deliberately its own kind rather than a
  /// reuse of STORE_REVENUE so "money taken at a till" and "money a
  /// customer sent to a QR on a wall" stay separable in the ledger.
  BUSINESS_REVENUE
}

model Account {
  id       String      @id @default(uuid()) @db.Uuid
  partyId  String?     @db.Uuid
  party    Party?      @relation(fields: [partyId], references: [id])
  kind     AccountKind
  currency String      @default("KES")
  openedAt DateTime    @default(now())
  closedAt DateTime?

  postings Posting[]
  campaign Campaign?

  contributions      GroupContribution[]
  withdrawalRequests WithdrawalRequest[]

  @@unique([partyId, kind, currency])
  @@index([kind])
  @@map("account")
}

/// Immutable. Balanced. Never updated, never deleted.
model JournalEntry {
  id             String   @id @default(uuid()) @db.Uuid
  reference      String   @unique
  description    String
  occurredAt     DateTime @default(now())
  recordedAt     DateTime @default(now())
  /// Idempotency key. M-Pesa callbacks arrive late, twice, or never.
  idempotencyKey String?  @unique

  postings            Posting[]
  storeOrder          StoreOrder?
  groupContribution   GroupContribution?
  withdrawalRequest   WithdrawalRequest?
  posSale             PosSale?
  donation            Donation?
  booking             Booking?
  farePayment         FarePayment?
  voucherEntry        VoucherLedgerEntry?
  billContribution    BillContribution?
  businessPayment     BusinessPayment?
  walletTopUp         WalletTopUp?
  signatoryFeePayment SignatoryFeePayment?
  projectContribution GroupProjectContribution?
  projectWithdrawal   GroupProjectWithdrawal?
  esoqoIdPurchase     EsoqoIdPurchase?

  @@index([occurredAt])
  @@map("journal_entry")
}

model Posting {
  id        String       @id @default(uuid()) @db.Uuid
  entryId   String       @db.Uuid
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String       @db.Uuid
  account   Account      @relation(fields: [accountId], references: [id])
  /// Positive = debit, negative = credit. Sum per entry MUST be zero.
  amount    Decimal      @db.Decimal(18, 2)
  currency  String       @default("KES")

  @@index([accountId, entryId])
  @@map("posting")
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH_TO_AGENT
  /// Pesapal-hosted card checkout — see RegistrationPayment.pesapalOrderTrackingId.
  CARD
}

enum ApprovalDecision {
  APPROVE
  REJECT
}

enum PaymentStatus {
  NOT_DECLARED
  DECLARED
  UNDER_REVIEW
  CONFIRMED
  REJECTED
  WAIVED
}

// ─────────────────────── REGISTRATION FUNNEL ────────────────────

enum RegistrationStatus {
  STARTED
  AWAITING_OTP
  VERIFIED
  COMPLETE
  ABANDONED
}

enum JoinPath {
  SELF_WEB
  SELF_USSD
  AGENT_ASSISTED
  COHORT
  /// Ingested from the CECF WordPress site's own registration flow, via
  /// ingestCecfRegistration — never entered through /join directly.
  CECF_WEB
}

/// Funnel record. Deliberately separate from Party so an abandoned
/// registration never becomes a counted user — the failure that made
/// CECF's numbers meaningless.
model Registration {
  id      String             @id @default(uuid()) @db.Uuid
  partyId String?            @unique @db.Uuid
  party   Party?             @relation(fields: [partyId], references: [id])
  status  RegistrationStatus @default(STARTED)
  path    JoinPath           @default(SELF_WEB)

  joiningAs             String // me | group | biz
  officialName          String?
  knownAs               String?
  /// Three-name split mirroring Person — see completeRegistration, which
  /// carries these onto the Person it creates and derives officialName
  /// from them rather than trusting a single freeform field.
  firstName             String?
  middleName            String?
  surname               String?
  dateOfBirth           DateTime? @db.Date
  msisdn                String?
  email                 String?   @db.Citext
  county                String?
  ward                  String?
  workRaw               String?
  segment               String?
  orgName               String?
  orgKnownAs            String?
  orgRole               String?
  memberCount           Int?
  hasRegisteredBusiness String?
  registrationNo        String?
  belongsToGroup        String?
  groupName             String?
  /// Set when the joiner picked an existing group from the search, not
  /// just typed a name — this is what actually links them via Membership.
  groupPartyId          String?   @db.Uuid
  groupParty            Party?    @relation("RegistrationGroupParty", fields: [groupPartyId], references: [id])
  /// "group" | "self" — only asked when belongsToGroup is "yes".
  feeCoverage           String?
  hasKraPin             String?

  /// The group's own OrgKind (CBO/SHG/CHAMA/... — see GROUP_KINDS),
  /// location below county, and member-tags, only asked when creating
  /// a brand-new group rather than joining one found by search.
  orgKind      String?
  orgSubCounty String?
  orgDistrict  String?
  orgTags      String[] @default([])

  /// Business sub-flow. bizPartyId mirrors groupPartyId — set when the
  /// joiner picked an existing business from the live search, which is
  /// what stops a duplicate Organisation being created on completion.
  bizName              String?
  bizIsRegistered      String? // yes | no
  bizIntendsToRegister String? // only asked when bizIsRegistered = no
  bizPartyId           String?  @db.Uuid
  bizParty             Party?   @relation("RegistrationBizParty", fields: [bizPartyId], references: [id])
  /// SUPPLIER | WHOLESALER | WAREHOUSE | MALL | BUSINESS (default). Read by
  /// completeRegistration to pick the new Organisation's OrgKind — a
  /// parallel field to bizType (legal structure), not a replacement for it.
  bizOrgKind           String?
  bizSector            String?
  bizType              String?
  bizTypeOther         String?
  bizEmployeeCount     Int?
  bizRevenueGoodKes    Decimal? @db.Decimal(12, 2)
  bizRevenueBadKes     Decimal? @db.Decimal(12, 2)
  bizBankProvider      String?
  bizPaymentChannels   String[] @default([])

  /// Explicit opt-ins. Nothing is sent that was not asked for.
  wantsPriceSms   Boolean @default(false)
  wantsReceiptSms Boolean @default(true)
  wantsExpirySms  Boolean @default(true)

  ussdSetupChoice  String? // now | later
  msisdnVerifiedAt DateTime?
  emailSentAt      DateTime?
  /// Mirrors msisdnVerifiedAt — set by markEmailVerified, the email-OTP
  /// counterpart to markMsisdnVerified. Together these two are what let
  /// completeRegistration accept an email-only registration.
  emailVerifiedAt  DateTime?

  agentId   String? @db.Uuid
  language  String  @default("en")
  ip        String?
  userAgent String?

  /// Highest join-flow step this registration has reached (1 = picked
  /// who's joining, up through the final verify-and-finish step). The
  /// only granular drop-off signal — `status` alone only distinguishes
  /// STARTED/AWAITING_OTP/VERIFIED/COMPLETE/ABANDONED, not which of the
  /// in-progress steps someone actually got stuck on.
  lastStep Int @default(1)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  /// Soft void. A deleted registration keeps its audit trail.
  voidedAt    DateTime?
  voidedById  String?   @db.Uuid
  voidReason  String?

  payment   RegistrationPayment?
  documents Document[]

  @@index([status, startedAt])
  @@index([county])
  @@index([msisdn, status])
  @@map("registration")
}

/// A payment declared for a registration. Not money — just what the
/// joiner or an officer says. Only the signature chain moves it to
/// CONFIRMED.
model RegistrationPayment {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @unique @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  method                 PaymentMethod?
  reference              String?        @db.Citext
  amountKes              Decimal?       @db.Decimal(12, 2)
  declaredNote           String?
  declaredAt             DateTime?
  status                 PaymentStatus  @default(NOT_DECLARED)
  confirmedAt            DateTime?
  /// Daraja's CheckoutRequestID for a live STK push, set the moment the
  /// push is sent. Doubles as the idempotency guard for a callback that
  /// arrives twice — see StoreOrder.mpesaCheckoutRequestId for the same
  /// pattern in the storefront.
  checkoutRequestId      String?        @unique
  /// Pesapal's OrderTrackingId for a card checkout, set the moment
  /// initiatePesapalOrder returns. Same idempotency role as
  /// checkoutRequestId above, just for the /webhooks/pesapal/ipn callback.
  pesapalOrderTrackingId String?        @unique
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  approvals PaymentApproval[]

  @@index([status])
  @@map("registration_payment")
}

/// A single signature in the dual-control chain. One REJECT halts.
model PaymentApproval {
  id         String              @id @default(uuid()) @db.Uuid
  paymentId  String              @db.Uuid
  payment    RegistrationPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  approverId String              @db.Uuid
  approver   StaffUser           @relation(fields: [approverId], references: [id])
  decision   ApprovalDecision
  note       String?
  /// HMAC-SHA256(paymentId|approverId|decision|signedAt, SESSION_SECRET)
  signature  String
  signedAt   DateTime
  ip         String?

  @@unique([paymentId, approverId])
  @@index([paymentId])
  @@map("payment_approval")
}

// ───────────────────────────── DOCUMENTS ────────────────────────

enum DocumentStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  SUPERSEDED
}

// ─────────────────────── STORES & COMMERCE ──────────────────────
//
// A Store belongs to an Enterprise, not a new signup silo — the owner
// is already a registered, credentialed Party before a store can exist.
// Money still moves through Account/JournalEntry/Posting; this is the
// interim TypeScript-DAL implementation of that posting, not a second
// ledger. See docs/adr and services/ledger/README.md.

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum StoreRoutingMode {
  PATH // esoko.global/@slug — free, always available
  SUBDOMAIN // slug.esoko.global — priced via PricingRule
}

model Store {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  name         String
  /// URL-safe, unique across the platform regardless of routing mode —
  /// a store keeps the same slug if it later adds a subdomain.
  slug         String           @unique
  status       StoreStatus      @default(DRAFT)
  themeKey     String           @default("market")
  routingMode  StoreRoutingMode @default(PATH)
  /// Reserved for a future custom-domain phase. Not resolved anywhere yet.
  customDomain String?          @unique
  posEnabled   Boolean          @default(false)
  /// Toggle the KRA eTIMS fiscal-device flow for receipts issued at
  /// this store. When on, every receipt gets a serial unique to the push.
  etimsEnabled Boolean          @default(false)

  /// Loyalty points worth? A gift card in Kenya is `ongea points`.
  loyaltyEnabled Boolean @default(false)
  /// Points granted per whole KES of sale, at the terminal AND on the
  /// storefront — one loyalty pool per store.
  loyaltyPerKes  Int     @default(1)

  /// Whether the storefront offers cash on delivery at checkout, in
  /// addition to M-Pesa STK. Off by default — the seller opts in.
  codEnabled Boolean @default(false)

  // ── EStore profile ────────────────────────────────────────────
  // Business identity a customer-facing storefront shows. `name` above
  // is the trading name; these hold the registered/legal details and
  // contact info. All optional — a store sells fine without them, the
  // storefront just shows less.

  /// Registered/legal business name, where it differs from the trading name.
  legalName          String?
  /// KRA PIN or business registration number, shown in the storefront's
  /// business identity block.
  registrationNumber String?
  /// A named person customers can ask for ("Ask for Mama Njeri").
  contactPerson      String?
  contactEmail       String?
  /// +254 format, same convention as customer/supplier phones.
  contactPhone       String?
  physicalAddress    String?

  /// One-line pitch under the store name on the storefront hero.
  tagline           String?
  /// Long-form story — where the goods come from, how the shop started.
  /// Shown as the storefront's About section. Plain text.
  aboutUs           String?
  logoStorageKey    String?
  /// Public URL served via /img/{key}, same pattern as ProductImage.
  logoUrl           String?
  faviconStorageKey String?
  faviconUrl        String?

  /// Brand accent override — a hex colour that beats the theme accent
  /// when set, so a store with its own colours doesn't need a new theme.
  brandAccent String?

  instagram String?
  facebook  String?
  tiktok    String?
  whatsapp  String?
  linkedin  String?

  /// The category the store mostly trades in — one of PRODUCT_CATEGORIES.
  primaryCategory String?
  /// Rough size of the catalogue ("how many things do you sell?").
  skuCount        Int?

  /// Human-readable area for display and text search — "Kilimani,
  /// Nairobi". Distinct from physicalAddress (a fuller street address):
  /// this is the label a "near me"/neighborhood search matches against
  /// and shows on a store card, kept short on purpose.
  neighborhood String?
  /// Real coordinates for the "stores near me" search
  /// (dbx.ListStoresNearby's haversine query) and for a buyer's
  /// "get directions" link once they've ordered. Both null until set —
  /// a store without them simply doesn't appear in distance-sorted
  /// results, same graceful-degradation as every other optional
  /// storefront field here.
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)

  /// Where orders are packed/picked up from — "Juja Main, Kiambu".
  deliveryOrigin         String?
  /// Free-text delivery areas served — "Juja, Thika, Ruiru".
  deliveryZones          String[]      @default([])
  /// Typical turnaround in days (informational on the storefront).
  processingDays         Int?
  /// A formal godown relationship, when one exists — Organisation{kind:
  /// WAREHOUSE} this store's orders dispatch from. Optional and purely
  /// additive: deliveryOrigin above stays the fallback for every store
  /// with no formal warehouse relationship.
  dispatchWarehouseOrgId String?       @db.Uuid
  dispatchWarehouseOrg   Organisation? @relation("StoreDispatchWarehouse", fields: [dispatchWarehouseOrgId], references: [partyId])

  /// Currency the store prices in — KES for everything today; kept on
  /// the profile so the storefront can label prices honestly if it ever
  /// changes.
  currency        String  @default("KES")
  /// VAT rate shown on the storefront when set (16 = 16%). Informational —
  /// online checkouts price in KES inclusive of nothing; how tax is
  /// collected is a fiscal-device (eTIMS) concern, not a profile one.
  taxRatePct      Int?
  /// M-Pesa number settlements should be paid to. Informational on the
  /// profile today — actual payouts run through the enterprise ledger.
  settlementPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products          Product[]
  orders            StoreOrder[]
  posSales          PosSale[]
  customers         StoreCustomer[]
  cashiers          Cashier[]
  shifts            Shift[]
  refunds           PosRefund[]
  receipts          Receipt[]
  fulfilmentOptions FulfilmentOption[]
  suppliers         Supplier[]
  stockPurchases    StockPurchase[]
  photos            StorePhoto[]
  stockLocations    StockLocation[]
  savedBy           SavedStore[]
  tableAssignments  TableAssignment[]

  @@index([enterpriseId])
  @@index([status])
  @@index([dispatchWarehouseOrgId])
  @@index([latitude, longitude])
  @@map("store")
}

/// A person's own "My spots" list — shops/eateries they've marked as
/// theirs, so the shopping tab can put those ahead of general discovery
/// instead of every visit re-browsing a place ordered from weekly. Pure
/// bookmark: what makes it useful (order history, "the usual") is
/// derived fresh from StoreOrder/StoreOrderItem at read time (see
/// dbx.UsualProduct), never duplicated onto this row.
model SavedStore {
  id      String   @id @default(uuid()) @db.Uuid
  partyId String   @db.Uuid
  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  storeId String   @db.Uuid
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@unique([partyId, storeId])
  @@index([partyId, savedAt])
  @@map("saved_store")
}

/// Photo-gallery images a store puts on its storefront — the shopfront
/// itself, a new delivery bike, whatever makes the store real. Same
/// storage-key discipline as ProductImage: opaque key, public URL via
/// /img, never served as a static asset.
model StorePhoto {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    String   @db.Uuid
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([storeId])
  @@map("store_photo")
}

model Product {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name             String
  description      String?
  /// One of PRODUCT_CATEGORIES in @esoqo/domain. Not a DB enum — that
  /// list is edited in application code, same reasoning as `status`
  /// below: a new category should never need a migration.
  category         String?
  priceKes         Decimal          @db.Decimal(12, 2)
  /// Null = untracked (a service, or stock the merchant doesn't count).
  stockQty         Int?
  /// Sell-by-order: the merchant doesn't hold the stock (or holds little),
  /// and fulfils once the buyer orders — "available on order". Order-first
  /// keeps working capital out of stock, the model MSMEs can actually run.
  availableOnOrder Boolean          @default(false)
  /// Cost of goods — what the merchant paid, needed to show gross profit.
  /// Optional: a business that doesn't track cost sees revenue only.
  costKes          Decimal?         @db.Decimal(12, 2)
  /// Retail unit the price refers to — "kg", "pc", "dozen", "litre"…
  /// Plain text so a mango seller can write "bunch" without a migration.
  unit             String?
  /// Unit the merchant bought the stock in — often differs from `unit`
  /// above: a tomato trader buys a crate by the kilo and sells by the
  /// piece. costKes/stockQty above describe this purchase quantity, so
  /// knowing it turns "paid KES 3,000 for 100" into "KES 30 per kilo"
  /// instead of silently assuming the buy and sell units are the same.
  purchaseUnit     String?
  /// When set, the product sells by variant instead of by itself: the
  /// storefront shows the label ("500g", "Blue", "1kg") with the variant's
  /// own price and stock. base priceKes acts as the default variant price.
  variants         ProductVariant[]
  /// ACTIVE | HIDDEN | SUSPENDED. A plain string, not an enum — a
  /// merchant hiding their own product is a listing decision the
  /// platform doesn't need to model as a state machine. SUSPENDED is
  /// the one value a merchant cannot set themselves — see reviewedById
  /// below; setProductVisibility refuses to touch a suspended product.
  status           String           @default("ACTIVE")
  /// Staff moderation — mirrors Document's reviewNote/reviewedById/
  /// reviewedAt shape below, same reasoning: who suspended it, why,
  /// and when, so a merchant asking "why is my product down" gets a
  /// real answer instead of "the system did it".
  reviewNote       String?
  reviewedById     String?          @db.Uuid
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         ProductImage[]
  orderItems     StoreOrderItem[]
  posSaleItems   PosSaleItem[]
  staffNotes     ProductStaffNote[]
  stockPurchases StockPurchase[]
  stockLocations StockLocation[]

  @@index([storeId, status])
  @@index([category])
  @@map("product")
}

/// A running conversation between staff and a merchant about one
/// product — separate from a suspension's single reviewNote because a
/// product can get more than one comment over time ("fix the price" now,
/// "thanks, reinstating" later), and both sides of that history matter.
model ProductStaffNote {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  staffId   String   @db.Uuid
  note      String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@map("product_staff_note")
}

model ProductImage {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @db.Uuid
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Opaque R2 object key — never the client's filename (see storage.ts).
  /// Needed to actually delete the object when the image or product is
  /// removed; `url` alone (the public-facing address) isn't reliably
  /// reversible back to a key.
  storageKey String
  url        String
  position   Int     @default(0)

  @@index([productId])
  @@map("product_image")
}

/// A sellable option of a Product — "500g"/"Blue"/"1kg". Has its own
/// price and stock, so a duka can price a soda by size without editing
/// the parent on every price change. A product with variants sells via
/// these; see Product.variants.
model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// What the customer sees — "500g", "Red", "1kg bolle".
  label            String
  /// Its own price — the base product price is the default.
  priceKes         Decimal  @db.Decimal(12, 2)
  /// Null = untracked stock, same meaning as Product.stockQty.
  stockQty         Int?
  /// Order-first, same meaning as Product.availableOnOrder — a variant
  /// the merchant fulfils once ordered rather than holding stock.
  availableOnOrder Boolean  @default(false)
  costKes          Decimal? @db.Decimal(12, 2)
  /// Optional barcode/EAN for the option.
  sku              String?

  posItems       PosSaleItem[]
  orderItems     StoreOrderItem[]
  stockPurchases StockPurchase[]
  stockLocations StockLocation[]

  @@index([productId])
  @@map("product_variant")
}

/// How a storefront order is fulfilled — "Pick up at the kiosk" or
/// "Boda delivery". The buyer picks one at checkout; the fee is added
/// to the order. Managed by the merchant from settings.
model FulfilmentOption {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// PICKUP | DELIVERY
  kind   String
  /// "Pickup at Kawangware", "Boda — same day"
  label  String
  /// Fee on top of the basket, KES. 0 for free collection.
  feeKes Decimal @default(0) @db.Decimal(12, 2)
  active Boolean @default(true)

  orders StoreOrder[]

  @@index([storeId, active])
  @@map("fulfilment_option")
}

enum StoreOrderStatus {
  PENDING_PAYMENT
  PAID
  /// Packed and waiting at the store for the buyer to collect — only
  /// reached for orders whose chosen fulfilment option is PICKUP. See
  /// StoreOrder.pickupCode.
  READY_FOR_PICKUP
  FULFILLED
  CANCELLED
}

/// Kitchen-facing state for a dine-in order — deliberately a parallel
/// enum, not folded into StoreOrderStatus above: retail pickup/delivery
/// semantics (PENDING_PAYMENT/READY_FOR_PICKUP/FULFILLED) mean nothing
/// to a kitchen, and a paid dine-in order sits at ORDERED/PREPARING/
/// SERVED for the whole meal while StoreOrderStatus itself is already
/// PAID — two independent lifecycles on one order, not one state
/// machine wearing two hats. Only set when StoreOrder.tableLabel is.
enum DineInStatus {
  ORDERED
  PREPARING
  SERVED
  PAYING
  CLOSED
}

/// One waiter/host's current table, for the length of a shift. A
/// person's own device isn't required to run this in v1 — the store
/// owner's existing subject session assigns and reassigns tables from
/// the table board the same way OrgFleetScreen already lets a fleet
/// owner run trips without every driver having their own login; per-
/// cashier PIN sign-in to claim a table directly is a natural fast-
/// follow (mirrors TicketOrgStaff/CREW's own path — see
/// docs/adr/0005), not built in this pass. Superseding a table's
/// assignment ends the old row rather than deleting it, so "who served
/// table 4 at 8pm last Tuesday" stays answerable.
model TableAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  storeId    String    @db.Uuid
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableLabel String
  cashierId  String    @db.Uuid
  cashier    Cashier   @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  endedAt    DateTime?

  @@index([storeId, tableLabel, endedAt])
  @@map("table_assignment")
}

enum StoreOrderPaymentMethod {
  MPESA_STK
  CASH_ON_DELIVERY
  VOUCHER
}

/// A checkout on the public storefront. The buyer need not be a
/// registered Esoqo subject — buyerParty is set only when they are.
model StoreOrder {
  id           String  @id @default(uuid()) @db.Uuid
  storeId      String  @db.Uuid
  store        Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  buyerPartyId String? @db.Uuid
  buyerParty   Party?  @relation(fields: [buyerPartyId], references: [id])
  buyerName    String
  buyerMsisdn  String

  status        StoreOrderStatus        @default(PENDING_PAYMENT)
  paymentMethod StoreOrderPaymentMethod @default(MPESA_STK)
  totalKes      Decimal                 @db.Decimal(12, 2)

  /// Checkout fulfilment — which option the buyer chose and what the
  /// delivery/pickup fee added. Empty until a FulfilmentOption exists.
  deliveryOptionId String?           @db.Uuid
  deliveryOption   FulfilmentOption? @relation(fields: [deliveryOptionId], references: [id])
  deliveryFeeKes   Decimal?          @db.Decimal(12, 2)
  /// Free-text note for the shop — "hand to Joshua at gate three".
  collectionNotes  String?
  /// Where a DELIVERY order goes — street/estate/landmark, plain text
  /// captured at checkout. Tracked so COD and last-mile delivery have a
  /// real destination on record.
  deliveryAddress  String?

  /// Set once payment clears on a PICKUP order — a short code the
  /// buyer reads out at the counter, checked against staff input
  /// before the order can be marked FULFILLED. Never set for DELIVERY
  /// orders.
  pickupCode  String?   @unique
  /// When the store moved this order to READY_FOR_PICKUP.
  readyAt     DateTime?
  /// When pickupCode was actually verified and handed over — distinct
  /// from paidAt/status=FULFILLED alone so "how long did it sit ready"
  /// is a real, queryable duration.
  collectedAt DateTime?

  /// Cross-channel customer account, when the phone already belongs to a
  /// StoreCustomer (auto-created at checkout or matched by msisdn).
  customerId String?        @db.Uuid
  customer   StoreCustomer? @relation(fields: [customerId], references: [id])

  /// Daraja's CheckoutRequestID. Doubles as the idempotency guard for
  /// a callback that arrives twice — see JournalEntry.idempotencyKey.
  mpesaCheckoutRequestId String?       @unique
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])
  voucherId              String?       @db.Uuid

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  /// Staff-mediated reroute — set when this store can't fulfil the
  /// order and staff need to hand-pick another vendor selling the same
  /// thing. Deliberately not an automated reassignment: money and a
  /// merchant's reputation are on the line, so a human stays in the
  /// loop. Only meaningful before payment moves — see reassignOrder.
  needsReroute       Boolean   @default(false)
  rerouteReason      String?
  rerouteFlaggedById String?   @db.Uuid
  rerouteFlaggedAt   DateTime?

  /// Set when this order came from a scanned restaurant table QR
  /// (esoqo://table?slug=...&table=...) — the actual persistence the
  /// universal scanner's own comment always claimed existed. Nullable:
  /// most orders (retail pickup/delivery) have no table at all.
  tableLabel   String?
  dineInStatus DineInStatus?

  /// A basket built by scanning shelf barcodes and paid at the door,
  /// not packed and collected later — mall/supermarket self-checkout.
  /// Distinct from a PICKUP FulfilmentOption (which means "come back
  /// and collect a packed order"): this buyer already has the goods in
  /// hand the moment they pay, they just need to prove it walking out.
  /// Drives the exact same pickupCode mechanism (see
  /// ConfirmStoreOrderPaymentByCheckoutID) rather than a new code
  /// space — a guard's exit check and a pickup counter's collection
  /// check are the same shape, just gated by a different reason.
  isSelfCheckout Boolean @default(false)

  /// Tip, and who it's credited to — separate from totalKes so it
  /// never inflates the line the kitchen/register actually rang up.
  /// tippedCashierId is resolved from the table's active
  /// TableAssignment at the moment the tip is added, not looked up
  /// again later — a table's assignment changing after should never
  /// retroactively move a tip someone already gave.
  tipKes          Decimal? @db.Decimal(12, 2)
  tippedCashierId String?  @db.Uuid
  tippedCashier   Cashier? @relation(fields: [tippedCashierId], references: [id])

  items                 StoreOrderItem[]
  receipts              Receipt[]
  customerLedgerEntries CustomerLedgerEntry[]
  loyaltyEntries        LoyaltyEntry[]

  @@index([storeId, status])
  @@index([needsReroute])
  @@index([storeId, tableLabel, dineInStatus])
  @@map("store_order")
}

model StoreOrderItem {
  id           String          @id @default(uuid()) @db.Uuid
  orderId      String          @db.Uuid
  order        StoreOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String          @db.Uuid
  product      Product         @relation(fields: [productId], references: [id])
  /// Set when the order picked a variant of the product.
  variantId    String?         @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  quantity     Int
  unitPriceKes Decimal         @db.Decimal(12, 2)
  /// Cost snapshot at sale time so gross profit survives later price edits.
  costKes      Decimal?        @db.Decimal(12, 2)

  @@index([orderId])
  @@map("store_order_item")
}

enum PosSyncStatus {
  PENDING // queued on-device, not yet reconciled
  SYNCED
  CONFLICT
}

enum PosPaymentMethod {
  CASH
  MPESA_TILL
  /// An STK push initiated from the terminal on the buyer's phone.
  MPESA_STK
  /// Goods leave the shop now, cash later — the credit book. Requires a
  /// customer (someone has to owe it). No money has moved yet, so this
  /// posts a CustomerLedgerEntry, not a commerce-ledger entry — see
  /// recordPosSale and recordCustomerPayment.
  ON_ACCOUNT
}

enum PosSaleStatus {
  COMPLETED
  REFUNDED
  VOID
}

/// A terminal sale. clientSaleId is generated on-device at the moment
/// of sale, offline or not — it is what makes a queued sale replayed
/// twice by the outbox harmless instead of double-counted.
model PosSale {
  id            String           @id @default(uuid()) @db.Uuid
  storeId       String           @db.Uuid
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clientSaleId  String           @unique
  paymentMethod PosPaymentMethod
  totalKes      Decimal          @db.Decimal(12, 2)
  /// Whole-receipt discount, subtracted from the basket before total.
  discountKes   Decimal          @default(0) @db.Decimal(12, 2)
  syncStatus    PosSyncStatus    @default(SYNCED)
  status        PosSaleStatus    @default(COMPLETED)
  /// When it happened on the device — may be well before syncedAt.
  soldAt        DateTime
  syncedAt      DateTime         @default(now())

  /// Cash drawer: what the customer handed over and the change returned.
  tenderedKes Decimal? @db.Decimal(12, 2)
  changeKes   Decimal? @db.Decimal(12, 2)

  /// The cashier behind the terminal (null for the owner selling directly).
  cashierId  String?        @db.Uuid
  cashier    Cashier?       @relation(fields: [cashierId], references: [id])
  /// The shift this sale belongs to — null when the store doesn't open shifts.
  shiftId    String?        @db.Uuid
  shift      Shift?         @relation(fields: [shiftId], references: [id])
  /// A cross-channel customer account, when the sale is charged or checked
  /// against one. Optional — a walk-in paid-cash sale needn't create one.
  customerId String?        @db.Uuid
  customer   StoreCustomer? @relation(fields: [customerId], references: [id])

  journalEntryId String?       @unique @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  items                 PosSaleItem[]
  refunds               PosRefund[]
  receipts              Receipt[]
  customerLedgerEntries CustomerLedgerEntry[]
  loyaltyEntries        LoyaltyEntry[]

  @@index([storeId, soldAt])
  @@index([storeId, status])
  @@index([shiftId])
  @@map("pos_sale")
}

model PosSaleItem {
  id           String          @id @default(uuid()) @db.Uuid
  saleId       String          @db.Uuid
  sale         PosSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String          @db.Uuid
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?         @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  quantity     Int
  unitPriceKes Decimal         @db.Decimal(12, 2)
  /// Per-line discount (negotiation, "regular" price).
  discountKes  Decimal         @default(0) @db.Decimal(12, 2)
  /// Cost snapshot at sale time — gross profit.
  costKes      Decimal?        @db.Decimal(12, 2)

  @@index([saleId])
  @@map("pos_sale_item")
}

// ──────────────────── SUPPLIERS & STOCK PURCHASES ────────────────

/// Who a merchant buys from — the milk vendor, the tomato wholesaler,
/// the guy who brings bread at 6am. Kept as its own record (not just
/// free text on a purchase) so contact details are entered once and
/// "everything I've bought from this supplier" is a real query, not a
/// grep through notes.
model Supplier {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases StockPurchase[]

  @@index([storeId, name])
  @@map("supplier")
}

/// One delivery of stock into the shop — what came in, from whom, at
/// what price, on what date. This is the other half of the profit
/// picture a sale alone can't give: an MSME here rarely sells at a
/// fixed price (milk goes for KES 10 one day, KES 100 the next,
/// tomatoes are haggled every time — see PosSaleItem.discountKes), so
/// knowing what a batch actually cost is what turns "I sold stuff
/// today" into "I made a profit today". Recording a purchase bumps the
/// product's stockQty and folds the cost into its running average —
/// see recordStockPurchase.
model StockPurchase {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  /// Null when the merchant doesn't want to name one — a bargained buy
  /// from someone passing through is still worth recording.
  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  quantity     Int
  unitCostKes  Decimal  @db.Decimal(12, 2)
  /// Denormalised (quantity × unitCostKes) so a purchase list never
  /// needs to recompute it, and it survives if unitCostKes rounding
  /// changes later.
  totalCostKes Decimal  @db.Decimal(12, 2)
  /// When the stock actually arrived — may be entered after the fact,
  /// so this is independent of createdAt.
  purchasedAt  DateTime @default(now())
  notes        String?

  createdAt DateTime @default(now())

  @@index([storeId, purchasedAt])
  @@index([productId])
  @@index([supplierId])
  @@map("stock_purchase")
}

// ─────────────────── CUSTOMERS, CREDIT & LOYALTY ─────────────────

/// A store's own customer account, keyed by phone. The same shopper may
/// exist across stores — they are per-store records, deliberately not a
/// second global Party, because credit books and points are a store's
/// private ledger. Created automatically at the first touchpoint
/// (checkout or an attended sale) and editable from the merchant's app.
model StoreCustomer {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  msisdn          String
  name            String?
  notes           String?
  /// Set when this customer is an onboarded Organisation buying on
  /// account, not an anonymous phone-keyed shopper — lets the same
  /// buyer resolve to one stable customer row across different members
  /// placing an order on the org's behalf. Optional: every existing
  /// (storeId, msisdn) consumer customer is unaffected.
  partyId         String?  @db.Uuid
  party           Party?   @relation(fields: [partyId], references: [id])
  /// Merchant-set B2B terms — config, not a ledger row. Null means "no
  /// credit granted"; the ledger (below) still tracks what's actually
  /// owed regardless of these limits.
  creditLimitKes  Decimal? @db.Decimal(12, 2)
  creditTermsDays Int?
  /// How much the customer currently owes the shop. Derive from the
  /// ledger (sum of entries), never stored on the row — see the "balances
  /// are derived" rule in this schema's header.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ledger   CustomerLedgerEntry[]
  loyalty  LoyaltyEntry[]
  posSales PosSale[]
  orders   StoreOrder[]

  @@unique([storeId, msisdn])
  @@index([storeId, name])
  @@index([partyId])
  @@map("store_customer")
}

/// One move in a customer's money ledger — a sale on credit, a payment,
/// an adjustment. Amount is signed: a SALE on credit appears as a
/// positive (they owe that much more), a PAYMENT as a negative. Balance
/// = sum of all entries. Never mutate an entry once written.
model CustomerLedgerEntry {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @db.Uuid
  /// Restrict, not Cascade: these rows are financial history — what a
  /// customer paid and what they still owe. Cascading meant deleting one
  /// customer row silently destroyed their entire credit-book and
  /// loyalty ledger, with the settlement postings in journal_entry left
  /// behind referencing nothing. Nothing deletes StoreCustomer today, so
  /// this costs nothing now and refuses the delete rather than losing
  /// the money trail if such a path is ever added.
  customer   StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// SALE | PAYMENT | REFUND | ADJUSTMENT
  kind      String
  /// Signed — see the model comment above.
  amountKes Decimal     @db.Decimal(12, 2)
  note      String?
  saleId    String?     @db.Uuid
  sale      PosSale?    @relation(fields: [saleId], references: [id])
  orderId   String?     @db.Uuid
  order     StoreOrder? @relation(fields: [orderId], references: [id])
  createdAt DateTime    @default(now())

  /// Caller-supplied de-duplication token, one per user intent (a till
  /// operator pressing "record payment" once). The unique index is what
  /// actually enforces it: a double-click sends the same requestId
  /// twice and the second insert loses, rather than quietly creating a
  /// second ledger entry and a second settlement posting. Nullable so
  /// existing rows and internal callers that pass nothing still work.
  requestId String? @db.Uuid

  @@unique([requestId])
  @@index([customerId, createdAt])
  @@map("customer_ledger_entry")
}

/// Loyalty points granted and redeemed against a customer. Balance is
/// derived the same way money is — never stored.
model LoyaltyEntry {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @db.Uuid
  /// Restrict, not Cascade: these rows are financial history — what a
  /// customer paid and what they still owe. Cascading meant deleting one
  /// customer row silently destroyed their entire credit-book and
  /// loyalty ledger, with the settlement postings in journal_entry left
  /// behind referencing nothing. Nothing deletes StoreCustomer today, so
  /// this costs nothing now and refuses the delete rather than losing
  /// the money trail if such a path is ever added.
  customer   StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// Signed. Positive = earned on a sale; negative = redeemed.
  points    Int
  /// EARN | REDEEM | ADJUSTMENT
  kind      String
  note      String?
  saleId    String?     @db.Uuid
  sale      PosSale?    @relation(fields: [saleId], references: [id])
  orderId   String?     @db.Uuid
  order     StoreOrder? @relation(fields: [orderId], references: [id])
  createdAt DateTime    @default(now())

  /// Double-submit guard for redemptions — see the identically named
  /// field on CustomerLedgerEntry.
  requestId String? @db.Uuid

  @@unique([requestId])
  @@index([customerId, createdAt])
  @@map("loyalty_entry")
}

// ─────────────────────── CASHIERS & SHIFTS ──────────────────────

/// A counter operator with their own PIN, distinct from the owner's
/// sign-in. PIN is Argon2id-hashed (see seed.ts for the parameters).
/// Cashiers act as themselves on the terminal and are attached to the
/// sales they ring up; a manager/owner can draw the cash drawer, a plain
/// cashier cannot open the drawer without one.
model Cashier {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name      String
  pinHash   String
  /// CASHIER | MANAGER
  role      String   @default("CASHIER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts           Shift[]
  posSales         PosSale[]
  refunds          PosRefund[]
  tableAssignments TableAssignment[]
  tippedOrders     StoreOrder[]

  @@index([storeId])
  @@map("cashier")
}

/// One open/close of the register. A merchant watches the drawer by
/// opening a shift with the float in it, selling, then closing and
/// counting: the system already knows the expected cash from that
/// shift's sales (cash method minus cash refunds plus the still-open
/// float) and the variance is counted − expected.
model Shift {
  id        String  @id @default(uuid()) @db.Uuid
  storeId   String  @db.Uuid
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashierId String  @db.Uuid
  cashier   Cashier @relation(fields: [cashierId], references: [id])

  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openingFloatKes Decimal   @default(0) @db.Decimal(12, 2)
  /// Set when the shift closes: cash sales − cash refunds + opening float.
  expectedCashKes Decimal?  @db.Decimal(12, 2)
  /// What the drawer actually had, counted by the closing cashier.
  countedCashKes  Decimal?  @db.Decimal(12, 2)
  /// counted − expected. Positive = over, negative = short.
  varianceKes     Decimal?  @db.Decimal(12, 2)
  /// OPEN | CLOSED
  status          String    @default("OPEN")

  posSales PosSale[]

  @@index([storeId, openedAt])
  @@index([status])
  @@map("shift")
}

/// A refunded (or voided) PoS sale. Kept as a separate row so a sale's
/// history is never rewritten — the sale is marked REFUNDED and this
/// record carries who did it, why, and the amount returned.
model PosRefund {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @db.Uuid
  sale      PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  storeId   String   @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashierId String?  @db.Uuid
  cashier   Cashier? @relation(fields: [cashierId], references: [id])

  reason       String
  refundMethod PosPaymentMethod
  amountKes    Decimal          @db.Decimal(12, 2)
  createdAt    DateTime         @default(now())

  @@index([saleId])
  @@index([storeId, createdAt])
  @@map("pos_refund")
}

/// One receipt issued for a sale or an order — a fulfilment channel's
/// copy (print/SMS/WhatsApp). The same sale may have several receipts;
/// the merchant keeps a printable copy on file, and an SMS/WhatsApp copy
/// goes to the shopper. A KRA eTIMS serial, where the store has eTIMS
/// enabled, makes the receipt compliant with Kenya's VAT Act 2013 (as
/// amended) and the count published under the eTIMS regime.
model Receipt {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Human-facing, sequential per store: e.g. 000147.
  receiptNo   String      @unique
  saleId      String?     @db.Uuid
  sale        PosSale?    @relation(fields: [saleId], references: [id])
  orderId     String?     @db.Uuid
  order       StoreOrder? @relation(fields: [orderId], references: [id])
  totalKes    Decimal     @db.Decimal(12, 2)
  /// KRA eTIMS serial for fiscal receipts — null when eTIMS is off.
  etimsSerial String?
  /// PRINT | SMS | WHATSAPP
  channel     String
  /// SMS/WhatsApp target (the customer's msisdn); null for a printed copy.
  sentTo      String?
  issuedAt    DateTime    @default(now())

  @@index([storeId, issuedAt])
  @@index([saleId])
  @@map("receipt")
}

/// Pricing is data, not code — every fee shown anywhere in the store
/// wizard reads one of these rows. No process.env price constants.
model PricingRule {
  id            String     @id @default(uuid()) @db.Uuid
  /// SUBDOMAIN_SETUP_FEE | SUBDOMAIN_MONTHLY_FEE | POS_MONTHLY_FEE |
  /// PLATFORM_FEE_PCT, etc. — read by key, never hardcoded elsewhere.
  key           String     @unique
  label         String
  amountKes     Decimal?   @db.Decimal(12, 2)
  amountPct     Decimal?   @db.Decimal(5, 2)
  /// ONE_TIME | MONTHLY | PER_ORDER
  billingPeriod String
  updatedAt     DateTime   @updatedAt
  updatedById   String?    @db.Uuid
  updatedBy     StaffUser? @relation(fields: [updatedById], references: [id])

  @@map("pricing_rule")
}

model Document {
  id             String        @id @default(uuid()) @db.Uuid
  partyId        String?       @db.Uuid
  party          Party?        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// Attached during registration, before a Party exists.
  registrationId String?       @db.Uuid
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  /// What the person called it. Their words, not a dropdown.
  title        String
  kind         String @default("OTHER")
  /// Opaque storage key. NEVER the user's filename — that is a path
  /// traversal and content-sniffing vector.
  storageKey   String @unique
  /// Kept only for display and download naming. Sanitised on the way in.
  originalName String
  mimeType     String
  sizeBytes    Int
  /// SHA-256 of the bytes. Detects duplicates and tampering.
  sha256       String

  status       DocumentStatus @default(PENDING_REVIEW)
  reviewNote   String?
  reviewedById String?        @db.Uuid
  reviewedAt   DateTime?

  uploadedAt     DateTime  @default(now())
  uploadedByType String    @default("SUBJECT")
  uploadedById   String?
  deletedAt      DateTime?

  extracted     Json?
  ocrConfidence Int?

  @@index([partyId, kind])
  @@index([registrationId])
  @@index([status, uploadedAt])
  @@map("document")
}

// ─────────────────────── AUTH SESSIONS (audit) ──────────────────

/// Redis holds live sessions. This is the durable record for audit
/// and for "sign me out everywhere".
model SessionRecord {
  id        String    @id @default(uuid()) @db.Uuid
  partyId   String?   @db.Uuid
  tokenHash String    @unique
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  deviceId  String?

  @@index([partyId, revokedAt])
  @@map("session_record")
}

// ─────────────────────────── STAFF & RBAC ───────────────────────

model StaffUser {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.Citext
  name           String
  pinHash        String
  orgId          String?   @db.Uuid
  /// Preset the capabilities were derived from. Display only — the
  /// capability list is the model, not this.
  rolePreset     String?   @default("VIEWER")
  /// Optional scope. Empty means national.
  countyScope    String[]  @default([])
  invitedById    String?   @db.Uuid
  mustChangePin  Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  suspendedAt    DateTime?
  /// Capability strings, e.g. "registration.read", "audit.read",
  /// "attestation.issue:GROUP_REGISTERED". Never a role enum —
  /// roles are presets of these, not the model itself.
  capabilities   String[]  @default([])
  active         Boolean   @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  approvals             PaymentApproval[]
  pricingRulesUpdated   PricingRule[]
  parcelPricingRulesSet ParcelPricingRule[] @relation("parcelPricingRulesSet")

  @@index([active, rolePreset])
  @@map("staff_user")
}

// ──────────────────────────── AUDIT LOG ─────────────────────────

/// Append-only, hash-chained. If a row is altered or removed the chain
/// breaks and `pnpm audit:verify` will say so.
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now())
  actorType  String // SUBJECT | STAFF | AGENT | SYSTEM | ISSUER
  actorId    String?
  action     String // registration.created, consent.granted, otp.sent …
  targetType String?
  targetId   String?
  payload    Json     @default("{}")
  ip         String?
  /// SHA-256 over (prevHash + canonical(row)). Chain root uses AUDIT_CHAIN_SEED.
  prevHash   String
  hash       String   @unique

  @@index([occurredAt])
  @@index([action, occurredAt])
  @@index([actorId])
  /// Added for GroupTimeline (dbx.GroupTimeline) — a member-visible,
  /// plain-language feed scoped to one group (targetType "group",
  /// targetId the org's partyId), read often enough on GroupDetailScreen
  /// that this needed its own index rather than relying on the
  /// (action, occurredAt) one above, which doesn't help a targetId
  /// filter at all.
  @@index([targetType, targetId, occurredAt])
  @@map("audit_event")
}

// ──────────────────────── REFERENCE DATA ────────────────────────

model County {
  code            String    @id
  name            String    @unique
  hasFieldOfficer Boolean   @default(false)
  pricesLive      Boolean   @default(false)
  population      String?
  financeActRef   String?
  verifiedOn      DateTime?

  markets Market[]
  permits Permit[]

  @@map("county")
}

model Market {
  id         String  @id @default(uuid()) @db.Uuid
  name       String
  countyCode String
  county     County  @relation(fields: [countyCode], references: [code])
  marketDays String?
  reporting  Boolean @default(false)

  prices PriceQuote[]

  @@unique([name, countyCode])
  @@map("market")
}

model Permit {
  id         String     @id @default(uuid()) @db.Uuid
  countyCode String
  county     County     @relation(fields: [countyCode], references: [code])
  name       String
  issuedBy   String
  feeText    String
  note       String?
  claimType  ClaimType?

  @@index([countyCode])
  @@map("permit")
}

model Commodity {
  id       String @id @default(uuid()) @db.Uuid
  name     String @unique
  unit     String
  category String // veg | cereal | fruit | live | goods

  prices PriceQuote[]

  @@map("commodity")
}

/// One quote, one market, one day. Absence is meaningful — the UI must
/// say "not submitted today" rather than repeat yesterday's figure.
model PriceQuote {
  id          String    @id @default(uuid()) @db.Uuid
  commodityId String    @db.Uuid
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  marketId    String    @db.Uuid
  market      Market    @relation(fields: [marketId], references: [id])
  priceKes    Decimal   @db.Decimal(12, 2)
  quotedFor   DateTime  @db.Date
  collectedAt DateTime  @default(now())
  source      String
  collectedBy String?

  @@unique([commodityId, marketId, quotedFor])
  @@index([quotedFor])
  @@map("price_quote")
}

// ═══════════════════════ OUR JAMII (CECF community pages) ═══════════
//
// A public mini-site + crowdfunding layer on top of the Party/
// Organisation an org already has everywhere else on the platform.
// Deliberately NOT a parallel "community org" identity system — see
// the file header. JamiiPage is 1:1 with Organisation the same way
// Person/Organisation are 1:1 with Party.

enum JamiiPageStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum JamiiThemeMode {
  DARK
  LIGHT
}

/// A homepage block's visual shape — see JamiiPageBlock.data for what
/// each type stores. STATS_TICKER/EXPLORE_GRID/ACTIVE_CAMPAIGN are the
/// pre-seeded, singleton sections the pre-Phase-2 homepage always
/// rendered (see OrgHomeSections's DefaultHomeSections fallback); the
/// rest are genuinely new content types an org can add more than once.
enum JamiiBlockType {
  STATS_TICKER
  EXPLORE_GRID
  ACTIVE_CAMPAIGN
  DONATE_BAND
  RICH_TEXT
  TESTIMONIAL
  PHOTO_STRIP
  // Generic-CMS block library (Phase 5) — general-purpose widgets any
  // page (home or custom) can use, plus five that read live from the
  // same tables the old fixed sections did (JamiiProgram, team
  // members, JamiiPhoto, the `faq` json, the org's contact fields),
  // same "block carries placement, not a content copy" pattern as
  // EXPLORE_GRID/ACTIVE_CAMPAIGN above.
  HERO
  CTA_BUTTON
  IMAGE_TEXT
  VIDEO_EMBED
  MAP_EMBED
  COLUMNS
  SPACER
  PROGRAMS_LIST
  TEAM_GRID
  GALLERY_GRID
  FAQ_ACCORDION
  CONTACT_FORM
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

/// A JamiiSitePage's origin. SYSTEM_* rows are seeded once per page
/// (one each, reserved slug matching the pre-generic-CMS fixed routes
/// — /about, /faq, etc. — for URL/SEO continuity) and can't be
/// deleted, only edited; CUSTOM is anything an org creates itself via
/// the dashboard's "New page" flow and may rename or delete freely.
enum JamiiSitePageKind {
  SYSTEM_HOME
  SYSTEM_ABOUT
  SYSTEM_PROGRAMS
  SYSTEM_CAMPAIGNS
  SYSTEM_POSTS
  SYSTEM_GALLERY
  SYSTEM_LEADERSHIP
  SYSTEM_FAQ
  SYSTEM_CONTACT
  CUSTOM
}

/// What a JamiiNavItem points at — SITE_PAGE resolves via
/// targetSitePageId (works for both SYSTEM_* and CUSTOM pages alike,
/// so the nav manager treats every page the same), EXTERNAL_URL uses
/// the plain `externalUrl` string instead.
enum JamiiNavTargetKind {
  SITE_PAGE
  EXTERNAL_URL
}

enum JamiiTeamRole {
  ADMIN
  EDITOR
  CONTRIBUTOR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DonationStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum JamiiInterestStatus {
  NEW
  CONTACTED
  CONVERTED
  DISMISSED
}

enum JamiiContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model JamiiPage {
  organisationId String       @id @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [partyId], onDelete: Cascade)

  /// Public URL segment — ourjamii.esoqo.../o/{slug}. Unique platform-wide.
  slug   String          @unique
  status JamiiPageStatus @default(DRAFT)

  /// One-line pitch, shown on Discover cards and the hero carousel.
  tagline      String?
  /// Short mission used in cards/carousel where space is tight.
  missionShort String?
  /// Long-form "About" body shown on the public page's About section.
  aboutUs      String?

  logoStorageKey  String?
  logoUrl         String?
  coverStorageKey String?
  coverUrl        String?

  /// The whitelabel theme (custom-domain only — see
  /// apps/jamii/src/components/whitelabel). brandAccent is the primary
  /// colour (template's "crimson"); the other two are optional — unset
  /// falls back to the template's own cyan/gold so a org needs to pick
  /// only one colour to look intentional, three to look bespoke.
  brandAccent      String?
  brandAccentTwo   String?
  brandAccentThree String?
  /// Which theme mode a first-time visitor sees before their own
  /// toggle (dark/light/contrast/text-size, all client-side after
  /// that — see ThemeController) has ever run.
  themeDefaultMode JamiiThemeMode @default(DARK)
  /// The "Our vision" card alongside missionShort's "Our mission" one
  /// on the whitelabel About page.
  visionShort      String?

  /// Free text, e.g. "Wednesdays, 4pm · Nyalenda B Social Hall".
  meetingSchedule String?
  contactEmail    String?
  contactPhone    String?
  website         String?
  facebook        String?
  instagram       String?
  twitter         String?
  whatsapp        String?

  /// [{ q, a }] — small and static enough that a table would be
  /// overkill, same precedent as Person.displayPrefs.
  faq Json @default("[]")

  /// SEO overrides — when unset, buildOrgMetadata() (apps/jamii/src/lib/
  /// seo.ts) derives a title/description from officialName/missionShort
  /// instead. Only worth setting when the auto-derived version is
  /// genuinely wrong for search, not a duplicate of tagline/mission.
  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  photos         JamiiPhoto[]
  posts          JamiiPost[]
  programs       JamiiProgram[]
  campaigns      Campaign[]
  team           JamiiTeamMember[]
  domain         JamiiDomain?
  messages       JamiiContactMessage[]
  blocks         JamiiPageBlock[]
  sitePages      JamiiSitePage[]
  navItems       JamiiNavItem[]
  supportTickets SupportTicket[]

  @@index([status])
  @@map("jamii_page")
}

/// One page on an org's site — home, the pre-generic-CMS fixed
/// sections (now just JamiiSitePageKind.SYSTEM_*, same slugs as
/// before), and any custom page an org creates. Every page's visible
/// content lives in its `blocks` (JamiiPageBlock, ordered by
/// position); this row itself only carries identity, publish status,
/// and per-page SEO overrides — see buildOrgMetadata (apps/jamii/src/
/// lib/seo.ts) for the fallback chain from these down to JamiiPage's
/// own seoTitle/seoDescription.
///
/// SYSTEM_* rows are seeded once per JamiiPage (see the backfill in
/// prisma/migrations — every existing org gets its 9 rows with the
/// exact slugs the old fixed routes used) and their slug/kind never
/// change; only CUSTOM rows are created, renamed, or deleted from the
/// dashboard's "Pages" screen.
model JamiiSitePage {
  id     String            @id @default(uuid()) @db.Uuid
  pageId String            @db.Uuid
  page   JamiiPage         @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  kind   JamiiSitePageKind @default(CUSTOM)

  /// No leading slash, e.g. "about" or "our-impact" — resolved by
  /// (site)/o/[slug]/[page]/page.tsx. Unique per org, not
  /// platform-wide (unlike JamiiPage.slug).
  slug  String
  title String

  status PublishStatus @default(DRAFT)

  /// Falls back to JamiiPage.seoTitle/seoDescription, then to
  /// missionShort/tagline — same chain buildOrgMetadata already
  /// applies at the org level, just one layer deeper.
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks   JamiiPageBlock[]
  navItems JamiiNavItem[]

  @@unique([pageId, slug])
  @@index([pageId, kind])
  @@map("jamii_site_page")
}

/// One entry in an org's top/sub nav — see org-links-shared.ts's
/// ORG_NAV_SECTIONS, the static const this table replaces. `position`
/// is the display order the dashboard's Navigation screen reorders via
/// drag-and-drop, same convention as JamiiPageBlock.position.
model JamiiNavItem {
  id     String    @id @default(uuid()) @db.Uuid
  pageId String    @db.Uuid
  page   JamiiPage @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)

  label      String
  targetKind JamiiNavTargetKind @default(SITE_PAGE)

  /// Set when targetKind is SITE_PAGE — cascades on the page's own
  /// delete, so removing a custom page quietly drops it from the nav
  /// too rather than leaving a dead link.
  targetSitePageId String?        @db.Uuid
  targetSitePage   JamiiSitePage? @relation(fields: [targetSitePageId], references: [id], onDelete: Cascade)
  /// Set when targetKind is EXTERNAL_URL instead.
  externalUrl      String?

  position     Int     @default(0)
  visible      Boolean @default(true)
  openInNewTab Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, position])
  @@map("jamii_nav_item")
}

/// One section of the custom-domain homepage — see OrgHomeSections.tsx.
/// Empty for every page until an org saves something in the dashboard's
/// "Homepage" block editor; the public renderer falls back to the
/// pre-Phase-2 fixed section order when a page has zero rows, so this
/// table being empty is the normal, unmigrated state, not an error.
model JamiiPageBlock {
  id         String         @id @default(uuid()) @db.Uuid
  pageId     String         @db.Uuid
  page       JamiiPage      @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  /// Which JamiiSitePage this block belongs to. Nullable through the
  /// generic-CMS migration only: pre-existing rows are all homepage
  /// blocks and get backfilled onto that org's SYSTEM_HOME page (see
  /// the backfill migration); every row written from here on always
  /// sets this. Not required at the DB level yet so the backfill can
  /// run as its own transaction after the column lands, same
  /// two-step-migration discipline as the rich-text backfill.
  sitePageId String?        @db.Uuid
  sitePage   JamiiSitePage? @relation(fields: [sitePageId], references: [id], onDelete: Cascade)
  type       JamiiBlockType
  position   Int            @default(0)
  visible    Boolean        @default(true)
  /// Shape depends on `type` — see jamiiPageBlockSchema in
  /// packages/domain/src/jamii.ts, the single source of truth for what
  /// each type's data looks like.
  data       Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([pageId])
  @@index([sitePageId])
  @@map("jamii_page_block")
}

/// Gallery images a page puts on its public profile. Same storage-key
/// discipline as StorePhoto: opaque key, public URL via /img.
model JamiiPhoto {
  id         String    @id @default(uuid()) @db.Uuid
  pageId     String    @db.Uuid
  page       JamiiPage @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  storageKey String
  url        String
  caption    String?
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([pageId])
  @@map("jamii_photo")
}

/// A message submitted through the public Contact page's form —
/// visible only to this page's own team (dashboard "Messages" screen),
/// never a platform-wide inbox. Deliberately not a JamiiInterest: that
/// is "wants Our Jamii access" and is reviewed by Esoqo staff; this is
/// a visitor writing to one specific org, reviewed only by that org's
/// own team via requirePageAccess, the same as every other page-scoped
/// write in jamii-page.ts.
model JamiiContactMessage {
  id     String                    @id @default(uuid()) @db.Uuid
  pageId String                    @db.Uuid
  page   JamiiPage                 @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  status JamiiContactMessageStatus @default(NEW)

  name    String
  email   String  @db.Citext
  phone   String?
  subject String?
  message String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([pageId, status, createdAt])
  @@map("jamii_contact_message")
}

/// The "Updates" carousel on the public page.
model JamiiPost {
  id              String        @id @default(uuid()) @db.Uuid
  pageId          String        @db.Uuid
  page            JamiiPage     @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  title           String
  excerpt         String?
  body            String
  imageStorageKey String?
  imageUrl        String?
  status          PublishStatus @default(DRAFT)
  authorPartyId   String?       @db.Uuid
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([pageId, status])
  @@map("jamii_post")
}

/// The "Programs" accordion on the public page.
model JamiiProgram {
  id           String    @id @default(uuid()) @db.Uuid
  pageId       String    @db.Uuid
  page         JamiiPage @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  title        String
  body         String
  icon         String?
  position     Int       @default(0)
  linkedPostId String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([pageId])
  @@map("jamii_program")
}

/// Platform-wide "no photo yet" placeholders for a JamiiPage's media
/// slots (hero cover, gallery, post cover) — never per-org. `patternKey`
/// is a code-authored, trusted abstract SVG pattern (see apps/jamii's
/// illustration registry), not stored SVG markup: an org's own page
/// content is never rendered as raw HTML/SVG, so there's no
/// stored-XSS surface here even though this table is staff-editable.
/// Staff (jamii-media.manage) curate which patterns are on offer and
/// in what order; apps/jamii picks one per empty slot by category.
model JamiiMediaAsset {
  id         String             @id @default(uuid()) @db.Uuid
  key        String             @unique
  label      String
  category   JamiiMediaCategory
  patternKey String
  active     Boolean            @default(true)
  position   Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([category, active])
  @@map("jamii_media_asset")
}

enum JamiiMediaCategory {
  HERO
  GALLERY
  POST
}

/// Who may manage a page, and at what level — deliberately separate
/// from Membership (a person's real role in the group: chairperson,
/// treasurer, ...). A treasurer isn't necessarily who edits the page,
/// and a page editor need not be an office-holder.
model JamiiTeamMember {
  id          String        @id @default(uuid()) @db.Uuid
  pageId      String        @db.Uuid
  page        JamiiPage     @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  /// Null while an invite is pending and no Party/Person exists yet
  /// for that email/phone.
  personId    String?       @db.Uuid
  person      Party?        @relation(fields: [personId], references: [id])
  inviteName  String
  inviteEmail String
  role        JamiiTeamRole @default(EDITOR)
  invitedAt   DateTime      @default(now())
  acceptedAt  DateTime?
  removedAt   DateTime?

  @@unique([pageId, inviteEmail])
  @@index([personId])
  @@map("jamii_team_member")
}

/// A group's own domain (e.g. mchamawetu.org), linked to their JamiiPage
/// so the page reads as their website instead of a page on ours. 1:1 with
/// JamiiPage on purpose — one active domain per page keeps both the UX
/// and the security surface (ownership proof, TLS, staff moderation)
/// simple; relax to many if a real need for it shows up.
///
/// Ownership is proven two independent ways before status ever reaches
/// ACTIVE: Cloudflare's own Custom Hostname verification, and our own
/// verificationToken as a TXT record — defense in depth so activation
/// never rests on trusting one vendor's check alone. See
/// services/core/src/routes/jamii-domains.ts for the reconciler that
/// drives PENDING_DNS -> VERIFYING -> ACTIVE/FAILED, and
/// dal/jamii-domain.ts for why the Cloudflare API token itself never
/// reaches this app or the browser.
model JamiiDomain {
  id     String    @id @default(uuid()) @db.Uuid
  pageId String    @unique @db.Uuid
  page   JamiiPage @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)

  /// Lowercased, punycoded, no scheme/path. Unique platform-wide so two
  /// groups can't race the same domain, and never silently reused by a
  /// different page after removal.
  hostname String            @unique
  status   JamiiDomainStatus @default(PENDING_DNS)

  /// Random value shown to the group as a TXT record — our own proof of
  /// control, independent of Cloudflare's.
  verificationToken String

  /// Cloudflare Custom Hostname bookkeeping — opaque IDs/status only,
  /// never a secret.
  cfHostnameId  String?
  cfStatus      String?
  lastCheckedAt DateTime?
  failureReason String?

  requestedByPartyId String    @db.Uuid
  activatedAt        DateTime?
  removedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@map("jamii_domain")
}

enum JamiiDomainStatus {
  /// Just requested — group still needs to add the CNAME + TXT records.
  PENDING_DNS
  /// Records seen at least once; Cloudflare is issuing the certificate.
  VERIFYING
  /// Live — resolveJamiiDomain() will route traffic for this hostname.
  ACTIVE
  /// Cloudflare rejected it, or verification never completed in time.
  FAILED
  /// Staff kill-switch — moderateJamiiPage's sibling for domains.
  SUSPENDED
}

model Campaign {
  id      String         @id @default(uuid()) @db.Uuid
  pageId  String         @db.Uuid
  page    JamiiPage      @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  title   String
  /// Unique per page, not platform-wide — routed as /o/{pageSlug}/c/{slug}.
  slug    String
  summary String
  body    String?
  goalKes Decimal        @db.Decimal(12, 2)
  status  CampaignStatus @default(DRAFT)

  coverStorageKey String?
  coverUrl        String?
  startsAt        DateTime?
  endsAt          DateTime?

  /// One dedicated ledger account per campaign, opened alongside it.
  /// Kept apart from the org's GROUP_SAVINGS account on purpose.
  accountId String?  @unique @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates   CampaignUpdate[]
  donations Donation[]

  @@unique([pageId, slug])
  @@index([status])
  @@map("campaign")
}

model CampaignUpdate {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  body       String
  postedAt   DateTime @default(now())

  @@index([campaignId, postedAt])
  @@map("campaign_update")
}

/// A gift to a campaign. Mirrors StoreOrder: donor is an optional
/// Party (giving never requires an account — "Anonymous" just means
/// donorPartyId is null), paid via the same M-Pesa STK flow as
/// checkout, settled as a balanced JournalEntry.
model Donation {
  id            String         @id @default(uuid()) @db.Uuid
  campaignId    String         @db.Uuid
  campaign      Campaign       @relation(fields: [campaignId], references: [id])
  donorPartyId  String?        @db.Uuid
  donorParty    Party?         @relation(fields: [donorPartyId], references: [id])
  donorName     String         @default("Anonymous")
  donorMsisdn   String
  anonymous     Boolean        @default(false)
  amountKes     Decimal        @db.Decimal(12, 2)
  status        DonationStatus @default(PENDING)
  /// Safaricom's ResultDesc when the STK push didn't succeed — "Request
  /// cancelled by user", "The balance is insufficient", a timeout, etc.
  /// Same precedent as JamiiDomain.failureReason. Shown back to the
  /// donor so a failed push doesn't just spin forever with no
  /// explanation (see DonateModal's polling loop).
  failureReason String?

  mpesaCheckoutRequestId String?       @unique
  mpesaReceiptCode       String?
  /// The ESK-##### code shown to the donor — our own reference,
  /// independent of the M-Pesa receipt.
  receiptCode            String?       @unique
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([campaignId, status])
  @@map("donation")
}

/// A lead, not a Party. Someone tried to register on Our Jamii
/// (apps/jamii) with a phone/email that isn't an existing CECF member's
/// Person record — access is gated to CECF members, so instead of a
/// dead end they can leave their details here. Deliberately its own
/// table rather than a Registration: a Registration implies "this is
/// someone going through the join funnel"; this is "someone was turned
/// away and asked to be followed up with," reviewed by Esoqo staff in
/// the admin app (see App\Support in cecf-wordpress for the analogous
/// non-CECF-member redirect on the WordPress side, and this record's
/// counterpart CTA on /join).
/// An application for Our Jamii access — CONVERTED is what actually
/// grants sign-in (see hasJamiiAccess in dal/jamii-interest.ts), so
/// every first-time Our Jamii sign-in traces back to one of these being
/// approved, whether the applicant was a brand-new person or someone
/// who already had a CECF/Esoqo account.
model JamiiInterest {
  id     String              @id @default(uuid()) @db.Uuid
  status JamiiInterestStatus @default(NEW)

  /// Set at submission time when the identifier they applied with
  /// matched an existing Person, or at approval time when staff approve
  /// a brand-new applicant and a Person gets created for them. Null in
  /// between — a pending brand-new application has no Party yet.
  personId String? @db.Uuid
  person   Party?  @relation(fields: [personId], references: [id])

  fullName         String
  msisdn           String
  email            String? @db.Citext
  county           String?
  /// The group/organisation they named, if any — free text, since by
  /// definition nothing here is linked to a real Party yet.
  organisationName String?
  message          String?

  reviewedByStaffId String?   @db.Uuid
  reviewNote        String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([personId])
  @@map("jamii_interest")
}

enum SupportTicketCategory {
  BUG
  QUESTION
  BILLING
  ACCOUNT
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// "Report an issue" — any signed-in person, anywhere in the product,
/// hitting a problem they can't self-serve past. Deliberately tied to
/// Party (not JamiiPage/Store/etc.) so it isn't jamii-only even though
/// today's only UI for it lives in the Our Jamii dashboard; `pageId` is
/// just the optional "what were you working on" context, same
/// reasoning as JamiiContactMessage's pageId but aimed at Esoqo staff
/// instead of the org's own team.
model SupportTicket {
  id String @id @default(uuid()) @db.Uuid

  reporterPartyId String @db.Uuid
  reporter        Party  @relation(fields: [reporterPartyId], references: [id])

  pageId String?    @db.Uuid
  page   JamiiPage? @relation(fields: [pageId], references: [organisationId], onDelete: SetNull)

  category      SupportTicketCategory @default(OTHER)
  /// Free text when category is OTHER — same "every Other gets a
  /// paired free-text field" rule as Organisation.kindOther.
  categoryOther String?

  subject String
  message String

  status     SupportTicketStatus @default(OPEN)
  staffNote  String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([reporterPartyId])
  @@map("support_ticket")
}

// ═══════════════════════ GROUP TREASURY ═══════════════════════
//
//  See docs/proposals/esoqo-group-treasury-and-payment-id.md for the
//  reasoning behind every shape here. Load-bearing decisions:
//
//  · GroupContribution supports BOTH capture paths — self-declared
//    (officer-confirmed, like RegistrationPayment) and a live M-Pesa
//    STK push (auto-confirmed by the Daraja callback, like StoreOrder)
//    — a group picks per-contribution, not platform-wide.
//  · WithdrawalSignature mirrors PaymentApproval's shape (HMAC
//    signature, one REJECT halts) but signs against a Party, not a
//    StaffUser — a withdrawal signer is a group member, not staff.
//  · GroupTreasuryPolicy.activeHoursStart/End matter: the standby
//    window pauses outside them, so a request raised Saturday night
//    does not quietly expire while every signer is asleep.
//  · The signer set is group-configurable (GroupSigner), not hardcoded
//    to the three officer roles — a group may want an auditor or a
//    fourth signer beyond CHAIRPERSON/TREASURER/SECRETARY.

enum AttendanceMethod {
  SELF_APP
  SELF_USSD
  /// An officer marked on a member's behalf — same trust model as
  /// Registration's AGENT_ASSISTED join path, never anonymous:
  /// AttendanceRecord.markedById always names who did it.
  AGENT_MARKED
}

model Meeting {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @db.Uuid
  org         Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  scheduledAt DateTime
  /// Physical venue, "virtual", or a WhatsApp/call-in description.
  location    String?
  agenda      String?
  /// % of active members needed for this meeting to count as quorate.
  quorumPct   Int          @default(50)
  calledById  String       @db.Uuid
  calledBy    Party        @relation("MeetingCalledBy", fields: [calledById], references: [id])
  createdAt   DateTime     @default(now())
  closedAt    DateTime?

  attendance  AttendanceRecord[]
  withdrawals WithdrawalRequest[]

  @@index([orgId, scheduledAt])
  @@map("meeting")
}

model AttendanceRecord {
  id         String           @id @default(uuid()) @db.Uuid
  meetingId  String           @db.Uuid
  meeting    Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  personId   String           @db.Uuid
  person     Party            @relation("AttendanceParty", fields: [personId], references: [id])
  present    Boolean
  method     AttendanceMethod
  /// Set only when an officer marked on someone's behalf.
  markedById String?          @db.Uuid
  markedBy   Party?           @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  markedAt   DateTime         @default(now())

  @@unique([meetingId, personId])
  @@index([personId])
  @@map("attendance_record")
}

/// One row per group. Created lazily on first configuration — a group
/// with none yet runs on the hardcoded defaults below.
model GroupTreasuryPolicy {
  orgId String       @id @db.Uuid
  org   Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)

  requiredSigners       Int     @default(2)
  /// Minutes of active-hours time a withdrawal must broadcast for
  /// before it can execute. 70 is the product default, not a constant.
  withdrawalLeadMinutes Int     @default(70)
  /// The standby window only counts minutes inside this local-hour
  /// range — it pauses overnight and resumes at activeHoursStart.
  activeHoursStart      Int     @default(7)
  activeHoursEnd        Int     @default(20)
  requireQuorateMeeting Boolean @default(false)

  /// Whether this group runs contributions at all — officers can switch
  /// it off for a group that only ever does one-off collections, without
  /// losing the amount/cycle they'd already set.
  contributionsEnabled  Boolean  @default(true)
  contributionAmountKes Decimal? @db.Decimal(12, 2)
  /// "weekly" | "monthly" | "custom" | null (no fixed cycle).
  contributionCycle     String?

  /// Null or zero = free to join. Otherwise a new member's Membership is
  /// created PENDING and only activates once this amount is paid and
  /// confirmed — see createJoinFeePayment in dal/treasury.ts.
  joinFeeKes Decimal? @db.Decimal(12, 2)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("group_treasury_policy")
}

/// Who may sign a withdrawal for this group — group-configurable, not
/// hardcoded to the three officer roles.
model GroupSigner {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  org       Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  personId  String       @db.Uuid
  person    Party        @relation("GroupSignerParty", fields: [personId], references: [id])
  addedAt   DateTime     @default(now())
  addedById String       @db.Uuid
  /// Soft removal — a past signer's historical signatures stay valid
  /// and attributed; they just stop counting toward new thresholds.
  removedAt DateTime?

  /// Independent toggles, not one fixed "signatory" role — a group can
  /// have a signer who only approves withdrawals and another who also
  /// runs the roster. requestWithdrawal/signWithdrawal still gate on
  /// membership in the effective-signer list (see getEffectiveSignerIds);
  /// approveWithdrawals is what makes that list membership meaningful
  /// once a group has moved off the officer-fallback default.
  approveWithdrawals    Boolean @default(true)
  addMembers            Boolean @default(false)
  removeMembers         Boolean @default(false)
  /// Can add/remove other signers and change their permissions. At
  /// least one active signer per org must hold this — addGroupSigner/
  /// removeGroupSigner/setGroupSignerPermissions all enforce it, so a
  /// group can never end up with nobody able to change who signs.
  manageSignatories     Boolean @default(false)
  editTreasurySettings  Boolean @default(false)
  notifyOnContributions Boolean @default(false)
  notifyOnWithdrawals   Boolean @default(true)

  @@unique([orgId, personId])
  @@index([orgId, removedAt])
  @@map("group_signer")
}

enum SignatoryFeeMethod {
  /// The new signatory pays KES 50 themselves, by M-Pesa STK, before
  /// their signer row activates.
  STK_NEW_SIGNER
  /// The officer adding the signatory pays it personally, by M-Pesa STK.
  STK_OFFICER
  /// Debited immediately from the group's own treasury balance — no
  /// STK, no standby window; a platform service fee, not a withdrawal
  /// a member could object to signing off on.
  GROUP_TREASURY
}

enum SignatoryFeeStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// KES 50, charged for every signatory beyond a group's first 5 free
/// ones (see countActiveSigners/FREE_SIGNER_LIMIT). Real platform
/// revenue — credited to the shared FEE_INCOME account exactly like any
/// other service fee (see _commerce-ledger.ts's findOrCreateAccount
/// pattern), not to the group's own treasury or the new signer's wallet.
/// For STK_* methods the GroupSigner row this fee is for doesn't exist
/// yet when the row is created — pendingPermissions carries what to
/// create once the payment confirms (see confirmSignatoryFeePayment).
model SignatoryFeePayment {
  id String @id @default(uuid()) @db.Uuid

  orgId    String       @db.Uuid
  org      Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  personId String       @db.Uuid
  person   Party        @relation("SignatoryFeePerson", fields: [personId], references: [id])

  addedById String @db.Uuid
  addedBy   Party  @relation("SignatoryFeeAddedBy", fields: [addedById], references: [id])

  method    SignatoryFeeMethod
  amountKes Decimal            @default(50) @db.Decimal(12, 2)
  status    SignatoryFeeStatus @default(PENDING)

  /// The permission toggles to apply to the new GroupSigner row once
  /// this fee confirms — see the GroupSigner model above for the field
  /// list this mirrors.
  pendingPermissions Json

  failureReason          String?
  mpesaCheckoutRequestId String?       @unique
  mpesaReceiptCode       String?
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([orgId, status])
  @@map("signatory_fee_payment")
}

/// A declaration is not money — same rule as RegistrationPayment. Only
/// an officer's confirmation (self-declared path) or Safaricom's own
/// STK callback (direct path) moves this to CONFIRMED and posts it.
model GroupContribution {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @db.Uuid
  org           Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  accountId     String       @db.Uuid
  account       Account      @relation(fields: [accountId], references: [id])
  contributorId String       @db.Uuid
  contributor   Party        @relation("ContributionParty", fields: [contributorId], references: [id])

  amountKes         Decimal        @db.Decimal(12, 2)
  method            PaymentMethod?
  reference         String?
  declaredNote      String?
  status            PaymentStatus  @default(DECLARED)
  declaredAt        DateTime       @default(now())
  confirmedAt       DateTime?
  confirmedById     String?        @db.Uuid
  confirmedBy       Party?         @relation("ContributionConfirmedBy", fields: [confirmedById], references: [id])
  /// Daraja's CheckoutRequestID for the direct-STK path — same
  /// idempotency guard as RegistrationPayment.checkoutRequestId.
  checkoutRequestId String?        @unique
  journalEntryId    String?        @unique @db.Uuid
  journalEntry      JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  /// Set only for a join-fee payment (createJoinFeePayment in
  /// dal/treasury.ts) — confirming this contribution also activates the
  /// PENDING membership it belongs to. Null for an ordinary contribution.
  membershipId      String?        @db.Uuid
  membership        Membership?    @relation("JoinFeeMembership", fields: [membershipId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([contributorId])
  @@map("group_contribution")
}

enum WithdrawalStatus {
  /// Broadcast sent, standby window open, signatures still being collected.
  PENDING_SIGNATURES
  /// Threshold reached once the window closed — waiting on execution.
  APPROVED
  EXECUTED
  /// Any one signer rejected. Halts immediately, does not wait for the window.
  REJECTED
  /// Window closed without reaching threshold. Must be re-raised, no silent retry.
  EXPIRED
}

model WithdrawalRequest {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  org       Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  accountId String       @db.Uuid
  account   Account      @relation(fields: [accountId], references: [id])
  meetingId String?      @db.Uuid
  meeting   Meeting?     @relation(fields: [meetingId], references: [id])

  requestedById String @db.Uuid
  requestedBy   Party  @relation("WithdrawalRequestedBy", fields: [requestedById], references: [id])

  amountKes   Decimal @db.Decimal(12, 2)
  purpose     String
  payeeName   String
  payeeMsisdn String?

  /// Snapshotted from GroupTreasuryPolicy at request time — a later
  /// policy change never reaches back into an in-flight request.
  requiredSigners Int
  broadcastAt     DateTime         @default(now())
  /// Computed from policy.withdrawalLeadMinutes, walked forward through
  /// activeHours — see computeStandbyOpensAt in dal/treasury.ts.
  standbyOpensAt  DateTime
  status          WithdrawalStatus @default(PENDING_SIGNATURES)
  decidedAt       DateTime?

  journalEntryId String?       @unique @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  signatures WithdrawalSignature[]

  @@index([orgId, status])
  @@index([standbyOpensAt])
  @@map("withdrawal_request")
}

enum ProposalKind {
  ADD_MEMBER
  REMOVE_MEMBER
}

enum ProposalStatus {
  OPEN
  PASSED
  REJECTED
}

/// A decision put to the group's signatories rather than taken by one
/// officer — "vote on proposed decisions eg add/remove a member". Scoped
/// to membership changes for now (the two kinds requested); withdrawal
/// already has its own multisig flow via WithdrawalRequest and isn't
/// duplicated here.
model GroupProposal {
  id    String       @id @default(uuid()) @db.Uuid
  orgId String       @db.Uuid
  org   Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  kind  ProposalKind

  /// REMOVE_MEMBER: the member being voted out. ADD_MEMBER: null until
  /// the person exists on Esoqo — see targetMsisdn/targetName.
  targetPersonId String? @db.Uuid
  targetPerson   Party?  @relation("ProposalTarget", fields: [targetPersonId], references: [id])
  /// ADD_MEMBER only — who's being proposed, before they're a Party.
  targetMsisdn   String?
  targetName     String?

  proposedById String @db.Uuid
  proposedBy   Party  @relation("ProposalProposedBy", fields: [proposedById], references: [id])

  /// Snapshotted at creation, same reason WithdrawalRequest snapshots
  /// requiredSigners — a later policy change shouldn't reach back into
  /// a vote already in progress.
  requiredApprovals Int
  status            ProposalStatus @default(OPEN)
  createdAt         DateTime       @default(now())
  decidedAt         DateTime?

  votes GroupProposalVote[]

  @@index([orgId, status])
  @@map("group_proposal")
}

model GroupProposalVote {
  id         String           @id @default(uuid()) @db.Uuid
  proposalId String           @db.Uuid
  proposal   GroupProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  voterId    String           @db.Uuid
  voter      Party            @relation("ProposalVoter", fields: [voterId], references: [id])
  decision   ApprovalDecision
  votedAt    DateTime         @default(now())

  @@unique([proposalId, voterId])
  @@map("group_proposal_vote")
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

enum ProjectContributionStatus {
  DECLARED
  CONFIRMED
}

enum ProjectWithdrawalStatus {
  PENDING_SIGNATURES
  EXECUTED
  REJECTED
}

/// A named funding kitty inside a group — "Grace funeral", "Midai
/// wedding" — with its own target, its own contributors, and its own
/// signatories, distinct from the group's everyday treasury signers.
/// Real cash still lives in the group's one GROUP_SAVINGS account (see
/// dal/treasury.ts's findOrCreateGroupSavingsAccount) — a project is an
/// earmark on that same pool, not a second bank account, the same
/// relationship BillContribution has to BILL_FUNDING. "Raised" is
/// always derived from confirmed GroupProjectContribution rows, never
/// stored.
model GroupProject {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @db.Uuid
  org       Organisation  @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  title     String
  purpose   String?
  targetKes Decimal?      @db.Decimal(12, 2)
  status    ProjectStatus @default(ACTIVE)

  createdById String   @db.Uuid
  createdBy   Party    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  /// Snapshotted at project creation, same reason WithdrawalRequest and
  /// GroupProposal each snapshot their own threshold.
  requiredApprovals Int @default(1)

  signers       GroupProjectSigner[]
  contributions GroupProjectContribution[]
  withdrawals   GroupProjectWithdrawal[]

  @@index([orgId, status])
  @@map("group_project")
}

/// Who can approve a withdrawal from this one project's kitty — separate
/// from the group's own GroupSigner list, so a funeral kitty can be
/// signed off by the bereaved family's chosen people even if none of
/// them sit on the group's main treasury signer list.
model GroupProjectSigner {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  project   GroupProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId  String       @db.Uuid
  person    Party        @relation("ProjectSignerParty", fields: [personId], references: [id])
  addedAt   DateTime     @default(now())
  removedAt DateTime?

  @@unique([projectId, personId])
  @@map("group_project_signer")
}

/// A declaration is not money — same rule as GroupContribution. Only
/// confirmation posts the JournalEntry crediting the group's own
/// GROUP_SAVINGS account; "raised" is the sum of CONFIRMED rows.
model GroupProjectContribution {
  id            String                    @id @default(uuid()) @db.Uuid
  projectId     String                    @db.Uuid
  project       GroupProject              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contributorId String                    @db.Uuid
  contributor   Party                     @relation("ProjectContributionParty", fields: [contributorId], references: [id])
  amountKes     Decimal                   @db.Decimal(12, 2)
  status        ProjectContributionStatus @default(DECLARED)
  reference     String?

  declaredAt    DateTime  @default(now())
  confirmedAt   DateTime?
  confirmedById String?   @db.Uuid
  confirmedBy   Party?    @relation("ProjectContributionConfirmedBy", fields: [confirmedById], references: [id])

  journalEntryId String?       @unique @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([projectId, status])
  @@map("group_project_contribution")
}

/// A withdrawal from one project's kitty — voted on by GroupProjectSigner
/// rows (falling back to the project's creator alone if none are
/// configured), not the group's own GroupSigner list. Deliberately
/// simpler than WithdrawalRequest's broadcast/standby-window ceremony —
/// a kitty this scoped doesn't carry the same cooling-off requirement
/// the whole group's treasury does; it settles the moment enough of its
/// own signers approve, the same instant-tally shape GroupProposal uses.
model GroupProjectWithdrawal {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  project   GroupProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  requestedById String @db.Uuid
  requestedBy   Party  @relation("ProjectWithdrawalRequestedBy", fields: [requestedById], references: [id])

  amountKes Decimal @db.Decimal(12, 2)
  purpose   String
  payeeName String

  requiredApprovals Int
  status            ProjectWithdrawalStatus @default(PENDING_SIGNATURES)
  createdAt         DateTime                @default(now())
  decidedAt         DateTime?

  journalEntryId String?       @unique @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  votes GroupProjectWithdrawalVote[]

  @@index([projectId, status])
  @@map("group_project_withdrawal")
}

model GroupProjectWithdrawalVote {
  id           String                 @id @default(uuid()) @db.Uuid
  withdrawalId String                 @db.Uuid
  withdrawal   GroupProjectWithdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  voterId      String                 @db.Uuid
  voter        Party                  @relation("ProjectWithdrawalVoter", fields: [voterId], references: [id])
  decision     ApprovalDecision
  votedAt      DateTime               @default(now())

  @@unique([withdrawalId, voterId])
  @@map("group_project_withdrawal_vote")
}

enum GroupActivityKind {
  MEMBER_JOINED
  MEMBER_REMOVED
  CONTRIBUTION_CONFIRMED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_SIGNED
  WITHDRAWAL_EXECUTED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_EXPIRED
}

/// A group's activity feed — "in-app to all" half of every notification
/// this schema sends by SMS to a narrower audience (signers, officers).
/// SMS costs money per recipient; a feed row costs nothing and reaches
/// everyone who opens the group, which is why "notify everyone" here
/// means "write one row", not "text everyone". Read-only from the app's
/// perspective: nothing ever updates a row once written, so there is no
/// read/unread state to reconcile — see the backlog item this doubles as
/// ("a group activity feed, not a members list and a ledger as two
/// separate pages").
model GroupActivityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  orgId     String            @db.Uuid
  org       Organisation      @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  kind      GroupActivityKind
  /// Who caused it — null for system-driven events (an expired
  /// withdrawal, nobody "did" that).
  actorId   String?           @db.Uuid
  actor     Party?            @relation("GroupActivityActor", fields: [actorId], references: [id])
  /// Precomputed, human-readable, e.g. "Amina requested KES 5,000 for
  /// fertiliser". Rendered as-is — no template lookup at read time, so
  /// a copy change later doesn't rewrite history.
  summary   String
  createdAt DateTime          @default(now())

  @@index([orgId, createdAt])
  @@map("group_activity_event")
}

/// One signer's decision. Deliberately mirrors PaymentApproval rather
/// than reusing it — PaymentApproval.approverId is FK'd to StaffUser
/// (an internal reviewer); this signs against a Party (a group member).
model WithdrawalSignature {
  id            String            @id @default(uuid()) @db.Uuid
  withdrawalId  String            @db.Uuid
  withdrawal    WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  signerId      String            @db.Uuid
  signer        Party             @relation("WithdrawalSignerParty", fields: [signerId], references: [id])
  decision      ApprovalDecision
  /// The signer's PIN was freshly verified at this instant — never
  /// queued or replayed, see ADR note in the treasury proposal doc.
  pinVerifiedAt DateTime
  /// HMAC-SHA256(withdrawalId|signerId|decision|signedAt, SESSION_SECRET)
  signature     String
  signedAt      DateTime
  ip            String?

  @@unique([withdrawalId, signerId])
  @@index([withdrawalId])
  @@map("withdrawal_signature")
}

// ─────────────────────── ESOQO PAYMENT ID ────────────────────────

/// A short, verified, portable payment handle — issued once a Party
/// holds at least MSISDN_VERIFIED (see Attestation), reusing the
/// existing trust primitive rather than inventing a new one.
/// Where an EsoqoPaymentId's code came from. SYSTEM_GENERATED is the free
/// default everyone gets; the PREMIUM_* values are bought handles (see
/// EsoqoIdPurchase) and carry a premiumExpiresAt.
enum EsoqoIdSource {
  SYSTEM_GENERATED
  PREMIUM_FULL_NAME
  PREMIUM_CUSTOM
  PREMIUM_PHONE
  PREMIUM_EMAIL
}

model EsoqoPaymentId {
  partyId          String        @id @db.Uuid
  party            Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// Either the legacy "ESK-4471-KE" shape (still minted nowhere, but
  /// still resolvable — see pay-code.ts) or the newer human-friendly
  /// handle shape from handle-code.ts, e.g. "mutukuka482".
  code             String        @unique
  /// SYSTEM_GENERATED handles never expire; premium ones do, and are
  /// checked lazily on read (see isHandleExpired) rather than on a
  /// schedule — nothing in this codebase runs on a cron.
  source           EsoqoIdSource @default(SYSTEM_GENERATED)
  premiumExpiresAt DateTime?
  activatedAt      DateTime      @default(now())
  suspendedAt      DateTime?

  purchases EsoqoIdPurchase[]

  @@index([code])
  @@map("esoko_payment_id")
}

enum EsoqoIdPurchaseKind {
  FULL_NAME
  CUSTOM_DIGITS
  PHONE
  EMAIL
  RENEWAL
}

enum EsoqoIdPurchaseStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// A person buying a nicer esoqo ID than the free system-generated one —
/// their full name, a custom digit string, their phone number, or their
/// email, each sold annually. Real platform revenue, same shape and same
/// FEE_INCOME posting as SignatoryFeePayment above, not pass-through.
///
/// Gated behind the ESOQO_ID_PREMIUM_ENABLED flag until pricing per kind
/// is decided — this model and its allocator exist so Phase 3 work isn't
/// blocked on that decision, not because the purchase flow is live.
model EsoqoIdPurchase {
  id String @id @default(uuid()) @db.Uuid

  partyId        String         @db.Uuid
  party          Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)
  esoqoId        String         @db.Uuid
  esoqoPaymentId EsoqoPaymentId @relation(fields: [esoqoId], references: [partyId], onDelete: Cascade)

  kind            EsoqoIdPurchaseKind
  /// What they're asking to reserve — the literal handle string, e.g.
  /// their full name lowercased, or the custom digits they chose.
  requestedHandle String
  amountKes       Decimal               @db.Decimal(12, 2)
  status          EsoqoIdPurchaseStatus @default(PENDING)

  failureReason          String?
  mpesaCheckoutRequestId String?       @unique
  mpesaReceiptCode       String?
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  /// One year from confirmedAt. Checked lazily wherever the handle is
  /// read (see isHandleExpired) — nothing here runs on a schedule.
  expiresAt   DateTime?

  @@index([partyId, status])
  @@map("esoqo_id_purchase")
}

enum BusinessPaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// A payment from anybody to a business, made through the public /pay
/// page: the business owner enters their Esoqo business ID (the
/// EsoqoPaymentId above), the printed QR encodes a pay link, and whoever
/// scans it chooses the amount and pays from their own phone.
///
/// Why this is its own table rather than a Donation or a StoreOrder:
/// neither has a payee. A Donation has a campaign, a StoreOrder has a
/// store with its own revenue split and delivery flow. This has one
/// thing — money arriving at a named business — and it needs none of
/// the order, delivery or campaign machinery. It is also the only one
/// of the three where the *payer* is usually anonymous and the *payee*
/// is the customer: the person standing at a QR is the one with no
/// account.
model BusinessPayment {
  id String @id @default(uuid()) @db.Uuid

  /// The business being paid — the ORGANISATION Party whose
  /// EsoqoPaymentId was on the QR. A payment can only ever point at a
  /// party that actually has an issued, unsuspended ID; there is no
  /// "unverified payee" state here, because the lookup that produced
  /// this id already refused those (see findPayableBusiness).
  payeePartyId String @db.Uuid
  payeeParty   Party  @relation("BusinessPaymentPayee", fields: [payeePartyId], references: [id])
  /// Snapshot of the ESK-…-KE code and the name as they read at the
  /// moment of payment. A receipt must keep saying what it said when it
  /// was issued even if the business is later renamed, suspended, or
  /// erased — same reason Donation stores donorName.
  payeeEsoqoId String
  payeeName    String

  /// The payer's number in E.164. Required, not optional: an STK push
  /// cannot reach anyone without one, and a payment nobody can be
  /// receipted is a payment nobody can chase.
  payerMsisdn  String
  payerName    String?
  /// The payer's own Esoqo Payment ID, when they had one to hand. Purely
  /// for their receipt ("paid as ESK-…") — never a lookup key, and never
  /// required.
  payerEsoqoId String?

  amountKes Decimal @db.Decimal(12, 2)
  /// Free text the payer typed on the payment page. Clamped at the
  /// boundary; a note is a courtesy to the business, not a field with
  /// rules.
  note      String?

  status        BusinessPaymentStatus @default(PENDING)
  /// Safaricom's ResultDesc when the STK push didn't succeed — "Request
  /// cancelled by user", "The balance is insufficient", a timeout, etc.
  /// Shown back to the payer so a failed payment doesn't just spin
  /// forever with no explanation (same precedent as Donation).
  failureReason String?

  mpesaCheckoutRequestId String?       @unique
  mpesaReceiptCode       String?
  /// Esoqo's own reference for this payment, e.g. "BP-7K3H92XQ" — what
  /// the payer and the business quote to each other, and what appears in
  /// both SMS messages. Deliberately distinct from mpesaReceiptCode:
  /// Safaricom's number is not ours to hand out, and a payer needs one
  /// reference we can look up in a week.
  receiptCode            String?       @unique
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])

  /// Set when this payment settles a parking session, and only then.
  /// A parking charge is an ordinary payment to an ordinary payee — same
  /// STK push, same Safaricom callback, same balanced entry against the
  /// lot operator's revenue account — so it is deliberately NOT a second
  /// payment pipeline. The only thing that makes it a parking payment is
  /// that the payer was quoted a figure by a machine and expects that
  /// exact figure, which is what this link lets the session check.
  parkingSessionId String?         @unique @db.Uuid
  parkingSession   ParkingSession? @relation(fields: [parkingSessionId], references: [id])

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([payeePartyId, status])
  @@index([status, createdAt])
  @@map("business_payment")
}

enum WalletTopUpStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// Cash a person adds to their own personal WALLET Account (see
/// AccountKind.WALLET) via M-Pesa STK push. Same shape as
/// BusinessPayment on purpose — write-then-push-then-confirm, one
/// balanced JournalEntry per confirmation, confirmed exactly once by
/// mpesaCheckoutRequestId — this is a payment into an account the
/// person themselves owns rather than a business's, nothing else about
/// the settlement mechanics differs.
model WalletTopUp {
  id String @id @default(uuid()) @db.Uuid

  partyId String @db.Uuid
  party   Party  @relation("WalletTopUpParty", fields: [partyId], references: [id])

  /// E.164 — required for the same reason BusinessPayment.payerMsisdn
  /// is: an STK push cannot reach anyone without one.
  msisdn    String
  amountKes Decimal @db.Decimal(12, 2)

  status        WalletTopUpStatus @default(PENDING)
  failureReason String?

  mpesaCheckoutRequestId String?       @unique
  mpesaReceiptCode       String?
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([partyId, status])
  @@index([status, createdAt])
  @@map("wallet_top_up")
}

enum ParkingSessionStatus {
  /// Parked. No money has been quoted, because the stay has not ended.
  OPEN
  /// Checked out and quoted. The amount is fixed, and a payment is
  /// expected — or, if the driver walks away, never arrives.
  QUOTED
  /// Settled. Reached only by a confirmed BusinessPayment, never set
  /// directly, so a session cannot claim to be paid without the ledger
  /// having been written.
  PAID
  /// Voided by the lot — a blocked bay, a tow, a mis-keyed check-in.
  /// Keeps the row, because "why does this ticket not work" needs an
  /// answer.
  VOIDED
}

/// A car park, and the QR printed at its entrance.
///
/// A lot is not a payee. It is a *place* that belongs to a payee: the
/// operating company's Organisation Party, which already carries the
/// Esoqo Payment ID and the revenue account. That is the whole reason a
/// parking charge needs no new account kind and no new money path — it
/// is a BusinessPayment whose payee happens to be a car park's owner.
model ParkingLot {
  id String @id @default(uuid()) @db.Uuid

  /// The ORGANISATION Party that runs this lot and receives the fees.
  /// Paid parties only: a lot whose operator has no live Esoqo Payment
  /// ID cannot take money, and `payablePartyId` in the DAL refuses it at
  /// check-in rather than quoting a rate nobody can pay.
  partyId String @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id])

  /// Short code the printed QR encodes, e.g. "PRK-4KX9-2J". Minted from
  /// the same unambiguous alphabet as every other human-typable code in
  /// the product, because this one is read aloud at an entrance by
  /// somebody standing in the rain.
  code    String  @unique
  name    String
  county  String?
  address String?

  /// Charge per commenced hour, whole shillings. Snapshotted onto each
  /// session at check-in, so raising the tariff never retroactively
  /// changes what somebody already parked under.
  ratePerHourKes Int
  /// Free minutes before charging starts. Almost every Kenyan car park
  /// has one, and making the driver guess it would be a support line.
  graceMinutes   Int     @default(0)
  /// Ceiling for one stay. A driver who leaves their car overnight
  /// should not discover the multiplication on checkout.
  maxPerDayKes   Int?
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions ParkingSession[]

  @@index([partyId])
  @@index([active])
  @@map("parking_lot")
}

/// One vehicle's stay: checked in at an entrance, quoted at checkout.
///
/// Deliberately never holds money. The amount lives on the
/// BusinessPayment that settles it, which is what makes "a session says
/// PAID" and "the ledger has the entry" the same statement rather than
/// two that can disagree.
model ParkingSession {
  id    String     @id @default(uuid()) @db.Uuid
  lotId String     @db.Uuid
  lot   ParkingLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  /// The code texted to the driver at check-in, e.g. "PRT-7QW2-4X", and
  /// the only thing they need at checkout. Uniqueness is enforced by
  /// the database, and every mint retries on collision.
  ticketCode String  @unique
  /// Optional. Typed by the attendant or the driver; never required,
  /// because not everyone in a car park knows or wants to give their
  /// plate to a stranger's phone camera.
  plateNo    String?
  /// E.164. Required for the same reason BusinessPayment.payerMsisdn is:
  /// the ticket goes here and the STK push has nowhere else to go.
  msisdn     String

  status ParkingSessionStatus @default(OPEN)

  checkedInAt    DateTime  @default(now())
  checkedOutAt   DateTime?
  /// Set when checkout produced a figure, i.e. when status became
  /// QUOTED. Null before then — an unquoted stay has no amount, and
  /// inventing one early is how a disputed exit gets started.
  quotedAt       DateTime?
  /// Rate as it stood at check-in, for the same reason the lot's own
  /// rate is never edited mid-stay.
  ratePerHourKes Int
  graceMinutes   Int       @default(0)
  maxPerDayKes   Int?
  /// Commenced hours actually charged, and the total. Both null while
  /// the session is OPEN.
  billedMinutes  Int?
  amountKes      Decimal?  @db.Decimal(12, 2)

  /// The settling payment. One-to-one, and nullable: a QUOTED session
  /// with no payment is a driver who did not pay, which is a real state
  /// the lot has to be able to see.
  payment BusinessPayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lotId, status])
  @@index([lotId, checkedInAt])
  @@index([msisdn, status])
  @@map("parking_session")
}

/// A SNAPSHOT, not a live score — same reasoning as balances being
/// derived, not stored: recomputing fresh each time it's needed is
/// what keeps it honest. This row records "what was disclosed, when,
/// under what formula version," not a cache.
///
/// v1 inputs are strictly limited to events this schema already
/// produces — GroupContribution (consistency), AttendanceRecord
/// (reliability), WithdrawalSignature (responsiveness/reject-rate).
/// Loan-repayment behaviour is a deliberate v2 addition, once an
/// internal-lending feature actually produces a repayment/default
/// event to score against.
model GroupCreditInsightSnapshot {
  id                          String   @id @default(uuid()) @db.Uuid
  partyId                     String   @db.Uuid
  party                       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  formulaVersion              String
  contributionScore           Int
  attendanceScore             Int
  signatureScore              Int
  computedAt                  DateTime @default(now())
  /// Set only when this snapshot was generated to satisfy a specific
  /// ConsentAccess — most snapshots are member-facing only.
  disclosedViaConsentAccessId String?  @db.Uuid

  @@index([partyId, computedAt])
  @@map("group_credit_insight_snapshot")
}

// ─────────────────────────────── BILLS ───────────────────────────

/// A personal recurring/one-off bill a Person tracks — KPLC, water,
/// DSTV, rent, school fees. Esoqo has no Safaricom B2B relationship to
/// actually pay a third-party biller (only STK push into Esoqo's own
/// till), so this is deliberately track-and-remind only: nothing here
/// moves money. See BillPayment's own comment for the "mark as paid"
/// half of that contract.
model Bill {
  id      String @id @default(uuid()) @db.Uuid
  partyId String @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  /// "KPLC — home", "DSTV" — whatever the person calls it themselves.
  label              String
  /// ELECTRICITY | WATER | PAY_TV | RENT | SCHOOL_FEES | INTERNET |
  /// OTHER. Plain string, not an enum — same reasoning as Product's own
  /// category: a new bill type should never need a migration.
  category           String
  /// Meter/account/paybill number, free text — shown back to the person
  /// so they can find it when they go to actually pay elsewhere.
  accountRef         String?
  /// Null when the amount varies bill to bill (e.g. an electricity
  /// token top-up) — the person just gets reminded, not shown a number
  /// that would usually be wrong.
  amountKes          Decimal? @db.Decimal(12, 2)
  /// MONTHLY | WEEKLY | ONE_TIME.
  cycle              String
  nextDueAt          DateTime
  /// How many days ahead of nextDueAt this shows as "due soon" rather
  /// than just "upcoming" — an in-app indicator only; there is no
  /// push-notification wiring in this app yet, so this is never a
  /// promise of an alert arriving anywhere.
  reminderDaysBefore Int      @default(3)
  /// ACTIVE | PAUSED | ARCHIVED. ARCHIVED is a soft delete — same
  /// discipline as everywhere else in this schema that keeps history.
  status             String   @default("ACTIVE")

  /// Null means this bill doesn't accept funding at all — targetKes is
  /// what turns on the "gamified" half (a shareable progress bar,
  /// family/friends chipping in). Unlike amountKes above (a plain
  /// reminder number), a target being met is what BillContribution
  /// rows accumulate toward.
  targetKes      Decimal? @db.Decimal(12, 2)
  /// Once contributions (since the last payment) reach targetKes, the
  /// bill is auto-marked paid the same way a manual "mark paid" tap
  /// already works — see dbx.ContributeToBill. Off by default: a
  /// target with auto-pay off is progress-tracking only, the owner
  /// still taps "mark paid" themselves.
  autoPayEnabled Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments      BillPayment[]
  contributions BillContribution[]

  @@index([partyId, status])
  @@map("bill")
}

enum BillContributionStatus {
  PENDING
  PAID
}

/// A named person's chip-in toward a bill's targetKes — the same
/// "who put in what, when" discipline as GroupContribution/Posting,
/// never a running total anyone can edit in place (see this app's own
/// security posture on cash-handling flows). Unlike BillPayment (a
/// self-reported "I paid this" log that moves no real money — see
/// that model's own comment), a BillContribution is real money: it
/// settles through the ledger exactly like a StoreOrder or
/// GroupContribution, via M-Pesa STK. contributorPartyId is null for
/// a guest contributor (a friend/family member without an Esoqo
/// account) — contributorName is always captured directly since the
/// contribution card shows who gave what.
model BillContribution {
  id                     String                 @id @default(uuid()) @db.Uuid
  billId                 String                 @db.Uuid
  bill                   Bill                   @relation(fields: [billId], references: [id], onDelete: Cascade)
  contributorPartyId     String?                @db.Uuid
  contributorName        String
  amountKes              Decimal                @db.Decimal(12, 2)
  status                 BillContributionStatus @default(PENDING)
  mpesaCheckoutRequestId String?                @unique
  /// @unique + a real FK, matching every other money model in this
  /// schema (StoreOrder, GroupContribution, Donation, Booking,
  /// FarePayment…). Without the uniqueness this column could point two
  /// contributions at one journal entry — i.e. book the same money
  /// twice — and without the FK it could reference an entry that does
  /// not exist at all.
  journalEntryId         String?                @unique @db.Uuid
  journalEntry           JournalEntry?          @relation(fields: [journalEntryId], references: [id])
  createdAt              DateTime               @default(now())

  @@index([billId, status])
  @@map("bill_contribution")
}

/// A self-reported "I paid this" log entry — never a real money
/// movement (no JournalEntry/Posting here, unlike every other payment
/// model in this schema), because Esoqo genuinely doesn't move this
/// money. Recording it is what lets nextDueAt advance for a recurring
/// bill and gives the person their own payment history.
model BillPayment {
  id        String   @id @default(uuid()) @db.Uuid
  billId    String   @db.Uuid
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  amountKes Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now())
  note      String?

  @@index([billId, paidAt])
  @@map("bill_payment")
}

// ─────────────────────────── PARCELS ─────────────────────────────
// A physical object's custody chain: who booked it, who's holding it
// right now, and the append-only log of every hand-off in between.
// Now priced (see ParcelPricingRule) and payable in-app — a booking
// starts as DRAFT_PENDING_PAYMENT and only becomes real (BOOKED) once
// paidAt is set, same "don't count it until it's paid" rule
// StoreOrder's PENDING_PAYMENT status already follows.

enum ParcelStatus {
  DRAFT_PENDING_PAYMENT
  REJECTED_AT_DROPOFF
  BOOKED
  /// The box is physically at a counter/station, confirmed received by a
  /// clerk or courier-company front desk, but no rider has taken it for
  /// delivery yet. Distinct from PICKED_UP so a walk-in drop-off reads
  /// honestly on the tracker ("received at counter") instead of claiming
  /// a courier is already on the way, and so a station-held parcel can
  /// still be claimed as a dispatch job. Set by dbx.ScanHandoff's first
  /// scan when the origin is SELF_DROPOFF, or by an Esoqo staff counter
  /// confirmation (a session with no linked Party — the historical gap
  /// that left counter bookings stuck at AWAITING_INTAKE forever).
  RECEIVED_AT_COUNTER
  PICKED_UP
  IN_TRANSIT
  /// A courier reached the door and could not hand the parcel over —
  /// nobody home, wrong address, receiver refused, no delivery code.
  /// Deliberately NOT terminal and deliberately NOT a form of
  /// cancellation: the courier still physically holds the parcel
  /// (currentHolderPartyId is untouched), so the next real event is
  /// another attempt (→ IN_TRANSIT), a drop at a pickup point (→
  /// HELD_AT_AGENT) or giving up (→ RETURNED_TO_SENDER). Before this
  /// status existed a failed attempt had no representation at all: the
  /// courier just kept holding it and the parcel silently aged past
  /// slaDeadlineAt, reading as a courier failure in the admin's
  /// overdueDeliveries KPI when it was usually a receiver-side problem.
  /// See dbx.RecordDeliveryAttempt.
  FAILED_DELIVERY
  /// Sitting at a pickup point waiting for the receiver to collect it —
  /// the agent-network leg (see ParcelAgent). Custody is the agent's,
  /// same currentHolderPartyId mechanism every other leg uses, so a
  /// parcel on a shelf is never "in transit with nobody".
  HELD_AT_AGENT
  DELIVERED
  /// The give-up path out of FAILED_DELIVERY/HELD_AT_AGENT — the parcel
  /// physically goes back the way it came. Terminal, and distinct from
  /// CANCELLED: the journey happened and was billed, it just ended at
  /// the origin instead of the destination.
  RETURNED_TO_SENDER
  /// Set only by an admin (see dbx.CancelParcel) — a draft abandoned
  /// before payment, or a paid-but-not-yet-picked-up parcel the sender
  /// asked to stop. Never reachable once a courier has scanned it into
  /// custody (PICKED_UP or later) — physically already in motion.
  CANCELLED
}

enum ParcelType {
  ENVELOPE_DOCUMENT
  SMALL
  MEDIUM
  LARGE
  HEAVY_OVERSIZE
}

/// See Parcel.originMethod's own comment.
enum ParcelOriginMethod {
  SCHEDULED_PICKUP
  SELF_DROPOFF
}

enum ParcelTransportMode {
  BODA
  TUKTUK
  VAN
  TRUCK
  /// Added for ParcelCourier.vehicleType reuse (see that model's own
  /// comment) — a courier's actual vehicle, not just a dispatch
  /// suggestion, so the enum needed the two modes a pricing bracket
  /// never suggested but a real courier still rides.
  BICYCLE
  ON_FOOT
}

/// PENDING_VETTING → ACTIVE is a staff decision (see
/// dbx.SetCourierStatus) — no document/KYC pipeline exists yet (see the
/// plan's explicit deferral), so vetting today is a manual staff call,
/// not an automated check. SUSPENDED/REJECTED are both staff-only
/// terminal-ish states; SUSPENDED can be reinstated back to ACTIVE,
/// REJECTED cannot (that person books elsewhere).
enum ParcelCourierStatus {
  PENDING_VETTING
  ACTIVE
  SUSPENDED
  REJECTED
}

model Parcel {
  id           String @id @default(uuid()) @db.Uuid
  /// PKG-… — the tracking code, scanned or typed by anyone (see
  /// dbx.GetParcelStatus's guest-safe projection). The bearer
  /// credential for "check this parcel's status", same convention a
  /// pickup code already follows.
  code         String @unique
  /// A second, separate code — only ever shown to the sender, only
  /// ever typed by the receiver at final handoff (see
  /// dbx.DeliverParcel). Proof of receipt, same "a code the last
  /// person types in" shape a pickup code closes a retail order with.
  deliveryCode String

  /// The parcel's number in whatever system its owner used before Esoqo
  /// — a courier company importing parcels it already tracks elsewhere
  /// types its own id here and keeps using it. Distinct from `code`
  /// (Esoqo's tracking credential) on purpose: a tenant-supplied value
  /// can't be allowed to collide with, or impersonate, another tenant's
  /// tracking code. Searched within the owning company's console
  /// (`?q=`), never a public bearer credential.
  externalRef    String?
  /// Which outside system externalRef came from ("Wialli", "Safi",
  /// "Spreadsheet"), so two companies' imports stay legible and a
  /// future integration has somewhere to hang. Free text.
  externalSource String?

  /// TCK-… — what a self-service booking actually gets back, not
  /// `code`. A sender who typed their own parcel details in hasn't
  /// proven anyone has the box in hand yet (see BookParcel's own
  /// comment on why booking never sends an SMS on its own); handing
  /// them the real tracking code at that moment would let them relay
  /// or publish a code for a parcel nobody has actually received.
  /// This is the number they show at the counter instead — a bearer
  /// credential scoped to "prove you're the one who booked this," not
  /// "track this parcel" (see handleGetParcelStatus's own pre-intake
  /// lookup). Once intakeConfirmedAt is set, the SMS pair fires and
  /// this number is retired from active use — `code` takes over.
  serviceTicketNumber String @unique

  /// Null for a guest booking — senderName/senderMsisdn are always
  /// captured directly regardless, same "guest OR authenticated"
  /// pattern CreateStoreOrder already follows.
  senderPartyId    String? @db.Uuid
  senderName       String
  senderMsisdn     String
  receiverName     String
  receiverMsisdn   String
  /// Free text, always kept — a human-readable description ("Westlands,
  /// opposite Sarit") is what a courier actually reads. originZoneId/
  /// destinationZoneId below are the pricing/dispatch signal now that
  /// ParcelZone exists; both are optional and independent of this text
  /// so an older client (or a sender who skips zone selection) still
  /// books fine, just without distance-aware pricing or a map pin.
  originLabel      String
  destinationLabel String
  notes            String?

  /// Optional — drives distance-based pricing (see dbx.SetParcelPrice)
  /// and the live dispatch map. Null on any booking that didn't pick a
  /// zone, which degrades gracefully to the flat weight-bracket price.
  originZoneId      String? @db.Uuid
  destinationZoneId String? @db.Uuid

  /// An actual dropped pin for each end, when the sender gave one.
  ///
  /// Roughly four in five Kenyans have no formal street address, and
  /// addressing failure is the single largest cause of delivery failure
  /// in this market — the industry association's own figures put wrong
  /// or missing addresses behind the bulk of both undelivered and
  /// delayed parcels. `originLabel`/`destinationLabel` are prose a
  /// human reads ("opposite Sarit"); these are what a courier's maps
  /// app can actually navigate to.
  ///
  /// Deliberately independent of the zone columns above, which are a
  /// *pricing* coordinate snapped to an admin-curated hub. A pin is
  /// where the parcel is really going, to seven decimal places. A
  /// booking may have both, either, or neither, and the degradation is
  /// honest all the way down: pin, then zone, then free text.
  originLat      Decimal? @db.Decimal(10, 7)
  originLng      Decimal? @db.Decimal(10, 7)
  destinationLat Decimal? @db.Decimal(10, 7)
  destinationLng Decimal? @db.Decimal(10, 7)

  /// Computed once, the moment the parcel becomes BOOKED, from the
  /// matched ParcelPricingRule.slaHours — a promise made at payment
  /// time, never silently redefined by a later admin rate-card edit
  /// (same "copy it in, don't leave it derived" reasoning transportMode
  /// above already follows). Null for a parcel type with no SLA
  /// configured yet.
  slaDeadlineAt DateTime?

  /// A staff member flagging a parcel that's stuck or otherwise needs
  /// attention mid-transit — see dbx.FlagParcelException. Distinct from
  /// cancellation: an exception doesn't stop the parcel, it's a "keep
  /// an eye on this one" note.
  exceptionNote             String?
  exceptionFlaggedAt        DateTime?
  exceptionFlaggedByStaffId String?   @db.Uuid

  /// Drives the ParcelPricingRule lookup at booking time — the size/
  /// weight bracket the sender declares, not a courier's later guess.
  parcelType              ParcelType
  weightKg                Decimal?   @db.Decimal(6, 2)
  fragile                 Boolean    @default(false)
  itemCategory            String?
  itemDescription         String?
  perishable              Boolean    @default(false)
  perishableHandling      String?
  expiryAt                DateTime?
  intakeCondition         String?
  intakeAcceptedByStaffId String?    @db.Uuid
  intakeRejectedAt        DateTime?
  intakeRejectionReason   String?

  /// Measured at intake, for the volumetric weight a bulky parcel is
  /// charged on — (L × W × H) / divisor, see dbx.VolumetricKg. All
  /// three or none: two dimensions is not a volume, and guessing the
  /// third would attach a customer's money to a number nobody
  /// recorded.
  lengthCm Decimal? @db.Decimal(6, 1)
  widthCm  Decimal? @db.Decimal(6, 1)
  heightCm Decimal? @db.Decimal(6, 1)

  /// The sender was asked about prohibited contents and said no.
  /// A timestamp and a person rather than a boolean on purpose: six
  /// weeks later "was this declared" is nearly useless next to "who
  /// asked, and when".
  contentsDeclaredAt        DateTime?
  contentsDeclaredByStaffId String?   @db.Uuid

  /// What the SENDER themselves asserted at booking — deliberately not
  /// the contentsDeclaredAt pair above, which means something stronger
  /// and narrower: "a named member of staff asked this person about
  /// prohibited items, face to face". A self-service booking can never
  /// produce that fact, and widening the staff pair to cover a web
  /// checkbox would quietly destroy the only column that currently
  /// says a human did the asking.
  ///
  /// These four are the weaker but still useful thing: the sender
  /// described the contents, put a value on them, and ticked that they
  /// are lawful and that they accept both sets of terms. Timestamps and
  /// a version rather than booleans, for the reason the staff pair
  /// already gives — in a dispute, "which terms, and when" is the whole
  /// question, and a bare true answers none of it.
  ///
  /// termsVersion is Esoqo's own; carrierTermsVersion is the carrying
  /// company's, captured separately because they are two different
  /// promises made by two different legal entities and a claim may turn
  /// on only one of them. Both null on a staff-entered booking, which
  /// records consent through contentsDeclaredByStaffId instead. The
  /// declared VALUE lives in declaredValueKes further down — it is the
  /// same number cover is priced from, and duplicating it here would
  /// invite the two copies to disagree.
  senderDeclaredContents   String?
  lawfulContentsAttestedAt DateTime?
  termsAcceptedAt          DateTime?
  termsVersion             String?
  carrierTermsVersion      String?

  /// Condition when we took it in, as podPhotoUrl is condition when we
  /// handed it over. The pair brackets our custody — a damage dispute
  /// is settled by comparing them, and with only the second one every
  /// dispute is the customer's word against the courier's.
  intakePhotoUrl String?
  intakePhotoAt  DateTime?

  /// Staff physically confirming custody — separate from booking
  /// itself, which only ever describes a parcel nobody has necessarily
  /// touched yet (a self-service form submission, or a clerk typing a
  /// walk-in's details before the box is even on the counter). Gates
  /// the sender/receiver SMS: neither hears anything until this is
  /// set. Timestamp plus a person, same "who and when" reasoning
  /// contentsDeclaredAt already follows here.
  intakeConfirmedAt        DateTime?
  intakeConfirmedByStaffId String?              @db.Uuid
  /// Copied from the matched ParcelPricingRule at booking time so a
  /// later admin price-rule edit never reshuffles an in-flight parcel.
  transportMode            ParcelTransportMode?

  /// The agreed price — either the pricing rule's standard point or a
  /// bargainReason-backed offer, always re-validated server-side
  /// against ParcelPricingRule (see dbx's price-selection function),
  /// never trusted verbatim from the client.
  priceKes      Decimal? @db.Decimal(10, 2)
  bargainReason String?

  /// MPESA_STK | ESOKO_POINTS — same two-method shape store checkout's
  /// PaymentMethod already follows, minus CASH_ON_DELIVERY (a parcel's
  /// fee is the courier dispatch cost, always collected up front).
  paymentMethod            String?
  /// @unique for the same reason every other checkout-id column in this
  /// schema is: one Daraja checkout confirms exactly one parcel, and the
  /// STK webhook looks the row up by this value on every callback.
  /// Without the index that lookup was a sequential scan of the whole
  /// parcel table — the only one of the nine payment domains missing it.
  paymentCheckoutRequestId String?   @unique
  /// Set only for an MPESA_STK payment, once confirmed (see
  /// dbx.ConfirmParcelPaymentByCheckoutID) — same "quote the actual
  /// transaction back to the payer" role fare_payment/booking_payment's
  /// own mpesaReceiptCode columns already play. Null for ESOKO_POINTS.
  mpesaReceiptCode         String?
  paidAt                   DateTime?
  /// Set only for a CASH payment — who at the counter confirmed the
  /// cash was actually handed over, same audit shape as
  /// refundedByStaffId/cancelledByStaffId below. Null for MPESA_STK
  /// and ESOKO_POINTS, which confirm themselves.
  paidByStaffId            String?   @db.Uuid

  /// Who's coming to collect it and when, set by an admin scheduling a
  /// pickup — distinct from currentHolderPartyId, which only changes
  /// once that person actually scans the code (see ScanHandoff).
  assignedCollectorPartyId String?   @db.Uuid
  collectionScheduledAt    DateTime?
  collectionNote           String?

  /// How this parcel is meant to reach a courier's hands in the first
  /// place — a rider coming to the sender (the only path that existed
  /// before walk-in stations did), or the sender bringing it in
  /// themselves. Doesn't change what ScanHandoff does at receipt; it
  /// only tells a station's own front desk whether to expect a rider
  /// or a walk-in, which is exactly the fact that screen has no way to
  /// know today.
  originMethod ParcelOriginMethod @default(SCHEDULED_PICKUP)

  /// Whoever currently has the parcel in hand — null only before the
  /// first hand-off (still with the sender). Updated on every
  /// ParcelHandoff row, never edited independently of one.
  currentHolderPartyId String?      @db.Uuid
  status               ParcelStatus @default(DRAFT_PENDING_PAYMENT)

  /// Set together, only by dbx.CancelParcel. cancelledByStaffId is a
  /// StaffUser id (an admin action), never a Party — a sender can't
  /// self-cancel today, only ask an admin to.
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledByStaffId String?   @db.Uuid

  /// NOT_APPLICABLE | PENDING | REFUNDED — set by dbx.CancelParcel
  /// (REFUNDED immediately for an auto-reversed ESOKO_POINTS payment,
  /// PENDING for an MPESA_STK one with no automatic reversal available)
  /// and closed out by dbx.MarkParcelRefunded once an admin has
  /// actually processed the M-Pesa refund out of band.
  refundStatus      String    @default("NOT_APPLICABLE")
  refundedAt        DateTime?
  refundedByStaffId String?   @db.Uuid

  /// Set once by dbx.ConfirmParcelReceipt — the receiver (no Esoqo
  /// account required) proving control of their registered number via
  /// OTP after the parcel has been marked DELIVERED, then rating the
  /// condition it arrived in. Distinct from deliveredAt, which is the
  /// courier's own claim of drop-off.
  receiptConfirmedAt     DateTime?
  receiptConditionRating Int?
  receiptFeedback        String?

  /// Proof of delivery, captured by the courier at the moment of
  /// drop-off (see dbx.DeliverParcel). Until these existed a delivery
  /// dispute resolved on staff's word alone: deliveryCode proves the
  /// receiver *knew* a code, never that the parcel physically changed
  /// hands or where. All four are optional — an older client that
  /// doesn't capture them still delivers fine, it just leaves a weaker
  /// record, same graceful-degradation rule originZoneId follows.
  ///
  /// podReceivedByName is who actually took it, which is frequently not
  /// receiverName (a watchman, a shop attendant, a neighbour) — the
  /// single most useful field in a "where is my parcel" dispute and one
  /// the code-only flow threw away entirely.
  podPhotoUrl       String?
  podLat            Decimal? @db.Decimal(10, 7)
  podLng            Decimal? @db.Decimal(10, 7)
  podReceivedByName String?
  /// How the drop-off was authenticated: DELIVERY_CODE (the receiver
  /// produced their code) | AGENT_COLLECTION (collected from a pickup
  /// point, the agent verified) | STAFF_OVERRIDE (a code-less handover
  /// an admin allowed, always paired with podReceivedByName + a photo).
  /// Plain string, not an enum, for the same reason
  /// CourierTeamMember.role is: this list grows by a string far more
  /// often than it needs a migration.
  podMethod         String?

  /// Failed-attempt history (see ParcelStatus.FAILED_DELIVERY and
  /// dbx.RecordDeliveryAttempt). deliveryAttempts counts real attempts,
  /// not scans — a courier reaching the door twice is two, a
  /// double-scan is still one. lastAttemptReason is the courier's
  /// reason code, carried into the SMS the receiver gets so they know
  /// why nobody left anything.
  deliveryAttempts  Int       @default(0)
  lastAttemptAt     DateTime?
  lastAttemptReason String?

  /// The receiver proving, from their own phone, that they are the
  /// receiver — by typing the deliveryCode only they were sent (see
  /// dbx.VerifyReceiverCode). Distinct from the courier-side throttle
  /// in handleDeliverParcel, which is Redis-only and fails open on
  /// purpose: that one guards a staff endpoint and a lost counter
  /// merely means a clerk gets more tries. This counter is escalation
  /// state. Staff have to see it, act on it, and have their grant
  /// survive a Redis restart, so it lives on the row.
  ///
  /// Three attempts, then receiverAuthLockedAt and an alert to the
  /// carrying company. Staff may grant receiverAuthExtraGranted more
  /// (two, once). Burning those sets receiverAuthHardLockedAt, which
  /// nothing but a reissue clears — at that point the code is assumed
  /// compromised or lost and guessing further proves nothing.
  receiverAuthAttempts     Int       @default(0)
  receiverAuthLockedAt     DateTime?
  receiverAuthExtraGranted Int       @default(0)
  receiverAuthHardLockedAt DateTime?

  /// Bumped every time dbx.ReissueDeliveryCode mints a replacement.
  /// The version is what makes a reissue legible after the fact: the
  /// code column itself only ever holds the current value, so without
  /// this a timeline entry saying "a new code was issued" has nothing
  /// to count. deliveryCodeIssuedAt is null for every parcel booked
  /// before reissue existed, which reads correctly as "the original".
  deliveryCodeVersion  Int       @default(1)
  deliveryCodeIssuedAt DateTime?

  /// Set when a receiver closes their own parcel at an agent's counter
  /// (podMethod RECEIVER_SELF_AGENT). Every other delivery accrues
  /// courier pay the instant it commits (see dbx.AccrueCourierEarnings)
  /// because a member of staff was physically present to assert it
  /// happened. A self-confirmed one has no such witness, so the pay
  /// waits out a hold and is released deliberately — by staff, or by a
  /// sweep once this passes. A fraudulent self-confirm is then a thing
  /// somebody can still catch before money moves, rather than an
  /// irreversible accrual (which is exactly what AccrueCourierEarnings
  /// is, by design).
  courierEarningsHeldUntil DateTime?

  /// What the sender says the contents are worth, and the coverage tier
  /// they bought against it (see ParcelCoverageTier). Both null on a
  /// booking with no cover — the default. coverageFeeKes is copied in
  /// at booking time rather than recomputed from the tier, same
  /// "freeze the promise at payment" rule transportMode/slaDeadlineAt
  /// already follow: an admin re-pricing a tier next month must never
  /// change what an in-flight parcel was charged or what it's owed on a
  /// claim. `fragile` stays a separate, free flag — it's a handling
  /// instruction, not a liability position.
  declaredValueKes Decimal?            @db.Decimal(12, 2)
  coverageTierId   String?             @db.Uuid
  coverageTier     ParcelCoverageTier? @relation(fields: [coverageTierId], references: [id])
  coverageFeeKes   Decimal?            @db.Decimal(10, 2)

  /// Where the receiver collects it, when this parcel is going to a
  /// pickup point rather than a door (see ParcelAgent). Null for a
  /// doorstep delivery, which stays the default.
  destinationAgentId String?      @db.Uuid
  destinationAgent   ParcelAgent? @relation("parcelDestinationAgent", fields: [destinationAgentId], references: [id])
  /// When it actually landed on the shelf — its own column rather than
  /// reusing lastAttemptAt, which means something different (a failed
  /// doorstep attempt) and is frequently null for a parcel routed to an
  /// agent by choice rather than after a failure. This is what the
  /// "nobody has collected this in five days" sweep counts against.
  agentHeldSince     DateTime?

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  handoffs           ParcelHandoff[]
  labelStockEntries  ParcelLabelStock[]
  deliveryAttemptLog ParcelDeliveryAttempt[]
  shipmentItems      ParcelShipmentItem[]
  events             ParcelEvent[]
  reminderCount      Int                     @default(0)
  lastReminderAt     DateTime?

  /// Cash on delivery — the social-commerce case this product could not
  /// serve at all before: a seller ships goods, the buyer pays the
  /// courier at the door, and Esoqo settles the goods money back to the
  /// seller.
  ///
  /// codAmountKes is the GOODS value the seller is owed, never the
  /// delivery fee — those are two different people's money and merging
  /// them into one number is how a settlement report stops meaning
  /// anything. What the courier actually collects at the door is
  /// codAmountKes plus, when codCollectDeliveryFee is set, priceKes on
  /// top (the common arrangement here, where the buyer pays for
  /// everything on arrival).
  ///
  /// Null codAmountKes means an ordinary prepaid parcel, which is every
  /// row that existed before this and still the default.
  codAmountKes          Decimal? @db.Decimal(12, 2)
  codCollectDeliveryFee Boolean  @default(false)

  /// NOT_APPLICABLE | PENDING | COLLECTED | REMITTED | SETTLED.
  ///
  /// The four live states are each somebody different holding the
  /// money: PENDING is the buyer's, COLLECTED is in the rider's pocket
  /// (see AccountKind.PARCEL_COD_HELD), REMITTED is Esoqo's, SETTLED is
  /// the seller's. A parcel that fails at the door stays PENDING —
  /// nothing was collected, so nothing moved.
  codStatus String @default("NOT_APPLICABLE")

  /// What the courier actually took, which is not always what was
  /// asked for: a buyer short of cash is a real and common outcome, and
  /// recording the shortfall honestly is what lets somebody chase it.
  /// The ledger always posts this figure, never codAmountKes.
  codCollectedKes       Decimal?  @db.Decimal(12, 2)
  codCollectedAt        DateTime?
  codCollectedByPartyId String?   @db.Uuid

  /// Which hand-over batch cleared this parcel's cash out of the
  /// rider's pocket (see ParcelCodRemittance). Null until remitted.
  codRemittanceId String?              @db.Uuid
  codRemittance   ParcelCodRemittance? @relation(fields: [codRemittanceId], references: [id])

  /// When the seller was actually paid their goods money, and what was
  /// held back for handling it (ParcelCodPolicy.handlingFeePct, frozen
  /// at collection for the same reason every other fee on this row is).
  codSettledAt      DateTime?
  codHandlingFeeKes Decimal?  @db.Decimal(10, 2)

  /// What the delivering courier earned on this parcel, frozen the
  /// moment it was delivered — the same "freeze the promise" rule every
  /// other money column on this row follows, and for the sharpest
  /// reason: this is what a courier invoices against.
  ///
  /// NULL on any parcel carried by a ParcelOrg. That company already
  /// took orgEarningsKes and pays its own riders out of it; accruing
  /// here as well would pay twice for one delivery. See
  /// dbx.AccrueCourierEarnings.
  courierEarningsKes Decimal?             @db.Decimal(10, 2)
  /// Which payout run cleared it. Null until the courier is paid.
  courierPayoutId    String?              @db.Uuid
  courierPayout      ParcelCourierPayout? @relation(fields: [courierPayoutId], references: [id])

  /// Which company is carrying this parcel. NULL means Esoqo-operated
  /// dispatch — every parcel booked before tenancy existed, and every
  /// one Esoqo's own couriers still carry. Set at booking from the
  /// matched rate card, and frozen: reassigning a parcel to a different
  /// company mid-journey would silently move money that was already
  /// split (see platformFeeKes below).
  parcelOrgId String?    @db.Uuid
  parcelOrg   ParcelOrg? @relation(fields: [parcelOrgId], references: [id])

  /// The revenue split, computed once at payment confirmation from
  /// ParcelOrg.commissionPct and never recomputed — the same
  /// freeze-the-promise rule slaDeadlineAt, transportMode and
  /// coverageFeeKes already follow, and for the sharpest version of the
  /// reason: these two numbers are what a company invoices against.
  /// Both null on an Esoqo-operated parcel, where the whole price is
  /// already Esoqo's and a split would be a fiction.
  platformFeeKes Decimal? @db.Decimal(10, 2)
  orgEarningsKes Decimal? @db.Decimal(10, 2)

  /// The passenger trip this parcel is riding on — an actual matatu or
  /// intercity bus, on a scheduled run, with a conductor.
  ///
  /// Deliberately NOT courierTripId below, which is the parcel
  /// vertical's own CourierTrip (a courier team's dispatch round). This
  /// is the ticketing vertical's Trip: the same vehicle passengers are
  /// sitting in, already reporting its position through VehiclePing for
  /// their benefit. A parcel on board inherits that position for free —
  /// see dbx.GetParcelCourierPosition, which prefers the vehicle's ping
  /// over the courier's when this is set.
  ///
  /// That reuse is the whole point: no competitor can copy "track your
  /// parcel on the bus you ride" without first owning a vehicle network,
  /// and Esoqo already runs one.
  tripId        String?   @db.Uuid
  trip          Trip?     @relation(fields: [tripId], references: [id])
  tripBoardedAt DateTime?
  tripDroppedAt DateTime?

  /// Which stage on the route it comes off at. Optional — a parcel can
  /// ride to the terminus without naming a stop — but when set it is
  /// what the conductor is shown at each stage, which is the difference
  /// between a parcel that gets off and one that does a return leg
  /// nobody asked for.
  dropStageId String?    @db.Uuid
  dropStage   FareStage? @relation(fields: [dropStageId], references: [id])

  /// Which fleet trip (if any) this parcel is riding on — see
  /// CourierTrip's own comment. Independent of assignedCollectorPartyId
  /// (an individual courier's own pickup scheduling); a parcel can
  /// have either, both, or neither.
  courierTripId               String?      @db.Uuid
  courierTrip                 CourierTrip? @relation(fields: [courierTripId], references: [id])
  /// Set only once a handler actually scans this parcel onto the fleet
  /// it's assigned to (see dbx.BoardParcelOntoTrip) — distinct from
  /// courierTripId above, which today is set by a bulk assignment with
  /// no confirmation that the physical parcel ever left the shelf. Null
  /// while assigned-but-unboarded is exactly the "left behind" signal
  /// dbx.CheckTripDispatched reads at dispatch time. Named
  /// courierTripBoardedAt (not tripBoardedAt, already taken by the bus
  /// vertical's own Trip above) to keep the two verticals' boarding
  /// events unambiguous even though they read almost the same.
  courierTripBoardedAt        DateTime?
  courierTripBoardedByPartyId String?      @db.Uuid

  @@index([currentHolderPartyId, status])
  @@index([senderPartyId, createdAt])
  @@index([status])
  @@index([courierTripId])
  /// The company console's "find by our own number" — scoped to the
  /// owning company so one tenant's external ids can never surface
  /// another's.
  @@index([parcelOrgId, externalRef])
  @@map("parcel")
}

/// A courier team — a manager plus a roster of members (see
/// CourierTeamMember), owning one or more fleets (CourierFleet). A
/// dispatch-planning layer on top of the existing individual-courier
/// role (ParcelCourier), not a replacement for it: a team member
/// doesn't need to be a vetted ParcelCourier to be on a fleet's trip.
model CourierTeam {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  createdAt        DateTime @default(now())
  createdByStaffId String?  @db.Uuid

  members CourierTeamMember[]
  fleets  CourierFleet[]

  @@map("courier_team")
}

/// One person on a team's roster, manager included (role = "MANAGER")
/// — no separate managerPartyId on CourierTeam, so "who's the
/// manager" always comes from here instead of two sources of truth.
/// role is a plain string (MANAGER | MEMBER | DRIVER | ...), not an
/// enum — same "capability strings, not a role enum" reasoning
/// StaffUser.capabilities already follows, for the same reason: the
/// set of useful team roles is more likely to grow by one more string
/// than to need a schema migration.
model CourierTeamMember {
  id      String      @id @default(uuid()) @db.Uuid
  teamId  String      @db.Uuid
  team    CourierTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  partyId String      @db.Uuid
  role    String      @default("MEMBER")
  addedAt DateTime    @default(now())

  @@unique([teamId, partyId])
  @@map("courier_team_member")
}

/// One physical vehicle under a team, identified by its own
/// fleetNumber — a team can run several at once (see CourierTeam's
/// own comment).
model CourierFleet {
  id          String              @id @default(uuid()) @db.Uuid
  teamId      String              @db.Uuid
  team        CourierTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fleetNumber String              @unique
  vehicleType ParcelTransportMode
  createdAt   DateTime            @default(now())

  trips CourierTrip[]

  @@map("courier_fleet")
}

/// One open (IN_PROGRESS) trip per fleet at a time — assigning a
/// parcel to a fleet lands on whichever trip is currently open for it
/// (opening a fresh one if none is), and marking that trip COMPLETE
/// fires the "packages have arrived" SMS to the whole team (manager +
/// every member — see notify.CourierTripCompleted) and frees the
/// fleet to start a new one.
model CourierTrip {
  id                 String       @id @default(uuid()) @db.Uuid
  fleetId            String       @db.Uuid
  fleet              CourierFleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  status             String       @default("IN_PROGRESS")
  startedAt          DateTime     @default(now())
  completedAt        DateTime?
  completedByStaffId String?      @db.Uuid
  /// The explicit "I'm done scanning, dispatch this trip" moment — set
  /// once by dbx.CheckTripDispatched, which is also the moment any
  /// still-unboarded assigned parcel becomes a "left behind" fact worth
  /// telling the team about. Distinct from completedAt, which fires on
  /// return/delivery, not on departure — a trip is checked long before
  /// it's complete.
  checkedAt          DateTime?
  checkedByStaffId   String?      @db.Uuid

  parcels Parcel[]

  @@map("courier_trip")
}

/// A pool of pre-minted PKG-… codes that exist *before* any booking —
/// printed and stuck onto an envelope/box ahead of time, then "filled
/// in" the moment a shipment actually needs one (see dbx.BookParcel's
/// ExistingCode param), instead of every physical label being printed
/// fresh at booking time. Its own table, not a nullable half of Parcel
/// — a blank label has none of Parcel's required fields and never
/// goes through Parcel's own status lifecycle; it's either unused or
/// spent, nothing else.
model ParcelLabelStock {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique
  createdAt        DateTime  @default(now())
  createdByStaffId String?   @db.Uuid
  /// Both null until BookParcel binds this code to a real shipment —
  /// set together, in the same transaction, never independently.
  usedAt           DateTime?
  usedByParcelId   String?   @db.Uuid
  usedByParcel     Parcel?   @relation(fields: [usedByParcelId], references: [id])

  /// Who this pad was printed for. NULL means the shared Esoqo pool,
  /// the same convention Parcel.parcelOrgId uses.
  ///
  /// This is what stops a partner courier spending stock printed for
  /// another company and settling the shipment against the wrong
  /// books. Recorded here, enforced at bind time — see BookParcel's
  /// existingCode path, which refuses a code whose owner isn't the
  /// company the binder is signed in to.
  parcelOrgId        String?    @db.Uuid
  parcelOrg          ParcelOrg? @relation(fields: [parcelOrgId], references: [id])
  issuedToOrgStaffId String?    @db.Uuid
  issuedAt           DateTime?

  /// The minted run this came off, so a pad that walks out of a branch
  /// can be withdrawn in one statement instead of label by label.
  ///
  /// NULL means "minted before batches were tracked" — not backfilled,
  /// because the batches those labels came off are genuinely unknown
  /// and one synthetic id would assert they were printed together.
  batchId String? @db.Uuid

  /// Withdrawn stock. Never deleted: the physical sticker still exists
  /// on something and someone will eventually scan it, so the row has
  /// to survive to answer "this label was withdrawn" rather than 404
  /// and leave a real box unexplained.
  voidedAt        DateTime?
  voidedReason    String?
  voidedByStaffId String?   @db.Uuid

  /// Structured info attached in the field the moment a handler
  /// sticks this label on a physical item, independent of (and
  /// usually well before) a real booking. All optional — a handler
  /// might only know the item and destination at first, and fill in
  /// the rest later (AttachParcelLabelInfo overwrites, doesn't merge,
  /// so the caller always resends the full set it wants kept).
  /// GetParcelStatus's guest-safe scan/track projection falls back to
  /// this when no real Parcel exists yet for the code.
  itemDescription       String?
  destination           String?
  /// The label's parties, named the same as a real booking's — one
  /// vocabulary across "attach info to a label" and "book a parcel",
  /// so what a handler in the field records survives into the counter
  /// rather than being re-asked (see CounterForm's carry-forward).
  senderName            String?
  senderMsisdn          String?
  receiverName          String?
  receiverMsisdn        String?
  itemType              String?
  weightRangeKg         String?
  /// Same three dimensions a real booking carries. A handler measuring
  /// a box at a bus stage is doing the counter's job earlier and with
  /// less of the picture — one vocabulary across both, so what's
  /// recorded here survives into the booking rather than being
  /// re-asked.
  lengthCm              Decimal?  @db.Decimal(6, 1)
  widthCm               Decimal?  @db.Decimal(6, 1)
  heightCm              Decimal?  @db.Decimal(6, 1)
  infoAttachedAt        DateTime?
  infoAttachedByStaffId String?   @db.Uuid

  /// The company's operating corridor this label prints with — e.g.
  /// "Nairobi -> Mombasa". routeId is set when a real ParcelRoute was
  /// picked; routeLabel is always set (a snapshot of that route's name,
  /// or a typed "From -> To" when no defined route fit) so the printed
  /// text survives the route being renamed or deleted later — the same
  /// snapshot-plus-live-reference shape ParcelShipment.originLabel/
  /// destinationLabel already uses against the same table.
  routeId    String?      @db.Uuid
  route      ParcelRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeLabel String?

  /// Both partial, matching the migration: "what can this company
  /// still use" and "void this batch" only ever ask about live stock,
  /// so spent and voided rows are dead weight in them.
  @@index([parcelOrgId, createdAt])
  @@index([batchId])
  @@map("parcel_label_stock")
}

/// One hand-over of collected cash, clearing a rider's pocket.
///
/// A batch rather than a per-parcel event because that is how the money
/// physically moves: a rider finishes a round and hands over everything
/// at once. Recording it parcel-by-parcel would invent a precision the
/// cash itself doesn't have, and make reconciling a rider's float
/// against a stack of notes far harder than it needs to be.
///
/// Append-only — a remittance is never edited. A miscount is corrected
/// by recording the correction, the same convention ParcelHandoff and
/// ParcelDeliveryAttempt already follow.
model ParcelCodRemittance {
  id String @id @default(uuid()) @db.Uuid

  /// Whose pocket this emptied.
  riderPartyId String @db.Uuid

  /// Who took the cash: an Esoqo staff member, or a courier company's
  /// own manager. Exactly one is set — which of the two tells you where
  /// the money physically went, and both being null would mean nobody
  /// is accountable for a bag of notes.
  receivedByStaffId    String? @db.Uuid
  receivedByOrgStaffId String? @db.Uuid

  /// What was counted. Deliberately its own number rather than a sum of
  /// the parcels below: the whole point of a reconciliation record is
  /// that the declared total and the expected total can disagree, and a
  /// schema that derives one from the other can never surface a short
  /// hand-over.
  amountKes   Decimal @db.Decimal(12, 2)
  /// The sum the parcels in this batch say it should have been, frozen
  /// at the moment of counting.
  expectedKes Decimal @db.Decimal(12, 2)
  note        String?

  createdAt DateTime @default(now())

  parcels Parcel[]

  @@index([riderPartyId, createdAt])
  @@map("parcel_cod_remittance")
}

/// The one global, admin-editable cash-on-delivery policy — same
/// single-row shape ParcelDistanceRate uses, and the same explicit
/// deferral: there is deliberately no per-company or per-seller
/// override yet. COD is the highest-risk thing in this vertical (it is
/// the only flow where Esoqo is holding somebody else's money), so it
/// starts as one switch an admin can see all of, rather than a matrix
/// nobody can audit at a glance.
model ParcelCodPolicy {
  id      String  @id @default(uuid()) @db.Uuid
  enabled Boolean @default(false)

  /// The most goods value a single parcel may carry. A cap, not a
  /// suggestion: this is the amount a rider can be robbed of, and the
  /// amount Esoqo is liable for if they vanish.
  maxAmountKes Decimal @default(20000) @db.Decimal(12, 2)

  /// Esoqo's cut of the goods value for handling the cash, held back at
  /// settlement. Distinct from the delivery fee, which the parcel's own
  /// priceKes already covers.
  handlingFeePct Decimal @default(2) @db.Decimal(5, 2)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("parcel_cod_policy")
}

/// The one global, admin-editable rate a gig courier is paid per
/// delivery — same single-row shape ParcelDistanceRate and
/// ParcelCodPolicy already use, and the same explicit deferral: there
/// is deliberately no per-courier or per-zone rate yet. A rate card
/// nobody can see all of at once is a rate card nobody can audit, and
/// courier pay is the last place to start with a matrix.
///
/// The two components stack: a courier earns perDeliveryKes plus
/// pctOfPrice of what the sender paid. Either may be zero, which is how
/// you express "flat rate only" or "commission only" without a mode
/// flag nobody would remember the meaning of.
model ParcelCourierTariff {
  id             String  @id @default(uuid()) @db.Uuid
  perDeliveryKes Decimal @default(0) @db.Decimal(10, 2)
  pctOfPrice     Decimal @default(0) @db.Decimal(5, 2)

  /// Never pay out more than the sender paid. A guard rather than a
  /// business rule: it exists so a mistyped percentage costs Esoqo
  /// nothing worse than its whole margin on that parcel.
  maxPerDeliveryKes Decimal @default(2000) @db.Decimal(10, 2)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("parcel_courier_tariff")
}

/// One payout run, clearing what a courier is owed.
///
/// A batch for the same reason ParcelCodRemittance is: money moves to a
/// person in one transfer covering many parcels, and a per-parcel
/// record would invent a precision the M-Pesa transfer itself doesn't
/// have. Append-only — a correction is a new row, never an edit.
model ParcelCourierPayout {
  id             String @id @default(uuid()) @db.Uuid
  courierPartyId String @db.Uuid

  /// What was actually sent, and what the parcels said was owed. Two
  /// columns, deliberately: a payout that disagrees with the accrual is
  /// exactly the thing a reconciliation record has to be able to show.
  amountKes   Decimal @db.Decimal(12, 2)
  expectedKes Decimal @db.Decimal(12, 2)

  /// Free text — an M-Pesa transaction id, a bank reference, "paid
  /// cash at the depot". Not validated: this records what a human did,
  /// and refusing a format they actually used would just produce blank
  /// references.
  reference String?
  note      String?

  paidByStaffId String?  @db.Uuid
  createdAt     DateTime @default(now())

  parcels Parcel[]

  @@index([courierPartyId, createdAt])
  @@map("parcel_courier_payout")
}

/// A courier company operating on Esoqo — a real business with its own
/// staff, its own riders and its own rate card, as opposed to the
/// Esoqo-run dispatch every parcel used to belong to.
///
/// Hangs off Enterprise exactly as Store and TicketOrg do, for the same
/// reason: the tenant side of this platform is already "a Party runs an
/// Enterprise, an Enterprise opens a <thing>", and a parcel company is
/// another such thing, not a parallel merchant concept.
///
/// Parcel.parcelOrgId stays nullable throughout: a null means
/// Esoqo-operated, which is every parcel booked before this model
/// existed and every parcel Esoqo's own couriers carry now. Tenancy is
/// additive here, never a migration of existing rows into a default
/// org — inventing a fake "Esoqo Logistics Ltd" tenant to avoid a
/// nullable column would put real money under a company that doesn't
/// exist.
model ParcelOrg {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  name String
  /// Public, shared with staff as the sign-in URL (/parcel-co/<slug>) —
  /// same role TicketOrg.slug plays for organiser staff.
  slug String @unique

  /// DRAFT until an admin activates it; SUSPENDED stops new bookings
  /// being routed to it without touching parcels already in flight.
  /// Plain string rather than an enum, same reasoning
  /// CourierTeamMember.role follows.
  status String @default("DRAFT")

  contactPerson   String?
  contactPhone    String?
  contactEmail    String?
  /// M-Pesa number settlements should be paid to. Informational, same
  /// as Store.settlementPhone and TicketOrg.settlementPhone — actual
  /// payouts run through the ledger, not off this column.
  settlementPhone String?

  /// Esoqo's cut of every parcel this company carries, as a percent of
  /// the paid price. Copied onto each parcel at payment time (see
  /// Parcel.platformFeeKes) and never read live afterwards, so
  /// renegotiating a rate next month can't rewrite what an already-paid
  /// parcel earned.
  ///
  /// This one number covers both commercial readings deliberately: a
  /// company that sets its own prices and pays Esoqo a commission, and
  /// a company Esoqo prices for and pays a share to, are the same
  /// arithmetic with different values — so neither needs its own
  /// schema.
  commissionPct Decimal @default(15) @db.Decimal(5, 2)

  /// The one physical front desk a sender can walk into and hand a
  /// parcel over in person, rather than waiting on a scheduled pickup —
  /// same "free text + real coordinates" shape ParcelAgent already uses
  /// for a receiver-side pickup point, mirrored here for the origin
  /// side. One desk per company for now; a company that runs several
  /// physical counters gets its own table when that actually comes up,
  /// not before.
  acceptsWalkIn Boolean  @default(false)
  lat           Decimal? @db.Decimal(9, 6)
  lng           Decimal? @db.Decimal(9, 6)
  /// "Ground floor, Kenyatta Avenue, next to the post office" — what a
  /// sender actually navigates by, same convention ParcelAgent.locationHint
  /// and Parcel.originLabel already follow.
  locationHint  String?
  /// Free text ("Mon-Sat 8am-6pm"), same reasoning ParcelAgent.openingHours
  /// gives for not modelling this as a real schedule.
  openingHours  String?

  /// Company logo for co-branded parcel labels. Public URL served via
  /// /img/{key}, same pattern as Store.logoUrl — printed centered in
  /// the label header band, never over QR/barcode pixels. Null = Esoqo
  /// branding alone (the fallback every label prints with).
  logoStorageKey String?
  logoUrl        String?
  /// Optional brand accent (hex) for the label header. Validated in
  /// the admin form; null = default ink.
  brandAccent    String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdByStaffId String?  @db.Uuid

  staff          ParcelOrgStaff[]
  parcels        Parcel[]
  stations       ParcelAgent[]
  couriers       ParcelCourier[]
  pricingRules   ParcelPricingRule[]
  labelStock     ParcelLabelStock[]
  runs           ParcelShipment[]
  routes         ParcelRoute[]
  counterTickets ParcelCounterTicket[]

  @@index([enterpriseId])
  @@index([status])
  @@index([acceptsWalkIn])
  @@map("parcel_org")
}

/// One of a parcel company's own people, signing in with a name and an
/// org-scoped PIN rather than an Esoqo account — the exact shape
/// TicketOrgStaff already has, because it solves the identical problem:
/// a dispatcher or a rider needs into one company's parcels and nothing
/// else, and issuing them a full Esoqo identity for that is both more
/// work and more access than the job needs.
///
/// role drives the capability bundle (see authsvc.ParcelStaffCapabilities):
/// MANAGER runs the company, DISPATCHER assigns work, RIDER carries
/// parcels and closes them at the door.
model ParcelOrgStaff {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   ParcelOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name    String
  pinHash String
  role    String  @default("RIDER")
  active  Boolean @default(true)

  /// Marked by an admin/manager as one of the company's contact people.
  /// Multiple are allowed — a depot may want its manager and its dispatcher
  /// both reachable — and the register/detail "Contact" view prefers these
  /// over the legacy parcel_org.contactPerson string, which stays only as
  /// a fallback for rows written before this flag existed.
  isContact Boolean @default(false)

  /// Explicit permission set for a custom ("Other…") role, chosen from
  /// authsvc.AllParcelOrgCapabilities. Empty for a preset role, whose
  /// bundle is resolved from `role` at sign-in; when non-empty it
  /// replaces the role bundle, so an owner can grant exactly the access
  /// a free-text title needs instead of the RIDER floor. Validated
  /// server-side — a stray string here can't widen anything.
  capabilities String[] @default([])

  /// The Party this login acts as when it takes custody of a parcel.
  /// Custody is always attributed to a real Party (see
  /// Parcel.currentHolderPartyId) — a PIN login is an authentication
  /// method, not a substitute identity, and a handoff chain pointing at
  /// "staff row 7" rather than a person would be worthless in a dispute.
  /// Null for office roles that never carry anything.
  partyId   String?      @db.Uuid
  stationId String?      @db.Uuid
  station   ParcelAgent? @relation("parcelStationStaff", fields: [stationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimedCounterTickets ParcelCounterTicket[]

  @@index([orgId])
  @@map("parcel_org_staff")
}

/// How a walk-in customer's service ticket came to exist — the one
/// endpoint (POST .../counter-tickets) serves a kiosk at the counter,
/// a web form opened from a counter QR on the customer's own phone,
/// and the Esoqo mobile app alike; this is the only thing that differs
/// between them.
enum ParcelCounterTicketChannel {
  KIOSK
  WEB_QR
  APP
}

/// WAITING is the only state that shows up in a clerk's live queue.
/// CLAIMED means a clerk is actively serving it — not that a Parcel
/// exists yet, since a claimed ticket still has to go through the
/// ordinary booking/label-binding flow same as any counter intake.
/// EXPIRED is a customer who walked off or a stale kiosk session,
/// aged out rather than left WAITING forever.
enum ParcelCounterTicketStatus {
  WAITING
  CLAIMED
  EXPIRED
  CANCELLED
}

/// A walk-in's place in line, minted the moment they ask for service
/// rather than when a clerk starts on them — the ticket number is the
/// one thing they're handed before any parcel details exist (same
/// pre-intake role Parcel.serviceTicketNumber already plays for a
/// booking that's further along). Deliberately its own model rather
/// than an early Parcel row: BookParcel requires full sender/receiver/
/// type data up front (see its own comment), but a ticket only ever
/// needs a phone number to exist.
///
/// draftDetails holds whatever the customer filled into the send-parcel
/// form while waiting (see apps/web's SendParcelForm autosave) — a
/// free-form JSON blob the clerk's intake screen prefills from at claim
/// time, never validated or read by anything else here.
model ParcelCounterTicket {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   ParcelOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// "TCK-…" — same fleetqr.PrefixServiceTicket pool Parcel.serviceTicketNumber
  /// mints from, so a ticket and a pre-intake parcel are never
  /// confusable at a glance by their prefix alone.
  serviceTicketNumber String                     @unique
  msisdn              String
  channel             ParcelCounterTicketChannel
  status              ParcelCounterTicketStatus  @default(WAITING)

  draftDetails Json?

  claimedByStaffId String?         @db.Uuid
  claimedByStaff   ParcelOrgStaff? @relation(fields: [claimedByStaffId], references: [id], onDelete: SetNull)
  claimedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The live queue is always "WAITING tickets for org X, oldest
  /// first" — this index is that query.
  @@index([orgId, status, createdAt])
  @@map("parcel_counter_ticket")
}

/// Admin-owned pricing config, one row per ParcelType — same
/// "admin-editable rate card" shape PricingRule already follows for
/// platform fees, scoped to parcel dispatch pricing. Read by Go's dbx
/// at booking time via raw SQL (shared-table, different-writer split,
/// same as Parcel itself: Prisma holds DDL, this table's rows are
/// written by the admin app via Prisma, read-only from core-go).
model ParcelPricingRule {
  id String @id @default(uuid()) @db.Uuid

  /// Which company this rate applies to. NULL is the platform default —
  /// the row every parcel priced before tenancy existed matched, and
  /// the fallback for any company that hasn't set its own rate for a
  /// type. A company overrides one bracket without having to restate
  /// the other four.
  ///
  /// Note the unique key below moved from `parcelType` alone to the
  /// pair: "one row per type" was only ever true while there was one
  /// operator.
  parcelOrgId String?    @db.Uuid
  parcelOrg   ParcelOrg? @relation(fields: [parcelOrgId], references: [id], onDelete: Cascade)

  parcelType  ParcelType
  /// Free-text display line, e.g. "0.5kg to 2.2kg" — kept alongside
  /// minWeightKg/maxWeightKg below rather than derived from them, so an
  /// admin can still write "Up to 0.5kg" instead of "0kg to 0.5kg".
  weightLabel String

  /// The actual bracket boundaries, inclusive — what BookParcel's
  /// weight-to-parcelType matching (mobile) and any future server-side
  /// check runs against. weightLabel is prose for a human; these two
  /// are the numbers a program can compare.
  minWeightKg Decimal @db.Decimal(6, 2)
  maxWeightKg Decimal @db.Decimal(6, 2)

  minKes Decimal @db.Decimal(10, 2)
  maxKes Decimal @db.Decimal(10, 2)

  /// How far below minKes a reason-backed offer may land, e.g. 5–15%.
  bargainMinPct  Decimal @db.Decimal(5, 2)
  bargainMaxPct  Decimal @db.Decimal(5, 2)
  /// [{ "reason": "Not fragile", "extraDiscountPct": 5 }, ...] — each
  /// reason's extraDiscountPct is added on top of bargainMinPct, capped
  /// at bargainMaxPct, and is what the mobile app's "make an offer"
  /// step must show — never a free-typed number.
  bargainReasons Json    @default("[]")

  suggestedTransportMode ParcelTransportMode

  /// How much cheaper this parcel type is when the receiver collects it
  /// from a pickup point instead of having it brought to a door (see
  /// ParcelAgent). Per-type rather than one global number because the
  /// saving genuinely scales with size — skipping the last mile on a
  /// heavy item saves far more than on an envelope. 0 (the default)
  /// means agent collection costs the same as doorstep, which is a
  /// legitimate admin choice, not an unconfigured state.
  agentDropDiscountPct Decimal @default(0) @db.Decimal(5, 2)

  /// How many hours after payment this parcel type is promised
  /// delivered by — copied onto Parcel.slaDeadlineAt at BOOKED time
  /// (see dbx.ConfirmParcelPaymentByCheckoutID/PayParcelWithPoints).
  /// Null means no SLA is tracked for this type yet — same
  /// "unconfigured means opt-out, not zero" convention bargainReasons'
  /// empty-array default already follows.
  slaHours Int?

  updatedAt   DateTime   @updatedAt
  updatedById String?    @db.Uuid
  updatedBy   StaffUser? @relation("parcelPricingRulesSet", fields: [updatedById], references: [id])

  @@unique([parcelOrgId, parcelType])
  @@map("parcel_pricing_rule")
}

/// One custody transfer, append-only — scanning a parcel's code is
/// what creates this row (see dbx.ScanHandoff), never a direct edit to
/// Parcel.currentHolderPartyId.
model ParcelHandoff {
  id          String        @id @default(uuid()) @db.Uuid
  parcelId    String        @db.Uuid
  parcel      Parcel        @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  /// Null on the very first pickup (meaning "from the sender"), the
  /// previous currentHolderPartyId otherwise — added so the chain of
  /// custody can actually be reconstructed (see dbx.ListParcelHandoffs)
  /// instead of only being inferable from row order.
  fromPartyId String?       @db.Uuid
  /// Null only for a staff counter receipt with no linked Party (an
  /// Esoqo desk — see ParcelStatus.RECEIVED_AT_COUNTER): the box is at
  /// the counter and no carrier holds it yet, but the receipt is still a
  /// real custody event and belongs in the chain.
  toPartyId   String?       @db.Uuid
  createdAt   DateTime      @default(now())
  /// The parcel status this leg produced (RECEIVED_AT_COUNTER,
  /// PICKED_UP, IN_TRANSIT, HELD_AT_AGENT). Null on rows written before
  /// this column existed. Lets the guest-safe tracking timeline label
  /// each custody leg without resolving any holder's name.
  status      ParcelStatus?

  @@index([parcelId, createdAt])
  @@map("parcel_handoff")
}

/// What kind of thing happened. Deliberately narrow at birth — this is
/// a history table, and a history table whose vocabulary is "anything"
/// degrades into a log nobody can query. Add a value when a new fact
/// needs to be *shown* somewhere, not merely recorded.
enum ParcelEventKind {
  RECEIVER_AUTH_PASSED
  RECEIVER_AUTH_FAILED
  RECEIVER_AUTH_LOCKED
  RECEIVER_AUTH_RETRY_GRANTED
  RECEIVER_AUTH_HARD_LOCKED
  DELIVERY_CODE_REISSUED
  RECEIVER_SELF_CONFIRMED
  COURIER_EARNINGS_HELD
  COURIER_EARNINGS_RELEASED
}

/// How loudly to render it. The public timeline drew every entry as a
/// green tick until this existed, which was fine while every entry was
/// a custody leg that had genuinely gone right, and actively misleading
/// the moment a failure could appear there.
enum ParcelEventSeverity {
  INFO
  WARNING
  CRITICAL
}

/// One thing that happened to a parcel which is not a custody transfer,
/// append-only. ParcelHandoff next door answers "who had it, when";
/// this answers everything else the timeline needs to say — a receiver
/// failing to authenticate, a code being reissued, courier pay being
/// held.
///
/// It exists because there was previously nowhere to put such a fact.
/// dbx.buildParcelTrackEvents synthesized the entire public timeline
/// out of parcel_handoff rows plus a booked/delivered bookend, so a
/// non-custody event was literally unrepresentable, and
/// Parcel.exceptionNote — the nearest thing — is a single overwritable
/// slot, not a history.
///
/// publicLabel is the visibility switch and the wording in one field:
/// NULL means the row never leaves staff surfaces, and a non-null value
/// is the exact sentence a guest sees. One field rather than a boolean
/// plus a string because the two can't safely disagree — a row marked
/// public with nothing to say would render as a blank line in a
/// stranger's tracking page. staffDetail carries what the public label
/// must not: attempt counts, actor identity, the reason.
model ParcelEvent {
  id       String @id @default(uuid()) @db.Uuid
  parcelId String @db.Uuid
  parcel   Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  kind     ParcelEventKind
  severity ParcelEventSeverity @default(INFO)

  publicLabel String?
  staffDetail String?

  /// GUEST | STAFF | SYSTEM. Plain string for the same reason
  /// Parcel.podMethod is one: the set of things that can act on a
  /// parcel grows by a word far more often than it needs a migration.
  /// actorPartyId is set only for STAFF; a guest has no Party by
  /// definition, which is the whole premise of the flow that writes
  /// most of these rows.
  actorType    String
  actorPartyId String? @db.Uuid
  /// Kept for the failure rows specifically. Someone working out
  /// whether a locked parcel was a confused receiver or a sweep needs
  /// to know whether the five attempts came from one address or five,
  /// and nothing else on the row can tell them.
  actorIp      String?

  createdAt DateTime @default(now())

  @@index([parcelId, createdAt])
  @@map("parcel_event")
}

/// A physical line-haul movement. The manifest is separate from Parcel so
/// loading and offloading have their own actors, timestamps, and exceptions.
model ParcelShipment {
  id               String    @id @default(uuid()) @db.Uuid
  originLabel      String
  destinationLabel String
  routeLabel       String?
  vehiclePlate     String?
  driverPartyId    String?   @db.Uuid
  conductorPartyId String?   @db.Uuid
  status           String    @default("LOADING")
  startedAt        DateTime?
  arrivedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  createdByStaffId String?   @db.Uuid

  /// Which courier company's run this is. NULL = Esoqo-operated, the
  /// same convention Parcel.parcelOrgId already uses. Every org-scoped
  /// read filters on it, so an unowned shipment is invisible to every
  /// company rather than visible to all of them.
  parcelOrgId String?    @db.Uuid
  parcelOrg   ParcelOrg? @relation(fields: [parcelOrgId], references: [id], onDelete: SetNull)

  /// The journey half, merged in from parcel_dispatch (ADR-0006). One
  /// lorry used to be two rows in two tables with no key between them:
  /// this side owned the cargo and knew places only as free text, while
  /// parcel_dispatch owned the stations, crew and GPS trail and had no
  /// parcels at all.
  ///
  /// originLabel/destinationLabel above are now a SNAPSHOT, not the
  /// truth: a run that happened is a historical record, and a station
  /// renamed in March must not rewrite what a manifest printed in
  /// January said. The station links are the live reference.
  routeId              String?      @db.Uuid
  route                ParcelRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  originStationId      String?      @db.Uuid
  originStation        ParcelAgent? @relation("runOrigin", fields: [originStationId], references: [id], onDelete: SetNull)
  destinationStationId String?      @db.Uuid
  destinationStation   ParcelAgent? @relation("runDestination", fields: [destinationStationId], references: [id], onDelete: SetNull)

  vehicleType String?
  notes       String?
  /// Last reported position; ParcelRunPing behind it keeps the trail.
  currentLat  Float?
  currentLng  Float?
  currentAt   DateTime?
  /// Who signed the run in at the far end.
  receivedBy  String?

  items     ParcelShipmentItem[]
  crew      ParcelRunCrew[]
  receivers ParcelRunReceiver[]
  pings     ParcelRunPing[]

  @@index([status])
  @@index([routeId, createdAt(sort: Desc)], map: "parcel_shipment_route_idx")
  @@map("parcel_shipment")
}

model ParcelShipmentItem {
  id                 String         @id @default(uuid()) @db.Uuid
  shipmentId         String         @db.Uuid
  shipment           ParcelShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  parcelId           String         @db.Uuid
  parcel             Parcel         @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  loadedAt           DateTime?
  loadedByPartyId    String?        @db.Uuid
  loadedByStaffId    String?        @db.Uuid
  offloadedAt        DateTime?
  offloadedByPartyId String?        @db.Uuid
  offloadedByStaffId String?        @db.Uuid
  exceptionCode      String?
  exceptionNote      String?
  createdAt          DateTime       @default(now())

  @@unique([shipmentId, parcelId])
  @@index([shipmentId, loadedAt])
  @@index([shipmentId, offloadedAt])
  @@index([parcelId])
  @@map("parcel_shipment_item")
}

/// The formal courier role — distinct from "any Party", which is all
/// ScanHandoff/AssignParcelCollector used to require (see the security
/// fix in dbx.ScanHandoff's own comment, and CollectorLite's comment on
/// why collector search used to just be "an existing Party with a
/// phone"). A Party becomes a courier once staff onboard them here;
/// PENDING_VETTING until a staff member flips them ACTIVE (see
/// dbx.SetCourierStatus) — no document/KYC upload pipeline yet, see the
/// plan's explicit deferral note.
model ParcelCourier {
  id      String @id @default(uuid()) @db.Uuid
  partyId String @unique @db.Uuid

  /// The company this rider works for, or NULL for an independent
  /// courier on Esoqo's own roster — the gig half of the hybrid
  /// dispatch model, which predates tenancy and stays exactly as it was.
  parcelOrgId String?    @db.Uuid
  parcelOrg   ParcelOrg? @relation(fields: [parcelOrgId], references: [id], onDelete: SetNull)

  vehicleType ParcelTransportMode
  status      ParcelCourierStatus @default(PENDING_VETTING)
  vettingNote String?

  activatedAt DateTime?
  suspendedAt DateTime?

  createdAt   DateTime @default(now())
  updatedById String?  @db.Uuid

  pings ParcelCourierPing[]

  @@index([status])
  @@map("parcel_courier")
}

/// Admin-managed named hub with coordinates — the pricing/dispatch
/// signal a parcel's free-text origin/destination label was never
/// meant to be (see Parcel.originLabel's own comment). Deliberately a
/// small admin-curated list of real hubs, not free-typed geocoding —
/// there's no geocoding provider anywhere in this codebase, and a
/// curated zone list is what "zone-based pricing" (as opposed to
/// continuous lat/lng distance) actually means.
model ParcelZone {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  lat    Decimal @db.Decimal(9, 6)
  lng    Decimal @db.Decimal(9, 6)
  active Boolean @default(true)

  createdAt DateTime @default(now())

  agents ParcelAgent[]

  @@map("parcel_zone")
}

/// A neighbourhood pickup point — a real shop that holds parcels for
/// collection. The agent-to-agent leg is what makes a delivery cheap
/// enough to compete in this market: a courier serving one shop that
/// twenty receivers walk to costs a fraction of twenty doorstep runs,
/// which is the whole basis of the dominant local competitor's pricing.
///
/// Deliberately a sibling of ParcelZone rather than an extension of it:
/// a zone is a *pricing/distance* coordinate (see ParcelZone's own
/// comment), an agent is a *place custody actually sits* — with a
/// person, a phone, opening hours and finite shelf space. Several
/// agents share one zone, and a zone with no agents still prices fine.
model ParcelAgent {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  /// The Party that runs the shop. Nullable because ops routinely
  /// onboard a physical location before the owner has an Esoqo account
  /// — until it's set, custody at this agent is attributed to the staff
  /// member who recorded the drop (same "a real party or nobody" rule
  /// Parcel.currentHolderPartyId already follows).
  partyId     String?    @db.Uuid
  parcelOrgId String?    @db.Uuid
  parcelOrg   ParcelOrg? @relation(fields: [parcelOrgId], references: [id], onDelete: SetNull)

  zoneId String?     @db.Uuid
  zone   ParcelZone? @relation(fields: [zoneId], references: [id])

  /// Its own coordinates, not the zone's — a receiver needs to walk to
  /// this shop, not to the zone centroid it prices against.
  lat Decimal @db.Decimal(9, 6)
  lng Decimal @db.Decimal(9, 6)

  msisdn       String
  /// "Shop 4, Ngara Road, next to the Total station" — what someone
  /// actually navigates by here. Same reasoning Parcel.originLabel's
  /// free text survives alongside a zone id.
  locationHint String
  /// Free text ("Mon–Sat 8am–7pm, Sun closed"). Not structured hours:
  /// a curated list of shops whose hours change with the weather is not
  /// a scheduling system, and pretending otherwise would only produce
  /// confidently wrong "closed now" badges.
  openingHours String?

  active        Boolean @default(true)
  /// Shelf space, in parcels. Dispatch refuses to route a parcel to an
  /// agent already at capacity rather than discovering it at the door.
  capacity      Int     @default(50)
  /// What the receiver pays the shop on collection, if anything —
  /// copied onto the parcel at booking time, never read live, same
  /// freeze-the-promise rule ParcelCoverageTier follows.
  holdingFeeKes Decimal @default(0) @db.Decimal(10, 2)

  createdAt        DateTime @default(now())
  createdByStaffId String?  @db.Uuid

  /// The team member who runs this station day to day — a
  /// parcel_org_staff row, so a station has an owner inside the
  /// company's own roster without inventing a second identity. Null
  /// until a manager names one; the station still works, the console
  /// just can't say who is accountable.
  managerStaffId String? @db.Uuid

  destinationParcels Parcel[]          @relation("parcelDestinationAgent")
  stationStaff       ParcelOrgStaff[]  @relation("parcelStationStaff")
  runOrigins         ParcelShipment[]  @relation("runOrigin")
  runDestinations    ParcelShipment[]  @relation("runDestination")
  routeStops         ParcelRouteStop[]

  @@index([zoneId, active])
  @@map("parcel_agent")
}

/// One person aboard a run — driver, tout, loader, or a custom title.
/// role is a plain string with customRole for free text, the same
/// convention ParcelOrgStaff.role follows; staffId links the roster row
/// when the crew member was picked from the team.
model ParcelRunCrew {
  id    String         @id @default(uuid()) @db.Uuid
  runId String         @db.Uuid
  run   ParcelShipment @relation(fields: [runId], references: [id], onDelete: Cascade)

  name       String
  msisdn     String?
  role       String  @default("DRIVER")
  customRole String?
  staffId    String? @db.Uuid

  @@index([runId], map: "parcel_run_crew_run_idx")
  @@map("parcel_run_crew")
}

/// One of the receiving team waiting at the destination to check the run
/// in on arrival. staffId links the roster where possible; name is a
/// snapshot so the run still reads sensibly if the roster changes later.
model ParcelRunReceiver {
  id    String         @id @default(uuid()) @db.Uuid
  runId String         @db.Uuid
  run   ParcelShipment @relation(fields: [runId], references: [id], onDelete: Cascade)

  name    String
  staffId String? @db.Uuid

  @@index([runId], map: "parcel_run_receiver_run_idx")
  @@map("parcel_run_receiver")
}

/// Position reports for a run — the trail the live map draws. Unbounded
/// growth is capped on write (see dbx.ReportRunPosition): only recent
/// points are ever read back.
model ParcelRunPing {
  id    String         @id @default(uuid()) @db.Uuid
  runId String         @db.Uuid
  run   ParcelShipment @relation(fields: [runId], references: [id], onDelete: Cascade)

  lat Float
  lng Float
  at  DateTime @default(now())

  @@index([runId, at(sort: Desc)], map: "parcel_run_ping_run_at_idx")
  @@map("parcel_run_ping")
}

/// An ordered list of stations a company serves — its own map, and the
/// thing a rate card can finally key on (ADR-0006). A run may cite a
/// route or stand alone: an ad-hoc vehicle at the door has to be
/// openable without a manager defining a route first.
model ParcelRoute {
  id          String    @id @default(uuid()) @db.Uuid
  parcelOrgId String    @db.Uuid
  org         ParcelOrg @relation(fields: [parcelOrgId], references: [id], onDelete: Cascade)

  name   String
  /// Short form for manifests and labels ("NBO-KSM"). Unique within one
  /// company's own book, not across the platform.
  code   String?
  active Boolean @default(true)

  createdAt DateTime @default(now())

  stops      ParcelRouteStop[]
  runs       ParcelShipment[]
  labelStock ParcelLabelStock[]

  @@index([parcelOrgId, active], map: "parcel_route_org_idx")
  @@map("parcel_route")
}

/// One stop on a route. sequence is dense and 0-based within a route; a
/// LEG is simply a consecutive pair of stops, which is why there is no
/// leg table — a parcel riding two vehicles is already expressible as
/// two ParcelShipmentItem rows with load/offload times.
model ParcelRouteStop {
  id      String      @id @default(uuid()) @db.Uuid
  routeId String      @db.Uuid
  route   ParcelRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  sequence  Int
  /// Restrict, not SetNull: a stop with no station is not a stop, and
  /// blanking one would renumber a route under a dispatcher mid-journey.
  stationId String      @db.Uuid
  station   ParcelAgent @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([routeId, sequence], map: "parcel_route_stop_route_seq_key")
  @@index([stationId], map: "parcel_route_stop_station_idx")
  @@map("parcel_route_stop")
}

/// Admin-editable cover levels a sender can buy against declared value
/// — same "admin-owned rate card" shape ParcelPricingRule already
/// follows. The fee is feeKes + declaredValue × feePct, and maxCoverKes
/// caps what a claim can ever pay out regardless of what was declared
/// (a sender declaring a million shillings on a boda parcel buys the
/// tier's ceiling, not their own number).
model ParcelCoverageTier {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  maxCoverKes Decimal @db.Decimal(12, 2)
  feeKes      Decimal @default(0) @db.Decimal(10, 2)
  feePct      Decimal @default(0) @db.Decimal(5, 2)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  parcels Parcel[]

  @@map("parcel_coverage_tier")
}

/// One failed doorstep attempt, append-only — the same shape and the
/// same reasoning as ParcelHandoff: Parcel's own lastAttempt* columns
/// are a denormalised "most recent" for list queries, and this table is
/// the record that can actually be reconstructed. Three attempts with
/// three different reasons is a very different conversation with a
/// receiver than one, and the columns alone can't tell them apart.
model ParcelDeliveryAttempt {
  id       String @id @default(uuid()) @db.Uuid
  parcelId String @db.Uuid
  parcel   Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  /// The courier who tried — always set; an attempt with nobody
  /// attached is not evidence of anything.
  byPartyId String  @db.Uuid
  /// NOBODY_HOME | WRONG_ADDRESS | REFUSED | NO_DELIVERY_CODE |
  /// UNREACHABLE | OTHER. Plain string for the same reason podMethod is.
  reason    String
  /// Required when reason is OTHER — see the "any Other choice needs a
  /// paired free-text field" rule this codebase follows everywhere else.
  note      String?

  lat Decimal? @db.Decimal(10, 7)
  lng Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now())

  @@index([parcelId, createdAt])
  @@map("parcel_delivery_attempt")
}

/// One global admin-editable rate — deliberately not a per-zone-pair
/// rate matrix (see the plan's explicit deferral note); every zone-to-
/// zone price is this same perKmKes times the haversine distance
/// between the two zones (see dbx.HaversineKm), floored at
/// minChargeableKm so a same-zone delivery isn't priced as free.
model ParcelDistanceRate {
  id              String  @id @default(uuid()) @db.Uuid
  perKmKes        Decimal @db.Decimal(10, 2)
  minChargeableKm Decimal @default(1) @db.Decimal(6, 2)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("parcel_distance_rate")
}

/// A courier's own location, posted while their "Nearby jobs" tab is
/// open (see handlers_parcels.go's pings handler) — mirrors
/// VehiclePing's exact shape (fleet.go/schema.prisma's Trip vertical)
/// for the same reason: one row per ping, latest-per-courier read via
/// DISTINCT ON, no separate "current position" column to keep in sync.
model ParcelCourierPing {
  id             String        @id @default(uuid()) @db.Uuid
  courierPartyId String        @db.Uuid
  courier        ParcelCourier @relation(fields: [courierPartyId], references: [partyId], onDelete: Cascade)
  lat            Decimal       @db.Decimal(10, 7)
  lng            Decimal       @db.Decimal(10, 7)
  at             DateTime      @default(now())

  @@index([courierPartyId, at])
  @@map("parcel_courier_ping")
}

// ─────────────────────────── TICKETING ──────────────────────────
// Event companies, tour/travel operators and transport (bus/matatu
// SACCO) companies onboard the same way a shop does: a Party runs an
// Enterprise, an Enterprise opens a TicketOrg — no parallel merchant
// identity system, same reasoning as Store. See docs/proposals/
// esoqo-ticketing-platform.md for the full design brief.

enum TicketVertical {
  EVENTS
  TRANSPORT
}

enum TicketOrgStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

model TicketOrg {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  name     String
  slug     String          @unique
  vertical TicketVertical
  status   TicketOrgStatus @default(DRAFT)

  description     String?
  logoUrl         String?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  physicalAddress String?
  /// M-Pesa number settlements should be paid to. Informational, same
  /// as Store.settlementPhone — actual payouts run through the ledger.
  settlementPhone String?

  /// Loyalty points for ticket buyers — same idea as Store.loyaltyEnabled,
  /// off by default, the organiser opts in.
  loyaltyEnabled Boolean @default(false)
  /// Points granted per whole KES spent on a paid booking. See
  /// Store.loyaltyPerKes — one pool per organiser, not per listing.
  loyaltyPerKes  Int     @default(1)

  /// "Lipia pole pole" — lets a buyer book a future, general-admission
  /// trip now with a deposit and clear the balance in M-Pesa top-ups
  /// before departure. Off by default, the organiser opts in, same as
  /// loyaltyEnabled. Tickets are issued only once the balance is fully
  /// paid (see createBooking / confirmBookingPayment in dal/ticketing.ts).
  installmentsEnabled Boolean @default(false)
  /// Smallest deposit accepted to open an installment plan, as a percent
  /// of the booking total (floored at MIN_INSTALLMENT_KES in domain).
  minDepositPercent   Int     @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff       TicketOrgStaff[]
  venues      Venue[]
  routes      Route[]
  listings    Listing[]
  customers   TicketCustomer[]
  vehicles    FleetVehicle[]
  crew        CrewMember[]
  shortRoutes ShortRoute[]
  trips       Trip[]
  staffGrants OrgStaffGrant[]
  luggage     LuggageTag[]

  @@index([enterpriseId])
  @@index([status])
  @@map("ticket_org")
}

/// A ticket buyer's loyalty identity, org-scoped — the ticketing
/// equivalent of StoreCustomer. Auto-captured at checkout the moment a
/// phone number is on a booking, signed-in or not, same "no deliberate
/// add-first step" reasoning as findOrCreateCustomer. `email` exists
/// here (not on StoreCustomer) because ticket issuance is the one flow
/// that regularly wants to notify by email as well as SMS.
model TicketCustomer {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  msisdn    String
  name      String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  loyalty  TicketLoyaltyEntry[]

  @@unique([orgId, msisdn])
  @@index([orgId, name])
  @@map("ticket_customer")
}

/// One move in a ticket customer's points balance — mirrors
/// LoyaltyEntry exactly (signed points, balance is derived by summing,
/// never stored). Kept as its own table rather than reusing
/// LoyaltyEntry because that table's customerId is a required FK into
/// StoreCustomer, which is Store-scoped; a TicketOrg is not a Store.
model TicketLoyaltyEntry {
  id         String         @id @default(uuid()) @db.Uuid
  customerId String         @db.Uuid
  customer   TicketCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Signed. Positive = earned on a paid booking; negative = redeemed.
  points    Int
  /// EARN | REDEEM | ADJUSTMENT
  kind      String
  note      String?
  bookingId String?  @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@map("ticket_loyalty_entry")
}

/// Org-scoped staff login — same shape as Cashier, not a Party. A
/// gate scanner on event night doesn't need (and shouldn't get) a
/// full Esoqo identity, just a PIN scoped to this one org.
///
/// ADMIN   — everything: listings, schedules, pricing, staff, payouts.
/// MANAGER — day-to-day ops: listings, schedules, bookings, check-in.
///           Never staff.write or org settings.
/// SCANNER — check-in only, nothing else. See dal/ticketing.ts
///           TICKETING_STAFF_CAPABILITIES.
model TicketOrgStaff {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  pinHash   String
  role      String   @default("SCANNER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set only for role = CREW: which CrewMember (driver/conductor) this
  /// PIN login actually is. A CREW login without this link can still
  /// declare cash (that write only checks org membership) but cannot
  /// close a trip — the trip.close:own capability requires this link to
  /// resolve, and to match the trip's own driverId/conductorId, before a
  /// crew session may close it. Deliberately not unique: a driver and a
  /// conductor on the same trip are two different CrewMember rows, and
  /// nothing stops one CrewMember having more than one PIN login over
  /// time (a replaced phone, say) if an org chooses to issue one.
  crewMemberId String?     @db.Uuid
  crewMember   CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)

  checkIns Ticket[]

  @@index([orgId])
  @@index([crewMemberId])
  @@map("ticket_org_staff")
}

/// Unified crew identity (docs/proposals/esoqo-unified-crew-identity.md):
/// makes `party` *eligible* to act as SCANNER/MANAGER/ADMIN/CREW staff
/// for `org`, replacing the AGENT-only TicketOrgStaff PIN login for
/// anyone who has (or is required to have) their own Esoqo account. A
/// grant alone authorises nothing — every org-scoped request also needs
/// a live org_context_activation, so requireCapability() never grants
/// these capabilities just because the grant row says "active".
///
/// status transitions:
///   active -> suspended    (an owner/manager kills the grant AND any
///                           live activation, immediately)
///   suspended -> active    (an owner/manager explicitly reinstates —
///                           never automatic, never self-service)
/// Reinstating does not restore a live activation; the next
/// activate-context attempt still requires OTP, same as any other
/// lapsed activation.
model OrgStaffGrant {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  partyId String @db.Uuid
  party   Party  @relation("OrgStaffGrantParty", fields: [partyId], references: [id], onDelete: Cascade)

  /// SCANNER | MANAGER | ADMIN | CREW — same bundle names as
  /// authsvc.TicketingStaffCapabilities; activation looks the role's
  /// capability list up from that same catalogue, never a copy here.
  role   String
  status String @default("active")

  grantedBy      String @db.Uuid
  grantedByParty Party  @relation("OrgStaffGrantGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)

  suspendedBy      String?   @db.Uuid
  suspendedByParty Party?    @relation("OrgStaffGrantSuspendedBy", fields: [suspendedBy], references: [id], onDelete: SetNull)
  suspendedAt      DateTime?

  /// Set only for role = CREW — same purpose as TicketOrgStaff's own
  /// crewMemberId (see that model's doc comment): which CrewMember
  /// (driver/conductor) this grant actually is, so trip.close:own can
  /// resolve it. A CREW grant with no link can still declare cash but
  /// never close a trip — fails closed, same as the AGENT path.
  crewMemberId String?     @db.Uuid
  crewMember   CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, partyId])
  @@index([partyId])
  @@index([crewMemberId])
  @@map("org_staff_grant")
}

/// Events vertical: where. Optional on Listing — a purely virtual
/// event has none.
model Venue {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  address   String?
  county    String?
  capacity  Int?
  createdAt DateTime @default(now())

  listings Listing[]

  @@index([orgId])
  @@map("venue")
}

/// Transport vertical: origin → destination. One Route can back many
/// Listings (a SACCO runs "Nairobi–Mombasa" every day as one route,
/// many scheduled departures).
model Route {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  originName      String
  destinationName String
  distanceKm      Int?
  createdAt       DateTime @default(now())

  listings Listing[]

  @@index([orgId])
  @@map("route")
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  CANCELLED
}

/// The sellable thing: an event ("Sauti Sol Live") or a service
/// ("Nairobi–Kisumu coach"). One Listing has many ticket classes
/// (price tiers) and many schedules (occurrences/departures) — the
/// classes are reused across every schedule of the same listing.
model Listing {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title         String
  slug          String        @unique
  description   String?
  coverImageUrl String?
  status        ListingStatus @default(DRAFT)

  venueId String? @db.Uuid
  venue   Venue?  @relation(fields: [venueId], references: [id])
  routeId String? @db.Uuid
  route   Route?  @relation(fields: [routeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketClasses TicketClass[]
  schedules     ListingSchedule[]
  seatMap       SeatMap?
  addons        Addon[]

  @@index([orgId, status])
  @@map("listing")
}

/// An optional paid extra the organiser offers on top of a ticket —
/// "WiFi KES 100", "Snacks KES 200", "Lunch KES 500". Distinct from
/// TicketClass.amenities: amenities are perks already baked into a
/// class's price and shown as badges; an Addon is its own line item a
/// buyer opts into per ticket, with its own price. Listing-scoped, not
/// per-class, so the same catalogue applies whichever seat a buyer picks.
model Addon {
  id        String  @id @default(uuid()) @db.Uuid
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  name     String
  priceKes Decimal @db.Decimal(12, 2)
  /// Soft-off switch — an organiser retiring "Lunch" shouldn't rewrite
  /// history on tickets that already have it.
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  ticketAddons TicketAddon[]

  @@index([listingId])
  @@map("addon")
}

/// One addon attached to one ticket, price snapshotted at booking
/// time — same reasoning as Ticket.priceKes: a later Addon price edit
/// must never rewrite what an already-issued ticket actually cost.
model TicketAddon {
  id       String  @id @default(uuid()) @db.Uuid
  ticketId String  @db.Uuid
  ticket   Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  addonId  String? @db.Uuid
  addon    Addon?  @relation(fields: [addonId], references: [id])

  name     String
  priceKes Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_addon")
}

enum ScheduleStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

/// One occurrence: a specific showtime, or a specific departure. Seats
/// (when a TicketClass is seated) are generated per schedule, not per
/// listing — the same coach's seat 12A is a fresh, independently
/// sellable slot on every departure.
model ListingSchedule {
  id        String  @id @default(uuid()) @db.Uuid
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  departAt           DateTime
  /// Trip arrival estimate, or an event's advertised end time. Optional.
  arriveAt           DateTime?
  /// "Gate B", "Platform 3", "Boarding from 6pm" — free text shown to
  /// ticket holders.
  gateInfo           String?
  /// Vehicle plate / hall name for this specific run, when it varies
  /// occurrence to occurrence.
  vehicleOrHallLabel String?
  status             ScheduleStatus @default(SCHEDULED)
  createdAt          DateTime       @default(now())

  seats    Seat[]
  bookings Booking[]

  @@index([listingId, departAt])
  @@map("listing_schedule")
}

/// A price tier — "VIP", "Regular", "Economy seat", "Business class".
/// `seated: true` means every schedule of this listing gets numbered
/// Seat rows for this class (generated at schedule-creation time);
/// `seated: false` means general admission, sold against `capacity`
/// (remaining = capacity − COUNT(valid tickets) for that schedule).
model TicketClass {
  id        String  @id @default(uuid()) @db.Uuid
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  name        String
  priceKes    Decimal  @db.Decimal(12, 2)
  seated      Boolean  @default(false)
  /// Per-schedule capacity. For seated classes this is also how many
  /// Seat rows get generated per schedule — kept in sync with
  /// SeatMapSeat's count for this class whenever the organiser saves a
  /// seat map (see dal/seat-map.ts), so this stays the source of truth
  /// even for listings with no map (plain GA-style seated classes).
  capacity    Int
  /// Fixed perk tags — "WIFI", "SNACKS", "CHARGING", "RECLINING",
  /// "EXTRA_LEGROOM", "BLANKET". A short closed set (not a free-text
  /// list) so the public listing can render them as consistent badges
  /// instead of parsing arbitrary buyer-facing copy.
  amenities   String[] @default([])
  /// Anything not covered by the fixed tag set — "USB port", free text,
  /// shown alongside the badges.
  amenityNote String?
  createdAt   DateTime @default(now())

  seats        Seat[]
  tickets      Ticket[]
  seatMapSeats SeatMapSeat[]

  @@index([listingId])
  @@map("ticket_class")
}

/// The organiser's one-time seat layout for a listing — "this bus is
/// 11 rows of 2+2" — reused to generate identical Seat rows on every
/// new schedule (see createSchedule), instead of the old plain
/// sequential-number fallback. One per listing; a listing with no
/// SeatMap still works exactly as before (createSchedule falls back to
/// numbering seats 1..capacity per seated class).
model SeatMap {
  id        String  @id @default(uuid()) @db.Uuid
  listingId String  @unique @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  rows    Int
  /// "1+1" | "2+1" | "2+2" | "3+2" — seats either side of the aisle.
  /// Informational for re-rendering the builder; the actual seat
  /// positions live in SeatMapSeat regardless of this value.
  pattern String

  seats     SeatMapSeat[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("seat_map")
}

/// One position in the layout — "3B" — and which ticket class currently
/// owns it. This is the template; actual bookable Seat rows are
/// generated fresh per schedule from this list (see createSchedule).
model SeatMapSeat {
  id            String      @id @default(uuid()) @db.Uuid
  seatMapId     String      @db.Uuid
  seatMap       SeatMap     @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  ticketClassId String      @db.Uuid
  ticketClass   TicketClass @relation(fields: [ticketClassId], references: [id], onDelete: Cascade)

  label String

  @@unique([seatMapId, label])
  @@index([ticketClassId])
  @@map("seat_map_seat")
}

enum SeatStatus {
  AVAILABLE
  BOOKED
}

/// A numbered seat for one schedule of one seated ticket class —
/// "12A" on the 6am Nairobi–Mombasa coach. Claimed atomically inside
/// createBooking's transaction (status AVAILABLE → BOOKED), which is
/// the whole double-booking guard; there is no separate hold/TTL step
/// in v1.
model Seat {
  id            String          @id @default(uuid()) @db.Uuid
  scheduleId    String          @db.Uuid
  schedule      ListingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  ticketClassId String          @db.Uuid
  ticketClass   TicketClass     @relation(fields: [ticketClassId], references: [id], onDelete: Cascade)

  label  String
  status SeatStatus @default(AVAILABLE)

  ticket Ticket?

  @@unique([scheduleId, label])
  @@index([ticketClassId, status])
  @@map("seat")
}

enum BookingStatus {
  PENDING_PAYMENT
  /// Installment plan open — a deposit (and maybe some top-ups) have
  /// cleared but the balance is still owed. Tickets not yet issued.
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum BookingPaymentMethod {
  MPESA_STK
  CASH
  VOUCHER
}

/// A checkout — mirrors StoreOrder. The buyer need not be a
/// registered Esoqo subject; buyerParty is set only when they are.
model Booking {
  id         String          @id @default(uuid()) @db.Uuid
  scheduleId String          @db.Uuid
  schedule   ListingSchedule @relation(fields: [scheduleId], references: [id])

  buyerPartyId String? @db.Uuid
  buyerParty   Party?  @relation(fields: [buyerPartyId], references: [id])
  buyerName    String
  buyerMsisdn  String
  /// Optional — a guest checkout can leave this out. Used for ticket
  /// issuance/notification alongside SMS, never a login identifier.
  buyerEmail   String?

  /// The org-scoped loyalty identity this booking earned points on.
  /// Auto-captured at checkout the same way buyerName/buyerMsisdn are —
  /// set whether or not buyerPartyId is, since a signed-in subject and
  /// a guest earn points the same way.
  ticketCustomerId String?         @db.Uuid
  ticketCustomer   TicketCustomer? @relation(fields: [ticketCustomerId], references: [id])

  status        BookingStatus        @default(PENDING_PAYMENT)
  paymentMethod BookingPaymentMethod @default(MPESA_STK)
  totalKes      Decimal              @db.Decimal(12, 2)

  /// "Lipia pole pole" plan — deposit now, balance in M-Pesa top-ups
  /// before departure. When true, payments run through BookingPayment
  /// (not the single mpesaCheckoutRequestId below), no seat/GA capacity
  /// is held during the plan, and Ticket rows are created only once
  /// amountPaidKes reaches totalKes.
  isInstallment Boolean   @default(false)
  /// Sum of every CONFIRMED BookingPayment. 0 for a plain full-payment
  /// booking; not authoritative there (its single payment is tracked by
  /// mpesaCheckoutRequestId / status).
  amountPaidKes Decimal   @default(0) @db.Decimal(12, 2)
  /// Installment plans only — the balance must be cleared by this time
  /// (the schedule's departAt). Past it, an unpaid plan is swept to
  /// CANCELLED (see sweepOverdueInstallmentBookings).
  balanceDueBy  DateTime?
  /// Installment plans only — the lines to issue as Tickets once the
  /// balance is fully paid: [{ ticketClassId, holderName?, holderMsisdn?,
  /// addonIds? }]. Null for plain bookings, which issue tickets inline.
  plannedLines  Json?

  mpesaCheckoutRequestId String?       @unique
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])
  voucherId              String?       @db.Uuid

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  tickets        Ticket[]
  payments       BookingPayment[]
  loyaltyEntries TicketLoyaltyEntry[]

  @@index([scheduleId, status])
  @@map("booking")
}

/// One M-Pesa payment against a booking. A plain full-payment booking
/// never creates one (it uses Booking.mpesaCheckoutRequestId). An
/// installment booking ("lipia pole pole") gets one per push — the
/// opening DEPOSIT, any number of INSTALLMENT top-ups, and the final
/// BALANCE that clears the plan. confirmBookingPayment matches the
/// M-Pesa callback here by checkoutRequestId, marks it CONFIRMED, and
/// rolls the amount into Booking.amountPaidKes.
model BookingPayment {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amountKes Decimal @db.Decimal(12, 2)
  /// DEPOSIT | INSTALLMENT | BALANCE
  kind      String
  /// PENDING | CONFIRMED | FAILED
  status    String  @default("PENDING")

  mpesaCheckoutRequestId String?   @unique
  mpesaReceiptCode       String?
  createdAt              DateTime  @default(now())
  confirmedAt            DateTime?

  @@index([bookingId, status])
  @@map("booking_payment")
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

/// One issued seat/slot. `code` is the QR/barcode token scanned at
/// the gate. `priceKes` is snapshotted at booking time so a later
/// TicketClass price change never rewrites history.
model Ticket {
  id            String      @id @default(uuid()) @db.Uuid
  bookingId     String      @db.Uuid
  booking       Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketClassId String      @db.Uuid
  ticketClass   TicketClass @relation(fields: [ticketClassId], references: [id])
  seatId        String?     @unique @db.Uuid
  seat          Seat?       @relation(fields: [seatId], references: [id])

  code         String       @unique
  holderName   String?
  holderMsisdn String?
  priceKes     Decimal      @db.Decimal(12, 2)
  status       TicketStatus @default(VALID)

  checkedInAt   DateTime?
  checkedInById String?         @db.Uuid
  checkedInBy   TicketOrgStaff? @relation(fields: [checkedInById], references: [id])

  createdAt DateTime @default(now())

  addons  TicketAddon[]
  /// Bags this passenger checked in — see LuggageTag.ticketId. Optional
  /// on that side: plenty of passengers board without a digital ticket.
  luggage LuggageTag[]

  @@index([bookingId])
  @@index([status])
  @@map("ticket")
}

// ─────────────────── TRANSPORT FLEET / SHORT ROUTES ─────────────
// Org-scoped (reusable per transport company, same as TicketOrg).
// Long-haul reserved-seat booking (Route/Listing/Schedule/Booking)
// is untouched; these tables cover town/matatu short hops: fleet
// registry, crew roster, duty trips, stage fares, onboard fare
// payments, GPS pings and cash declarations. All writes go through
// services/core-go (Go is the sole DB writer); this schema is DDL
// source of truth only.

enum FleetVehicleStatus {
  ACTIVE
  GROUNDED
}

model FleetVehicle {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  plateNo  String
  capacity Int?
  label    String?
  status   FleetVehicleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips Trip[]

  @@unique([orgId, plateNo])
  @@index([orgId, status])
  @@map("fleet_vehicle")
}

enum CrewRole {
  DRIVER
  CONDUCTOR
}

model CrewMember {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name   String
  msisdn String?
  role   CrewRole
  active Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivenTrips    Trip[]                  @relation("TripDriver")
  conductedTrips Trip[]                  @relation("TripConductor")
  declarations   CollectionDeclaration[]
  /// Bags this crew member put aboard / handed back — see LuggageTag.
  luggageBoarded LuggageTag[]            @relation("LuggageBoardedBy")
  luggageClaimed LuggageTag[]            @relation("LuggageClaimedBy")
  /// PIN logins linked to this person — see TicketOrgStaff.crewMemberId.
  staffLogins    TicketOrgStaff[]
  /// SUBJECT staff grants linked to this person — see
  /// OrgStaffGrant.crewMemberId, the AGENT-retirement replacement.
  staffGrants    OrgStaffGrant[]

  @@index([orgId, role, active])
  @@map("crew_member")
}

model ShortRoute {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  stages FareStage[]
  trips  Trip[]

  @@index([orgId, active])
  @@map("short_route")
}

model FareStage {
  id           String     @id @default(uuid()) @db.Uuid
  shortRouteId String     @db.Uuid
  shortRoute   ShortRoute @relation(fields: [shortRouteId], references: [id], onDelete: Cascade)

  /// Parcels booked to come off at this stage — see Parcel.dropStageId.
  parcelDrops  Parcel[]
  /// Passenger bags coming off here — see LuggageTag.dropStageId.
  luggageDrops LuggageTag[]

  name    String
  order   Int
  fareKes Decimal @db.Decimal(12, 2)

  faresFrom FarePayment[] @relation("FareFrom")
  faresTo   FarePayment[] @relation("FareTo")

  @@unique([shortRouteId, order])
  @@index([shortRouteId])
  @@map("fare_stage")
}

enum TripStatus {
  ACTIVE
  CLOSED
}

/// What shape the crew left the vehicle in at end of shift — three
/// quick-chip codes rather than free text alone, so a fleet owner can
/// scan a fleet's worth of trips for anything needing attention without
/// reading every note. OK is not the default: a crew session must
/// affirmatively pick one when closing their own trip (see
/// dbx.CloseTrip) — a manager closing on their behalf may still close
/// without either, same as before this field existed.
enum TripEndStatus {
  OK
  NEEDS_FUEL
  NEEDS_REPAIR
}

model Trip {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  vehicleId String       @db.Uuid
  vehicle   FleetVehicle @relation(fields: [vehicleId], references: [id])

  driverId    String?     @db.Uuid
  driver      CrewMember? @relation("TripDriver", fields: [driverId], references: [id])
  conductorId String?     @db.Uuid
  conductor   CrewMember? @relation("TripConductor", fields: [conductorId], references: [id])

  shortRouteId String?     @db.Uuid
  shortRoute   ShortRoute? @relation(fields: [shortRouteId], references: [id])

  status    TripStatus     @default(ACTIVE)
  startedAt DateTime       @default(now())
  endedAt   DateTime?
  /// Set together, only at close — see TripEndStatus and dbx.CloseTrip.
  endStatus TripEndStatus?
  endNote   String?

  createdAt DateTime @default(now())

  qrToken     String?   @unique
  qrShortCode String?   @unique
  qrRotatedAt DateTime?

  pings        VehiclePing[]
  fares        FarePayment[]
  declarations CollectionDeclaration[]
  /// Parcels riding this trip — see Parcel.tripId. A passenger trip
  /// doubles as freight capacity that would otherwise travel empty.
  parcels      Parcel[]
  /// Passenger luggage tagged onto this run — see LuggageTag.tripId.
  luggage      LuggageTag[]

  @@index([orgId, status])
  @@index([vehicleId, status])
  @@map("trip")
}

model VehiclePing {
  id     String @id @default(uuid()) @db.Uuid
  tripId String @db.Uuid
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  lat Decimal  @db.Decimal(10, 7)
  lng Decimal  @db.Decimal(10, 7)
  at  DateTime @default(now())

  @@index([tripId, at])
  @@map("vehicle_ping")
}

enum FarePaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model FarePayment {
  id     String @id @default(uuid()) @db.Uuid
  tripId String @db.Uuid
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  stageFromId String?    @db.Uuid
  stageFrom   FareStage? @relation("FareFrom", fields: [stageFromId], references: [id])
  stageToId   String?    @db.Uuid
  stageTo     FareStage? @relation("FareTo", fields: [stageToId], references: [id])

  amountKes    Decimal           @db.Decimal(12, 2)
  /// MPESA_STK | CASH | VOUCHER
  method       String
  buyerMsisdn  String?
  buyerName    String?
  buyerPartyId String?           @db.Uuid
  voucherId    String?           @db.Uuid
  voucher      VoucherCard?      @relation("FareVoucher", fields: [voucherId], references: [id])
  status       FarePaymentStatus @default(PENDING)

  mpesaCheckoutRequestId String?       @unique
  mpesaReceiptCode       String?
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt     DateTime           @default(now())
  confirmedAt   DateTime?
  verifications FareVerification[]

  @@index([tripId, status])
  @@index([mpesaReceiptCode])
  @@index([buyerPartyId])
  @@map("fare_payment")
}

model CollectionDeclaration {
  id     String @id @default(uuid()) @db.Uuid
  tripId String @db.Uuid
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  crewId String     @db.Uuid
  crew   CrewMember @relation(fields: [crewId], references: [id])

  declaredCashKes Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@index([tripId])
  @@index([crewId])
  @@map("collection_declaration")
}

/// Where a bag is in its one short life.
///
/// Four states, not a parcel's eight, because a bag's journey is a
/// bracket rather than a chain: it goes on at boarding and comes off at
/// alighting, on one vehicle, with its owner sitting a few feet away.
/// UNCLAIMED is the only state nobody intends — it is set in bulk at
/// trip close for anything still aboard, which is what turns a pile of
/// forgotten bags into a worklist while the crew is still holding them.
enum LuggageStatus {
  /// Tagged at the desk or the stage, not yet scanned onto a vehicle.
  TAGGED
  /// Scanned aboard. The normal state for the length of a trip.
  ABOARD
  /// Handed back to the passenger.
  CLAIMED
  /// Still aboard when the trip closed. Not an error state — a signal.
  UNCLAIMED
}

/// How a bag was handed back — the honest record of a handover.
///
/// A boolean ("claimed: true") would flatten four materially different
/// events into one. STUB_SCAN is the designed path. OVERRIDE is a crew
/// member deciding, with a reason, to release a bag to someone who
/// cannot produce the stub — which will happen, and which the system's
/// job is to record rather than prevent. A month of override reasons is
/// the best available list of what to fix next.
enum LuggageClaimMethod {
  /// The passenger's tear-off stub was scanned. The designed path.
  STUB_SCAN
  /// The code was read off the stub and typed — a dead phone, a torn
  /// stub, a scanner that will not focus in the dark.
  CODE_TYPED
  /// Matched against the passenger's own ticket rather than a stub.
  TICKET_MATCH
  /// Released without a matching stub. Demands a reason; surfaces on
  /// the trip's close-out.
  OVERRIDE
}

/// One piece of passenger luggage, tagged onto one trip.
///
/// Deliberately NOT a Parcel, though the two share their pads
/// (ParcelLabelStock), their code minting (fleetqr) and their scanner
/// (/v1/scan/resolve). The operational shapes barely overlap:
///
///   - a parcel's receiver is a third party at the far end; a bag's
///     "receiver" is the person who handed it over, sitting in seat 14;
///   - a parcel's custody is a chain across couriers, agents and legs;
///     a bag's is a bracket on one vehicle;
///   - a parcel has a price, an SLA and a delivery code; a bag usually
///     rides free with the ticket and is claimed with a stub;
///   - a parcel's dominant failure is "never delivered"; a bag's is
///     "taken by the wrong passenger at an intermediate stage".
///
/// Parcel carries ~60 columns, of which ~50 are meaningless here
/// (receiverMsisdn, deliveryCode, COD, zones, coverage, payout splits,
/// slaDeadlineAt). Routing bags through it would mean a filter on every
/// parcel query and an exception to every parcel invariant, forever, to
/// save one migration now.
model LuggageTag {
  id String @id @default(uuid()) @db.Uuid

  /// LUG-… — checksummed, because this code is read aloud off a paper
  /// stub and typed by hand far more often than a parcel code is: the
  /// person asking is standing at a counter looking at it.
  code String @unique

  /// The vehicle run this bag is riding. Required, unlike a parcel's
  /// optional tripId: a bag with no trip is not something this system
  /// can help with, and allowing it would slowly recreate the parcel
  /// product badly.
  tripId String @db.Uuid
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// The passenger's ticket, when they hold one. Optional on purpose —
  /// plenty of people board and pay cash, and a luggage system that
  /// refuses them is one the crew stops using by lunchtime.
  ticketId String? @db.Uuid
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  /// Always captured, ticket or not. Only the surname and initial are
  /// printed on the tag (see the print component): enough for a
  /// conductor to call over a crowd, not enough to be a PII leak on
  /// adhesive.
  passengerName   String
  passengerMsisdn String?

  /// "2 of 3". The highest-value pair of columns here: it is what makes
  /// a missing bag visible at the moment of claiming rather than three
  /// hours later on a phone call. Pieces tagged together share a
  /// groupId so the claim screen can say "one still aboard".
  pieceNo    Int     @default(1)
  pieceCount Int     @default(1)
  /// Null for a single-piece tag. Set for every piece of a multi-piece
  /// group, including the first, so "the others in this group" is one
  /// indexed lookup rather than a join on passenger name.
  groupId    String? @db.Uuid

  /// Which stage it comes off at, when the route has named stages.
  /// Null means it rides to the terminus.
  dropStageId      String?    @db.Uuid
  dropStage        FareStage? @relation(fields: [dropStageId], references: [id])
  /// What prints in the largest type on the tag. Copied at tagging
  /// rather than read live off dropStage, the same freeze-the-promise
  /// rule Parcel.transportMode follows: the tag is already physically
  /// on the bag, and a later rename of a stage must not make the
  /// printed word disagree with the record.
  destinationLabel String

  /// Only recorded when an excess-weight fee actually applies — this is
  /// not a rate card and must not grow into one. The fee posts through
  /// the existing ledger like any other money.
  weightKg     Decimal? @db.Decimal(6, 2)
  excessFeeKes Decimal? @db.Decimal(10, 2)

  /// One photo at boarding. The whole damage dispute, settled — the
  /// same bracket logic Parcel.intakePhotoUrl/podPhotoUrl provides,
  /// collapsed to one end because a bag is handed back to the person
  /// who watched it go on.
  photoUrl String?

  status LuggageStatus @default(TAGGED)

  boardedAt       DateTime?
  boardedByCrewId String?     @db.Uuid
  boardedByCrew   CrewMember? @relation("LuggageBoardedBy", fields: [boardedByCrewId], references: [id])

  claimedAt           DateTime?
  claimedByCrewId     String?             @db.Uuid
  claimedByCrew       CrewMember?         @relation("LuggageClaimedBy", fields: [claimedByCrewId], references: [id])
  claimMethod         LuggageClaimMethod?
  /// Required by dbx.ClaimLuggage whenever claimMethod is OVERRIDE, and
  /// null otherwise. A release with no stub and no reason is the thing
  /// this column exists to make impossible to record silently.
  claimOverrideReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The boarding scan's hot path: "everything still aboard this trip",
  /// which is also the close-out sweep and the claim screen's sibling
  /// lookup.
  @@index([tripId, status])
  @@index([orgId, createdAt])
  @@index([groupId])
  @@index([ticketId])
  @@map("luggage_tag")
}

/// PRIMARY = esoko.app/o/{slug}; CUSTOM = the org's own domain
/// (JamiiDomain, ACTIVE) — see apps/jamii/src/middleware.ts, which is
/// the only writer of SiteVisit below and already resolves this same
/// distinction for routing, at zero extra DB cost to reuse it here.
enum DomainMode {
  PRIMARY
  CUSTOM
}

/// Day-bucketed, cookieless page-visit counter — the dashboard proposal's
/// "we don't even know how many people visit an Our Jamii page" gap.
/// One row per (org, logical page path, domain mode, day, referrer
/// host); a repeat hit within the same day increments `count` instead
/// of inserting a new row, so a viral page doesn't create one row per
/// visit. `path` is the visitor-facing logical path — "/", "/about",
/// "/c/{campaignId}" — normalised the same way whether the visitor
/// arrived via the primary domain or the org's own custom domain, so
/// the two can be compared side by side for the same page.
///
/// Deliberately NOT session/visitor-level — no cookie, no IP stored, no
/// way to reconstruct one person's path through the site. That's the
/// privacy trade this proposal explicitly chose (see the dashboard
/// proposal's sourced reference to cookieless self-hosted analytics
/// patterns), and it's also why this can't answer "time on page" —
/// that needs a client beacon, a deliberately separate, not-yet-built
/// instrumentation layer.
model SiteVisit {
  id           BigInt     @id @default(autoincrement())
  /// JamiiPage.organisationId's slug — not a foreign key. A visit
  /// counter must never fail to record because of a FK constraint on
  /// the hot request path; an orphaned slug (org later deleted) is a
  /// non-issue for a bucketed count with no other relation depending on it.
  slug         String
  path         String
  domainMode   DomainMode
  /// "" (not null) for a direct visit — Postgres treats NULL as
  /// distinct in a unique index, which would silently defeat the
  /// day-bucketing upsert below for every referrer-less hit.
  referrerHost String     @default("")
  day          DateTime   @db.Date
  count        Int        @default(1)

  @@unique([slug, path, domainMode, day, referrerHost])
  @@index([slug, day])
  @@map("site_visit")
}

/// One row per sendSms call, purely for cost visibility — see
/// packages/auth/src/sms.ts's own header. `estimatedCostKes` is a
/// configurable-per-message guess (SMS_COST_PER_MESSAGE_KES), not an
/// invoice reconciliation; good enough to answer "is this growing" and
/// "which purpose costs the most" without a billing-API integration.
model SmsSpend {
  id               String   @id @default(uuid()) @db.Uuid
  purpose          String
  estimatedCostKes Decimal  @db.Decimal(6, 2)
  provider         String
  createdAt        DateTime @default(now())

  @@index([purpose, createdAt])
  @@map("sms_spend")
}

// ── Esoqo voucher cards + unified loyalty + fare verification ──
// Go (services/core-go) is the sole writer; Prisma holds DDL only.

enum VoucherPurpose {
  FARE
  RENT
  SHOPPING
  GENERAL
  /// Employer-issued allowance, redeemable at a fleet route flagged
  /// acceptsVoucherPurpose FUEL — see dbx.IssueAllowanceVoucherBatch.
  FUEL
  /// Employer-issued allowance, redeemable the same way TRAVEL trips
  /// (ticketing bookings) accept a voucher payment method.
  TRAVEL
}

enum VoucherStatus {
  ACTIVE
  FROZEN
  EXPIRED
}

model VoucherCard {
  id                     String               @id @default(uuid()) @db.Uuid
  ownerPartyId           String               @db.Uuid
  giftedByPartyId        String?              @db.Uuid
  label                  String               @default("Voucher")
  purpose                VoucherPurpose       @default(GENERAL)
  status                 VoucherStatus        @default(ACTIVE)
  qrToken                String               @unique
  shortCode              String               @unique
  expiresAt              DateTime?
  mpesaCheckoutRequestId String?              @unique
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  entries                VoucherLedgerEntry[]
  fares                  FarePayment[]        @relation("FareVoucher")

  @@index([ownerPartyId, status])
  @@map("voucher_card")
}

/// An employer's one M-Pesa payment fanning out to N employee
/// FUEL/TRAVEL allowance vouchers — see dbx.IssueAllowanceVoucherBatch.
/// Vouchers themselves aren't minted until the payment confirms (same
/// "nothing exists until it's actually paid for" rule CreateStoreOrder
/// already follows), so this row is the batch's own pending state, not
/// a join table — employeePartyIds is a plain JSON array rather than N
/// separate rows because there's nothing per-employee to track here
/// beyond "was included in this batch"; each employee's own
/// VoucherCard row is where their individual balance/history lives.
model VoucherBatch {
  id                     String   @id @default(uuid()) @db.Uuid
  employerPartyId        String   @db.Uuid
  purpose                String
  label                  String
  amountPerEmployeeKes   Decimal  @db.Decimal(12, 2)
  employeePartyIds       Json
  /// PENDING | ISSUED.
  status                 String   @default("PENDING")
  mpesaCheckoutRequestId String?  @unique
  issuedCount            Int      @default(0)
  createdAt              DateTime @default(now())

  @@index([employerPartyId, createdAt])
  @@map("voucher_batch")
}

model VoucherLedgerEntry {
  id             String        @id @default(uuid()) @db.Uuid
  voucherId      String        @db.Uuid
  voucher        VoucherCard   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  points         Int
  kesEquiv       Decimal       @db.Decimal(12, 2)
  kind           String
  refId          String?
  journalEntryId String?       @unique @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([voucherId, createdAt])
  @@map("voucher_ledger_entry")
}

model PartyLoyaltyEntry {
  id        String   @id @default(uuid()) @db.Uuid
  partyId   String   @db.Uuid
  points    Int
  kind      String
  refId     String?
  createdAt DateTime @default(now())

  @@index([partyId, createdAt])
  @@map("party_loyalty_entry")
}

model FareVerification {
  id              String      @id @default(uuid()) @db.Uuid
  fareId          String      @db.Uuid
  fare            FarePayment @relation(fields: [fareId], references: [id], onDelete: Cascade)
  verifierPartyId String?
  verifierAgentId String?
  scopeTripId     String?     @db.Uuid
  result          String
  createdAt       DateTime    @default(now())

  @@index([fareId, createdAt])
  @@index([scopeTripId, createdAt])
  @@map("fare_verification")
}
