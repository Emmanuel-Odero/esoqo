// ════════════════════════════════════════════════════════════════════
//  Esoko — domain schema
//
//  Design notes that are load-bearing, not decoration:
//
//  · Party is abstract. A Person or an Organisation IS a Party.
//    The CECF platform's single polymorphic `Group` table is the
//    mistake this replaces.
//  · Attestation is the universal trust primitive. Every credential —
//    government registration, county licence, delivery confirmation,
//    field visit — is one row here. New issuers need no schema change.
//  · Balances are DERIVED from Posting. There is no balance column
//    anywhere, and there must never be one.
//  · ConsentGrant is not a boolean. It is a dated, purposed, revocable
//    record, because the Data Protection Act 2019 requires one.
//  · AuditEvent is hash-chained. Tampering breaks the chain.
// ════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────── PARTIES ───────────────────────────

enum PartyKind {
  PERSON
  ORGANISATION
}

/// Which front door a Party first registered through. Sets once, at
/// completeRegistration/ingestCecfRegistration time, from Registration.path
/// — Registration itself is a funnel record that gets superseded, so this
/// is the durable place admin reads "CECF Registrations" from.
enum SourceSystem {
  ESOKO
  CECF
}

enum OrgKind {
  CHAMA
  SELF_HELP_GROUP
  TABLE_BANKING
  WELFARE_GROUP
  CBO
  FBO
  COOPERATIVE
  SACCO
  NGO
  BUSINESS
  SCHOOL
  CLINIC
  MARKET_ASSOCIATION
  OTHER
}

model Party {
  id        String    @id @default(uuid()) @db.Uuid
  kind      PartyKind
  county    String
  ward      String?
  /// Below county, above ward. Optional — asked mainly of groups and
  /// businesses, who tend to know these as-registered; individuals
  /// aren't pushed for it.
  subCounty String?
  /// Kenya's pre-2013 administrative unit. Some registration paperwork
  /// (group constitutions, old business permits) still cites it, so we
  /// keep it as free text rather than trying to derive it from county.
  district  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — DPA erasure keeps the audit trail
  /// Which front door this Party first registered through. See SourceSystem.
  sourceSystem SourceSystem @default(ESOKO)

  person                 Person?
  organisation           Organisation?
  enterprises            Enterprise[]
  memberships            Membership[]      @relation("MemberParty")
  accounts               Account[]
  attestations           Attestation[]     @relation("AttestationSubject")
  consentsGiven          ConsentGrant[]    @relation("ConsentSubject")
  documents              Document[]
  registration           Registration?
  groupJoinRegistrations Registration[]    @relation("RegistrationGroupParty")
  bizJoinRegistrations   Registration[]    @relation("RegistrationBizParty")
  storeOrdersAsBuyer     StoreOrder[]
  donationsAsDonor       Donation[]
  jamiiTeamMemberships   JamiiTeamMember[]
  jamiiApplications      JamiiInterest[]
  bookingsAsBuyer        Booking[]

  // ── Group treasury ──
  meetingsCalled          Meeting[]                    @relation("MeetingCalledBy")
  attendanceRecords       AttendanceRecord[]           @relation("AttendanceParty")
  attendanceMarkedByMe    AttendanceRecord[]           @relation("AttendanceMarkedBy")
  groupSignerships        GroupSigner[]                @relation("GroupSignerParty")
  contributionsMade       GroupContribution[]          @relation("ContributionParty")
  contributionsIConfirmed GroupContribution[]          @relation("ContributionConfirmedBy")
  withdrawalsRequested    WithdrawalRequest[]          @relation("WithdrawalRequestedBy")
  withdrawalSignatures    WithdrawalSignature[]        @relation("WithdrawalSignerParty")
  esokoPaymentId          EsokoPaymentId?
  creditInsightSnapshots  GroupCreditInsightSnapshot[]

  @@index([county, kind])
  @@index([createdAt])
  @@map("party")
}

model Person {
  partyId String @id @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  /// Name as written on the national ID. Used only when a credential is issued.
  officialName   String
  /// What people actually call them. This is what the product uses day to day.
  knownAs        String?
  /// MSISDN in E.164. THE identifier for anyone who can log in, dial
  /// USSD or receive SMS. Null means a staff-added member with no phone
  /// on file yet — pending until someone fills it in.
  msisdn         String? @unique
  /// SHA-256 of the national ID number. The raw number is never stored.
  nationalIdHash String? @unique
  email          String? @db.Citext
  gender         String?
  yearOfBirth    Int?

  msisdnVerifiedAt DateTime?
  emailVerifiedAt  DateTime?

  /// Display preferences. Persisted server-side deliberately, so they
  /// follow the person across devices and channels rather than living
  /// in one browser's localStorage.
  displayPrefs Json @default("{}")

  credential UserCredential?

  @@index([msisdn])
  @@map("person")
}

model Organisation {
  partyId String @id @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  kind              OrgKind
  /// Free text when kind is OTHER — same shape as businessTypeOther below,
  /// just for the group-kind picker (join flow, admin's Groups screen,
  /// self-serve /me/group) rather than the business-type one.
  kindOther         String?
  officialName      String
  knownAs           String?
  /// Registration number, if held. Verified via Attestation, never trusted raw.
  registrationNo    String?
  memberCount       Int?
  formedOn          DateTime?
  /// What most members deal in — "juakali", "carpentry", "masonry" —
  /// keyed against the same segment dictionary individuals pick their
  /// own work from, so group and personal tags stay comparable.
  tags              String[]  @default([])
  /// Only meaningful when kind is BUSINESS: sole proprietorship,
  /// partnership, limited company, cooperative, etc. Free text in
  /// businessTypeOther when the picked value is "OTHER".
  businessType      String?
  businessTypeOther String?
  /// Business-only: not yet registered, but says they plan to be.
  intendsToRegister Boolean?

  members   Membership[] @relation("MemberOrg")
  jamiiPage JamiiPage?

  // ── Group treasury ──
  meetings           Meeting[]
  treasuryPolicy     GroupTreasuryPolicy?
  signers            GroupSigner[]
  contributions      GroupContribution[]
  withdrawalRequests WithdrawalRequest[]

  @@index([kind])
  @@map("organisation")
}

enum MemberRole {
  CHAIRPERSON
  TREASURER
  SECRETARY
  MEMBER
  OTHER
}

/// PENDING is only reachable via a group with a joinFeeKes set on its
/// GroupTreasuryPolicy — see createJoinFeePayment/confirmContribution in
/// dal/treasury.ts, which flips PENDING -> ACTIVE once the fee's
/// GroupContribution is confirmed. Every other join path (self-founding,
/// staff addMember/addNewMember, an invite to a group with no fee) skips
/// straight to ACTIVE, same as before this status existed.
enum MembershipStatus {
  PENDING
  ACTIVE
}

model Membership {
  id         String           @id @default(uuid()) @db.Uuid
  personId   String           @db.Uuid
  orgId      String           @db.Uuid
  role       MemberRole       @default(MEMBER)
  /// Free text position, set only when role is OTHER — "Youth rep",
  /// "Auditor", whatever the group actually calls it. Ignored otherwise.
  customRole String?
  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime         @default(now())
  exitedAt   DateTime?

  person Party        @relation("MemberParty", fields: [personId], references: [id], onDelete: Cascade)
  org    Organisation @relation("MemberOrg", fields: [orgId], references: [partyId], onDelete: Cascade)

  joinFeePayments GroupContribution[] @relation("JoinFeeMembership")

  @@unique([personId, orgId])
  @@index([orgId, role])
  @@index([orgId, status])
  @@map("membership")
}

/// The economic unit. A party may run more than one.
model Enterprise {
  id                String   @id @default(uuid()) @db.Uuid
  partyId           String   @db.Uuid
  party             Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// Free text as the user typed it — "carpentry", "seremala", "mama mboga".
  workRaw           String
  /// Resolved segment key from the shared dictionary.
  segment           String?
  sector            String?
  isRegistered      Boolean  @default(false)
  hasKraPin         Boolean  @default(false)
  /// Operational detail, gathered mainly when the enterprise belongs to
  /// a business Organisation rather than an individual's side-hustle.
  employeeCount     Int?
  revenueGoodDayKes Decimal? @db.Decimal(12, 2)
  revenueBadDayKes  Decimal? @db.Decimal(12, 2)
  bankProvider      String?
  paymentChannels   String[] @default([])
  createdAt         DateTime @default(now())

  stores     Store[]
  ticketOrgs TicketOrg[]

  @@index([segment])
  @@index([sector])
  @@map("enterprise")
}

// ─────────────────────── AUTH & CREDENTIALS ─────────────────────

model UserCredential {
  personId       String    @id @db.Uuid
  person         Person    @relation(fields: [personId], references: [partyId], onDelete: Cascade)
  /// Argon2id. Never anything else, never hand-rolled.
  pinHash        String?
  pinSetAt       DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  frozenAt       DateTime? // SIMAMA — instant freeze from any handset
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("user_credential")
}

enum OtpPurpose {
  REGISTRATION
  SIGN_IN
  PIN_RESET
  STEP_UP
  CONSENT_GRANT
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  msisdn      String
  purpose     OtpPurpose
  /// HMAC-SHA256(code, OTP_PEPPER). The code itself is never stored.
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  ip          String?

  @@index([msisdn, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenge")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @db.Citext
  tokenHash String    @unique
  partyId   String?   @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("email_verification")
}

// ───────────────────────── ATTESTATIONS ─────────────────────────

enum ClaimType {
  MSISDN_VERIFIED
  EMAIL_VERIFIED
  NATIONAL_ID_CONFIRMED
  GROUP_REGISTERED
  BUSINESS_REGISTERED
  KRA_PIN
  ETIMS_ACTIVE
  MEDIATION_TRAINED
  SINGLE_BUSINESS_PERMIT
  FOOD_HANDLER
  HEALTH_CLEARANCE
  SECTOR_LICENCE
  FIELD_VISIT
  DELIVERY_CONFIRMED
  TRADING_RECORD
  /// CECF staff reviewed a Jamii page's registration + treasurer-ID
  /// documents and are satisfied the org is who its page says it is.
  ORG_PAGE_VERIFIED
}

enum AttestationMethod {
  MANUAL
  API
  DOCUMENT
  FIELD_VISIT
  SELF_DECLARED
}

/// The universal trust primitive. Adding an issuer must never require
/// a migration — that is the whole point of this table.
model Attestation {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid
  subject   Party  @relation("AttestationSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  claimType  ClaimType
  claimValue Json      @default("{}")

  issuerOrgId  String?           @db.Uuid
  issuer       Issuer?           @relation(fields: [issuerOrgId], references: [id])
  issuerUserId String?           @db.Uuid
  method       AttestationMethod @default(MANUAL)

  evidenceRefs String[] @default([])
  confidence   Int      @default(100)

  issuedAt         DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revocationReason String?

  /// Signature over the canonical claim. Populated by services/credential.
  signature String?
  /// Hash chain within a subject's attestation history.
  prevHash  String?
  hash      String?

  @@index([subjectId, claimType])
  @@index([expiresAt])
  @@index([claimType, revokedAt])
  @@map("attestation")
}

/// A body with authority to issue claims. Ministry, county, bank, CECF.
model Issuer {
  id            String      @id @default(uuid()) @db.Uuid
  name          String      @unique
  shortName     String?
  kind          String // MINISTRY | COUNTY | AGENCY | JUDICIARY | BANK | INSURER | BUYER | NGO
  /// Which claim types this issuer is permitted to assert.
  allowedClaims ClaimType[] @default([])
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  attestations  Attestation[]
  consentGrants ConsentGrant[] @relation("ConsentGrantee")

  @@map("issuer")
}

// ──────────────────────────── CONSENT ───────────────────────────

enum ConsentPurpose {
  CREDIT_ASSESSMENT
  INSURANCE_QUOTE
  SUPPLY_CONTRACT
  COUNTY_LICENSING
  PROGRAMME_ENROLMENT
  /// A member sharing their GroupCreditInsightSnapshot (never the raw
  /// ledger) with a specific lender for a specific loan application.
  LOAN_UNDERWRITING
}

/// Not a boolean. A dated, purposed, revocable record — because the
/// Data Protection Act 2019 requires one and an auditor will ask for it.
model ConsentGrant {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid
  subject   Party  @relation("ConsentSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  granteeId String @db.Uuid
  grantee   Issuer @relation("ConsentGrantee", fields: [granteeId], references: [id])

  purpose      ConsentPurpose
  /// Field-level scope. Never "everything".
  scope        String[]       @default([])
  /// The exact wording shown to the subject when they agreed.
  wordingShown String
  channel      String // USSD | WEB | AGENT | IVR

  grantedAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revocationChannel String?

  accesses ConsentAccess[]

  @@index([subjectId, revokedAt])
  @@index([granteeId, expiresAt])
  @@map("consent_grant")
}

/// Every look, logged. Producible for the ODPC on request.
model ConsentAccess {
  id         String       @id @default(uuid()) @db.Uuid
  grantId    String       @db.Uuid
  grant      ConsentGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  accessedAt DateTime     @default(now())
  actorId    String?      @db.Uuid
  fields     String[]     @default([])
  ip         String?

  @@index([grantId, accessedAt])
  @@map("consent_access")
}

// ───────────────────────── LEDGER (money) ───────────────────────

enum AccountKind {
  WALLET
  ESCROW
  GROUP_SAVINGS
  FEE_INCOME
  SETTLEMENT
  SUSPENSE
  /// One per Store. Where checkout and PoS sales post; FEE_INCOME
  /// picks up the platform's cut on the same JournalEntry.
  STORE_REVENUE
  /// One per Campaign. Deliberately separate from GROUP_SAVINGS — a
  /// donor's gift to a named campaign never gets lent out table-banking
  /// style, and the org's own savings never look like donor money.
  CAMPAIGN_RECEIVED
}

model Account {
  id       String      @id @default(uuid()) @db.Uuid
  partyId  String?     @db.Uuid
  party    Party?      @relation(fields: [partyId], references: [id])
  kind     AccountKind
  currency String      @default("KES")
  openedAt DateTime    @default(now())
  closedAt DateTime?

  postings Posting[]
  campaign Campaign?

  contributions      GroupContribution[]
  withdrawalRequests WithdrawalRequest[]

  @@unique([partyId, kind, currency])
  @@index([kind])
  @@map("account")
}

/// Immutable. Balanced. Never updated, never deleted.
model JournalEntry {
  id             String   @id @default(uuid()) @db.Uuid
  reference      String   @unique
  description    String
  occurredAt     DateTime @default(now())
  recordedAt     DateTime @default(now())
  /// Idempotency key. M-Pesa callbacks arrive late, twice, or never.
  idempotencyKey String?  @unique

  postings          Posting[]
  storeOrder        StoreOrder?
  groupContribution GroupContribution?
  withdrawalRequest WithdrawalRequest?
  posSale           PosSale?
  donation          Donation?
  booking           Booking?

  @@index([occurredAt])
  @@map("journal_entry")
}

model Posting {
  id        String       @id @default(uuid()) @db.Uuid
  entryId   String       @db.Uuid
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String       @db.Uuid
  account   Account      @relation(fields: [accountId], references: [id])
  /// Positive = debit, negative = credit. Sum per entry MUST be zero.
  amount    Decimal      @db.Decimal(18, 2)
  currency  String       @default("KES")

  @@index([accountId, entryId])
  @@map("posting")
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH_TO_AGENT
  /// Pesapal-hosted card checkout — see RegistrationPayment.pesapalOrderTrackingId.
  CARD
}

enum ApprovalDecision {
  APPROVE
  REJECT
}

enum PaymentStatus {
  NOT_DECLARED
  DECLARED
  UNDER_REVIEW
  CONFIRMED
  REJECTED
  WAIVED
}

// ─────────────────────── REGISTRATION FUNNEL ────────────────────

enum RegistrationStatus {
  STARTED
  AWAITING_OTP
  VERIFIED
  COMPLETE
  ABANDONED
}

enum JoinPath {
  SELF_WEB
  SELF_USSD
  AGENT_ASSISTED
  COHORT
  /// Ingested from the CECF WordPress site's own registration flow, via
  /// ingestCecfRegistration — never entered through /join directly.
  CECF_WEB
}

/// Funnel record. Deliberately separate from Party so an abandoned
/// registration never becomes a counted user — the failure that made
/// CECF's numbers meaningless.
model Registration {
  id      String             @id @default(uuid()) @db.Uuid
  partyId String?            @unique @db.Uuid
  party   Party?             @relation(fields: [partyId], references: [id])
  status  RegistrationStatus @default(STARTED)
  path    JoinPath           @default(SELF_WEB)

  joiningAs             String // me | group | biz
  officialName          String?
  knownAs               String?
  msisdn                String?
  email                 String? @db.Citext
  county                String?
  ward                  String?
  workRaw               String?
  segment               String?
  orgName               String?
  orgKnownAs            String?
  orgRole               String?
  memberCount           Int?
  hasRegisteredBusiness String?
  registrationNo        String?
  belongsToGroup        String?
  groupName             String?
  /// Set when the joiner picked an existing group from the search, not
  /// just typed a name — this is what actually links them via Membership.
  groupPartyId          String? @db.Uuid
  groupParty            Party?  @relation("RegistrationGroupParty", fields: [groupPartyId], references: [id])
  /// "group" | "self" — only asked when belongsToGroup is "yes".
  feeCoverage           String?
  hasKraPin             String?

  /// The group's own OrgKind (CBO/SHG/CHAMA/... — see GROUP_KINDS),
  /// location below county, and member-tags, only asked when creating
  /// a brand-new group rather than joining one found by search.
  orgKind      String?
  orgSubCounty String?
  orgDistrict  String?
  orgTags      String[] @default([])

  /// Business sub-flow. bizPartyId mirrors groupPartyId — set when the
  /// joiner picked an existing business from the live search, which is
  /// what stops a duplicate Organisation being created on completion.
  bizName              String?
  bizIsRegistered      String? // yes | no
  bizIntendsToRegister String? // only asked when bizIsRegistered = no
  bizPartyId           String?  @db.Uuid
  bizParty             Party?   @relation("RegistrationBizParty", fields: [bizPartyId], references: [id])
  bizSector            String?
  bizType              String?
  bizTypeOther         String?
  bizEmployeeCount     Int?
  bizRevenueGoodKes    Decimal? @db.Decimal(12, 2)
  bizRevenueBadKes     Decimal? @db.Decimal(12, 2)
  bizBankProvider      String?
  bizPaymentChannels   String[] @default([])

  /// Explicit opt-ins. Nothing is sent that was not asked for.
  wantsPriceSms   Boolean @default(false)
  wantsReceiptSms Boolean @default(true)
  wantsExpirySms  Boolean @default(true)

  ussdSetupChoice  String? // now | later
  msisdnVerifiedAt DateTime?
  emailSentAt      DateTime?

  agentId   String? @db.Uuid
  language  String  @default("en")
  ip        String?
  userAgent String?

  /// Highest join-flow step this registration has reached (1 = picked
  /// who's joining, up through the final verify-and-finish step). The
  /// only granular drop-off signal — `status` alone only distinguishes
  /// STARTED/AWAITING_OTP/VERIFIED/COMPLETE/ABANDONED, not which of the
  /// in-progress steps someone actually got stuck on.
  lastStep Int @default(1)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  /// Soft void. A deleted registration keeps its audit trail.
  voidedAt    DateTime?
  voidedById  String?   @db.Uuid
  voidReason  String?

  payment   RegistrationPayment?
  documents Document[]

  @@index([status, startedAt])
  @@index([county])
  @@index([msisdn, status])
  @@map("registration")
}

/// A payment declared for a registration. Not money — just what the
/// joiner or an officer says. Only the signature chain moves it to
/// CONFIRMED.
model RegistrationPayment {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @unique @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  method            PaymentMethod?
  reference         String?        @db.Citext
  amountKes         Decimal?       @db.Decimal(12, 2)
  declaredNote      String?
  declaredAt        DateTime?
  status            PaymentStatus  @default(NOT_DECLARED)
  confirmedAt       DateTime?
  /// Daraja's CheckoutRequestID for a live STK push, set the moment the
  /// push is sent. Doubles as the idempotency guard for a callback that
  /// arrives twice — see StoreOrder.mpesaCheckoutRequestId for the same
  /// pattern in the storefront.
  checkoutRequestId String?        @unique
  /// Pesapal's OrderTrackingId for a card checkout, set the moment
  /// initiatePesapalOrder returns. Same idempotency role as
  /// checkoutRequestId above, just for the /webhooks/pesapal/ipn callback.
  pesapalOrderTrackingId String?   @unique
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  approvals PaymentApproval[]

  @@index([status])
  @@map("registration_payment")
}

/// A single signature in the dual-control chain. One REJECT halts.
model PaymentApproval {
  id         String              @id @default(uuid()) @db.Uuid
  paymentId  String              @db.Uuid
  payment    RegistrationPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  approverId String              @db.Uuid
  approver   StaffUser           @relation(fields: [approverId], references: [id])
  decision   ApprovalDecision
  note       String?
  /// HMAC-SHA256(paymentId|approverId|decision|signedAt, SESSION_SECRET)
  signature  String
  signedAt   DateTime
  ip         String?

  @@unique([paymentId, approverId])
  @@index([paymentId])
  @@map("payment_approval")
}

// ───────────────────────────── DOCUMENTS ────────────────────────

enum DocumentStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  SUPERSEDED
}

// ─────────────────────── STORES & COMMERCE ──────────────────────
//
// A Store belongs to an Enterprise, not a new signup silo — the owner
// is already a registered, credentialed Party before a store can exist.
// Money still moves through Account/JournalEntry/Posting; this is the
// interim TypeScript-DAL implementation of that posting, not a second
// ledger. See docs/adr and services/ledger/README.md.

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum StoreRoutingMode {
  PATH // esoko.global/@slug — free, always available
  SUBDOMAIN // slug.esoko.global — priced via PricingRule
}

model Store {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  name         String
  /// URL-safe, unique across the platform regardless of routing mode —
  /// a store keeps the same slug if it later adds a subdomain.
  slug         String           @unique
  status       StoreStatus      @default(DRAFT)
  themeKey     String           @default("market")
  routingMode  StoreRoutingMode @default(PATH)
  /// Reserved for a future custom-domain phase. Not resolved anywhere yet.
  customDomain String?          @unique
  posEnabled   Boolean          @default(false)
  /// Toggle the KRA eTIMS fiscal-device flow for receipts issued at
  /// this store. When on, every receipt gets a serial unique to the push.
  etimsEnabled Boolean          @default(false)

  /// Loyalty points worth? A gift card in Kenya is `ongea points`.
  loyaltyEnabled Boolean @default(false)
  /// Points granted per whole KES of sale, at the terminal AND on the
  /// storefront — one loyalty pool per store.
  loyaltyPerKes  Int     @default(1)

  /// Whether the storefront offers cash on delivery at checkout, in
  /// addition to M-Pesa STK. Off by default — the seller opts in.
  codEnabled Boolean @default(false)

  // ── EStore profile ────────────────────────────────────────────
  // Business identity a customer-facing storefront shows. `name` above
  // is the trading name; these hold the registered/legal details and
  // contact info. All optional — a store sells fine without them, the
  // storefront just shows less.

  /// Registered/legal business name, where it differs from the trading name.
  legalName          String?
  /// KRA PIN or business registration number, shown in the storefront's
  /// business identity block.
  registrationNumber String?
  /// A named person customers can ask for ("Ask for Mama Njeri").
  contactPerson      String?
  contactEmail       String?
  /// +254 format, same convention as customer/supplier phones.
  contactPhone       String?
  physicalAddress    String?

  /// One-line pitch under the store name on the storefront hero.
  tagline           String?
  /// Long-form story — where the goods come from, how the shop started.
  /// Shown as the storefront's About section. Plain text.
  aboutUs           String?
  logoStorageKey    String?
  /// Public URL served via /img/{key}, same pattern as ProductImage.
  logoUrl           String?
  faviconStorageKey String?
  faviconUrl        String?

  /// Brand accent override — a hex colour that beats the theme accent
  /// when set, so a store with its own colours doesn't need a new theme.
  brandAccent String?

  instagram String?
  facebook  String?
  tiktok    String?
  whatsapp  String?
  linkedin  String?

  /// The category the store mostly trades in — one of PRODUCT_CATEGORIES.
  primaryCategory String?
  /// Rough size of the catalogue ("how many things do you sell?").
  skuCount        Int?

  /// Where orders are packed/picked up from — "Juja Main, Kiambu".
  deliveryOrigin String?
  /// Free-text delivery areas served — "Juja, Thika, Ruiru".
  deliveryZones  String[] @default([])
  /// Typical turnaround in days (informational on the storefront).
  processingDays Int?

  /// Currency the store prices in — KES for everything today; kept on
  /// the profile so the storefront can label prices honestly if it ever
  /// changes.
  currency        String  @default("KES")
  /// VAT rate shown on the storefront when set (16 = 16%). Informational —
  /// online checkouts price in KES inclusive of nothing; how tax is
  /// collected is a fiscal-device (eTIMS) concern, not a profile one.
  taxRatePct      Int?
  /// M-Pesa number settlements should be paid to. Informational on the
  /// profile today — actual payouts run through the enterprise ledger.
  settlementPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products          Product[]
  orders            StoreOrder[]
  posSales          PosSale[]
  customers         StoreCustomer[]
  cashiers          Cashier[]
  shifts            Shift[]
  refunds           PosRefund[]
  receipts          Receipt[]
  fulfilmentOptions FulfilmentOption[]
  suppliers         Supplier[]
  stockPurchases    StockPurchase[]
  photos            StorePhoto[]

  @@index([enterpriseId])
  @@index([status])
  @@map("store")
}

/// Photo-gallery images a store puts on its storefront — the shopfront
/// itself, a new delivery bike, whatever makes the store real. Same
/// storage-key discipline as ProductImage: opaque key, public URL via
/// /img, never served as a static asset.
model StorePhoto {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    String   @db.Uuid
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([storeId])
  @@map("store_photo")
}

model Product {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name             String
  description      String?
  /// One of PRODUCT_CATEGORIES in @esoko/domain. Not a DB enum — that
  /// list is edited in application code, same reasoning as `status`
  /// below: a new category should never need a migration.
  category         String?
  priceKes         Decimal          @db.Decimal(12, 2)
  /// Null = untracked (a service, or stock the merchant doesn't count).
  stockQty         Int?
  /// Sell-by-order: the merchant doesn't hold the stock (or holds little),
  /// and fulfils once the buyer orders — "available on order". Order-first
  /// keeps working capital out of stock, the model MSMEs can actually run.
  availableOnOrder Boolean          @default(false)
  /// Cost of goods — what the merchant paid, needed to show gross profit.
  /// Optional: a business that doesn't track cost sees revenue only.
  costKes          Decimal?         @db.Decimal(12, 2)
  /// Retail unit the price refers to — "kg", "pc", "dozen", "litre"…
  /// Plain text so a mango seller can write "bunch" without a migration.
  unit             String?
  /// Unit the merchant bought the stock in — often differs from `unit`
  /// above: a tomato trader buys a crate by the kilo and sells by the
  /// piece. costKes/stockQty above describe this purchase quantity, so
  /// knowing it turns "paid KES 3,000 for 100" into "KES 30 per kilo"
  /// instead of silently assuming the buy and sell units are the same.
  purchaseUnit     String?
  /// When set, the product sells by variant instead of by itself: the
  /// storefront shows the label ("500g", "Blue", "1kg") with the variant's
  /// own price and stock. base priceKes acts as the default variant price.
  variants         ProductVariant[]
  /// ACTIVE | HIDDEN | SUSPENDED. A plain string, not an enum — a
  /// merchant hiding their own product is a listing decision the
  /// platform doesn't need to model as a state machine. SUSPENDED is
  /// the one value a merchant cannot set themselves — see reviewedById
  /// below; setProductVisibility refuses to touch a suspended product.
  status           String           @default("ACTIVE")
  /// Staff moderation — mirrors Document's reviewNote/reviewedById/
  /// reviewedAt shape below, same reasoning: who suspended it, why,
  /// and when, so a merchant asking "why is my product down" gets a
  /// real answer instead of "the system did it".
  reviewNote       String?
  reviewedById     String?          @db.Uuid
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         ProductImage[]
  orderItems     StoreOrderItem[]
  posSaleItems   PosSaleItem[]
  staffNotes     ProductStaffNote[]
  stockPurchases StockPurchase[]

  @@index([storeId, status])
  @@index([category])
  @@map("product")
}

/// A running conversation between staff and a merchant about one
/// product — separate from a suspension's single reviewNote because a
/// product can get more than one comment over time ("fix the price" now,
/// "thanks, reinstating" later), and both sides of that history matter.
model ProductStaffNote {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  staffId   String   @db.Uuid
  note      String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@map("product_staff_note")
}

model ProductImage {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @db.Uuid
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Opaque R2 object key — never the client's filename (see storage.ts).
  /// Needed to actually delete the object when the image or product is
  /// removed; `url` alone (the public-facing address) isn't reliably
  /// reversible back to a key.
  storageKey String
  url        String
  position   Int     @default(0)

  @@index([productId])
  @@map("product_image")
}

/// A sellable option of a Product — "500g"/"Blue"/"1kg". Has its own
/// price and stock, so a duka can price a soda by size without editing
/// the parent on every price change. A product with variants sells via
/// these; see Product.variants.
model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// What the customer sees — "500g", "Red", "1kg bolle".
  label            String
  /// Its own price — the base product price is the default.
  priceKes         Decimal  @db.Decimal(12, 2)
  /// Null = untracked stock, same meaning as Product.stockQty.
  stockQty         Int?
  /// Order-first, same meaning as Product.availableOnOrder — a variant
  /// the merchant fulfils once ordered rather than holding stock.
  availableOnOrder Boolean  @default(false)
  costKes          Decimal? @db.Decimal(12, 2)
  /// Optional barcode/EAN for the option.
  sku              String?

  posItems       PosSaleItem[]
  orderItems     StoreOrderItem[]
  stockPurchases StockPurchase[]

  @@index([productId])
  @@map("product_variant")
}

/// How a storefront order is fulfilled — "Pick up at the kiosk" or
/// "Boda delivery". The buyer picks one at checkout; the fee is added
/// to the order. Managed by the merchant from settings.
model FulfilmentOption {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// PICKUP | DELIVERY
  kind   String
  /// "Pickup at Kawangware", "Boda — same day"
  label  String
  /// Fee on top of the basket, KES. 0 for free collection.
  feeKes Decimal @default(0) @db.Decimal(12, 2)
  active Boolean @default(true)

  orders StoreOrder[]

  @@index([storeId, active])
  @@map("fulfilment_option")
}

enum StoreOrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
}

enum StoreOrderPaymentMethod {
  MPESA_STK
  CASH_ON_DELIVERY
}

/// A checkout on the public storefront. The buyer need not be a
/// registered Esoko subject — buyerParty is set only when they are.
model StoreOrder {
  id           String  @id @default(uuid()) @db.Uuid
  storeId      String  @db.Uuid
  store        Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  buyerPartyId String? @db.Uuid
  buyerParty   Party?  @relation(fields: [buyerPartyId], references: [id])
  buyerName    String
  buyerMsisdn  String

  status        StoreOrderStatus        @default(PENDING_PAYMENT)
  paymentMethod StoreOrderPaymentMethod @default(MPESA_STK)
  totalKes      Decimal                 @db.Decimal(12, 2)

  /// Checkout fulfilment — which option the buyer chose and what the
  /// delivery/pickup fee added. Empty until a FulfilmentOption exists.
  deliveryOptionId String?           @db.Uuid
  deliveryOption   FulfilmentOption? @relation(fields: [deliveryOptionId], references: [id])
  deliveryFeeKes   Decimal?          @db.Decimal(12, 2)
  /// Free-text note for the shop — "hand to Joshua at gate three".
  collectionNotes  String?
  /// Where a DELIVERY order goes — street/estate/landmark, plain text
  /// captured at checkout. Tracked so COD and last-mile delivery have a
  /// real destination on record.
  deliveryAddress  String?

  /// Cross-channel customer account, when the phone already belongs to a
  /// StoreCustomer (auto-created at checkout or matched by msisdn).
  customerId String?        @db.Uuid
  customer   StoreCustomer? @relation(fields: [customerId], references: [id])

  /// Daraja's CheckoutRequestID. Doubles as the idempotency guard for
  /// a callback that arrives twice — see JournalEntry.idempotencyKey.
  mpesaCheckoutRequestId String?       @unique
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  /// Staff-mediated reroute — set when this store can't fulfil the
  /// order and staff need to hand-pick another vendor selling the same
  /// thing. Deliberately not an automated reassignment: money and a
  /// merchant's reputation are on the line, so a human stays in the
  /// loop. Only meaningful before payment moves — see reassignOrder.
  needsReroute       Boolean   @default(false)
  rerouteReason      String?
  rerouteFlaggedById String?   @db.Uuid
  rerouteFlaggedAt   DateTime?

  items                 StoreOrderItem[]
  receipts              Receipt[]
  customerLedgerEntries CustomerLedgerEntry[]
  loyaltyEntries        LoyaltyEntry[]

  @@index([storeId, status])
  @@index([needsReroute])
  @@map("store_order")
}

model StoreOrderItem {
  id           String          @id @default(uuid()) @db.Uuid
  orderId      String          @db.Uuid
  order        StoreOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String          @db.Uuid
  product      Product         @relation(fields: [productId], references: [id])
  /// Set when the order picked a variant of the product.
  variantId    String?         @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  quantity     Int
  unitPriceKes Decimal         @db.Decimal(12, 2)
  /// Cost snapshot at sale time so gross profit survives later price edits.
  costKes      Decimal?        @db.Decimal(12, 2)

  @@index([orderId])
  @@map("store_order_item")
}

enum PosSyncStatus {
  PENDING // queued on-device, not yet reconciled
  SYNCED
  CONFLICT
}

enum PosPaymentMethod {
  CASH
  MPESA_TILL
  /// An STK push initiated from the terminal on the buyer's phone.
  MPESA_STK
  /// Goods leave the shop now, cash later — the credit book. Requires a
  /// customer (someone has to owe it). No money has moved yet, so this
  /// posts a CustomerLedgerEntry, not a commerce-ledger entry — see
  /// recordPosSale and recordCustomerPayment.
  ON_ACCOUNT
}

enum PosSaleStatus {
  COMPLETED
  REFUNDED
  VOID
}

/// A terminal sale. clientSaleId is generated on-device at the moment
/// of sale, offline or not — it is what makes a queued sale replayed
/// twice by the outbox harmless instead of double-counted.
model PosSale {
  id            String           @id @default(uuid()) @db.Uuid
  storeId       String           @db.Uuid
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clientSaleId  String           @unique
  paymentMethod PosPaymentMethod
  totalKes      Decimal          @db.Decimal(12, 2)
  /// Whole-receipt discount, subtracted from the basket before total.
  discountKes   Decimal          @default(0) @db.Decimal(12, 2)
  syncStatus    PosSyncStatus    @default(SYNCED)
  status        PosSaleStatus    @default(COMPLETED)
  /// When it happened on the device — may be well before syncedAt.
  soldAt        DateTime
  syncedAt      DateTime         @default(now())

  /// Cash drawer: what the customer handed over and the change returned.
  tenderedKes Decimal? @db.Decimal(12, 2)
  changeKes   Decimal? @db.Decimal(12, 2)

  /// The cashier behind the terminal (null for the owner selling directly).
  cashierId  String?        @db.Uuid
  cashier    Cashier?       @relation(fields: [cashierId], references: [id])
  /// The shift this sale belongs to — null when the store doesn't open shifts.
  shiftId    String?        @db.Uuid
  shift      Shift?         @relation(fields: [shiftId], references: [id])
  /// A cross-channel customer account, when the sale is charged or checked
  /// against one. Optional — a walk-in paid-cash sale needn't create one.
  customerId String?        @db.Uuid
  customer   StoreCustomer? @relation(fields: [customerId], references: [id])

  journalEntryId String?       @unique @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  items                 PosSaleItem[]
  refunds               PosRefund[]
  receipts              Receipt[]
  customerLedgerEntries CustomerLedgerEntry[]
  loyaltyEntries        LoyaltyEntry[]

  @@index([storeId, soldAt])
  @@index([storeId, status])
  @@index([shiftId])
  @@map("pos_sale")
}

model PosSaleItem {
  id           String          @id @default(uuid()) @db.Uuid
  saleId       String          @db.Uuid
  sale         PosSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String          @db.Uuid
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?         @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  quantity     Int
  unitPriceKes Decimal         @db.Decimal(12, 2)
  /// Per-line discount (negotiation, "regular" price).
  discountKes  Decimal         @default(0) @db.Decimal(12, 2)
  /// Cost snapshot at sale time — gross profit.
  costKes      Decimal?        @db.Decimal(12, 2)

  @@index([saleId])
  @@map("pos_sale_item")
}

// ──────────────────── SUPPLIERS & STOCK PURCHASES ────────────────

/// Who a merchant buys from — the milk vendor, the tomato wholesaler,
/// the guy who brings bread at 6am. Kept as its own record (not just
/// free text on a purchase) so contact details are entered once and
/// "everything I've bought from this supplier" is a real query, not a
/// grep through notes.
model Supplier {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases StockPurchase[]

  @@index([storeId, name])
  @@map("supplier")
}

/// One delivery of stock into the shop — what came in, from whom, at
/// what price, on what date. This is the other half of the profit
/// picture a sale alone can't give: an MSME here rarely sells at a
/// fixed price (milk goes for KES 10 one day, KES 100 the next,
/// tomatoes are haggled every time — see PosSaleItem.discountKes), so
/// knowing what a batch actually cost is what turns "I sold stuff
/// today" into "I made a profit today". Recording a purchase bumps the
/// product's stockQty and folds the cost into its running average —
/// see recordStockPurchase.
model StockPurchase {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  /// Null when the merchant doesn't want to name one — a bargained buy
  /// from someone passing through is still worth recording.
  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  quantity     Int
  unitCostKes  Decimal  @db.Decimal(12, 2)
  /// Denormalised (quantity × unitCostKes) so a purchase list never
  /// needs to recompute it, and it survives if unitCostKes rounding
  /// changes later.
  totalCostKes Decimal  @db.Decimal(12, 2)
  /// When the stock actually arrived — may be entered after the fact,
  /// so this is independent of createdAt.
  purchasedAt  DateTime @default(now())
  notes        String?

  createdAt DateTime @default(now())

  @@index([storeId, purchasedAt])
  @@index([productId])
  @@index([supplierId])
  @@map("stock_purchase")
}

// ─────────────────── CUSTOMERS, CREDIT & LOYALTY ─────────────────

/// A store's own customer account, keyed by phone. The same shopper may
/// exist across stores — they are per-store records, deliberately not a
/// second global Party, because credit books and points are a store's
/// private ledger. Created automatically at the first touchpoint
/// (checkout or an attended sale) and editable from the merchant's app.
model StoreCustomer {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  msisdn    String
  name      String?
  notes     String?
  /// How much the customer currently owes the shop. Derive from the
  /// ledger (sum of entries), never stored on the row — see the "balances
  /// are derived" rule in this schema's header.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger   CustomerLedgerEntry[]
  loyalty  LoyaltyEntry[]
  posSales PosSale[]
  orders   StoreOrder[]

  @@unique([storeId, msisdn])
  @@index([storeId, name])
  @@map("store_customer")
}

/// One move in a customer's money ledger — a sale on credit, a payment,
/// an adjustment. Amount is signed: a SALE on credit appears as a
/// positive (they owe that much more), a PAYMENT as a negative. Balance
/// = sum of all entries. Never mutate an entry once written.
model CustomerLedgerEntry {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @db.Uuid
  customer   StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// SALE | PAYMENT | REFUND | ADJUSTMENT
  kind      String
  /// Signed — see the model comment above.
  amountKes Decimal     @db.Decimal(12, 2)
  note      String?
  saleId    String?     @db.Uuid
  sale      PosSale?    @relation(fields: [saleId], references: [id])
  orderId   String?     @db.Uuid
  order     StoreOrder? @relation(fields: [orderId], references: [id])
  createdAt DateTime    @default(now())

  @@index([customerId, createdAt])
  @@map("customer_ledger_entry")
}

/// Loyalty points granted and redeemed against a customer. Balance is
/// derived the same way money is — never stored.
model LoyaltyEntry {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @db.Uuid
  customer   StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Signed. Positive = earned on a sale; negative = redeemed.
  points    Int
  /// EARN | REDEEM | ADJUSTMENT
  kind      String
  note      String?
  saleId    String?     @db.Uuid
  sale      PosSale?    @relation(fields: [saleId], references: [id])
  orderId   String?     @db.Uuid
  order     StoreOrder? @relation(fields: [orderId], references: [id])
  createdAt DateTime    @default(now())

  @@index([customerId, createdAt])
  @@map("loyalty_entry")
}

// ─────────────────────── CASHIERS & SHIFTS ──────────────────────

/// A counter operator with their own PIN, distinct from the owner's
/// sign-in. PIN is Argon2id-hashed (see seed.ts for the parameters).
/// Cashiers act as themselves on the terminal and are attached to the
/// sales they ring up; a manager/owner can draw the cash drawer, a plain
/// cashier cannot open the drawer without one.
model Cashier {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name      String
  pinHash   String
  /// CASHIER | MANAGER
  role      String   @default("CASHIER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts   Shift[]
  posSales PosSale[]
  refunds  PosRefund[]

  @@index([storeId])
  @@map("cashier")
}

/// One open/close of the register. A merchant watches the drawer by
/// opening a shift with the float in it, selling, then closing and
/// counting: the system already knows the expected cash from that
/// shift's sales (cash method minus cash refunds plus the still-open
/// float) and the variance is counted − expected.
model Shift {
  id        String  @id @default(uuid()) @db.Uuid
  storeId   String  @db.Uuid
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashierId String  @db.Uuid
  cashier   Cashier @relation(fields: [cashierId], references: [id])

  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openingFloatKes Decimal   @default(0) @db.Decimal(12, 2)
  /// Set when the shift closes: cash sales − cash refunds + opening float.
  expectedCashKes Decimal?  @db.Decimal(12, 2)
  /// What the drawer actually had, counted by the closing cashier.
  countedCashKes  Decimal?  @db.Decimal(12, 2)
  /// counted − expected. Positive = over, negative = short.
  varianceKes     Decimal?  @db.Decimal(12, 2)
  /// OPEN | CLOSED
  status          String    @default("OPEN")

  posSales PosSale[]

  @@index([storeId, openedAt])
  @@index([status])
  @@map("shift")
}

/// A refunded (or voided) PoS sale. Kept as a separate row so a sale's
/// history is never rewritten — the sale is marked REFUNDED and this
/// record carries who did it, why, and the amount returned.
model PosRefund {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @db.Uuid
  sale      PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  storeId   String   @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashierId String?  @db.Uuid
  cashier   Cashier? @relation(fields: [cashierId], references: [id])

  reason       String
  refundMethod PosPaymentMethod
  amountKes    Decimal          @db.Decimal(12, 2)
  createdAt    DateTime         @default(now())

  @@index([saleId])
  @@index([storeId, createdAt])
  @@map("pos_refund")
}

/// One receipt issued for a sale or an order — a fulfilment channel's
/// copy (print/SMS/WhatsApp). The same sale may have several receipts;
/// the merchant keeps a printable copy on file, and an SMS/WhatsApp copy
/// goes to the shopper. A KRA eTIMS serial, where the store has eTIMS
/// enabled, makes the receipt compliant with Kenya's VAT Act 2013 (as
/// amended) and the count published under the eTIMS regime.
model Receipt {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Human-facing, sequential per store: e.g. 000147.
  receiptNo   String      @unique
  saleId      String?     @db.Uuid
  sale        PosSale?    @relation(fields: [saleId], references: [id])
  orderId     String?     @db.Uuid
  order       StoreOrder? @relation(fields: [orderId], references: [id])
  totalKes    Decimal     @db.Decimal(12, 2)
  /// KRA eTIMS serial for fiscal receipts — null when eTIMS is off.
  etimsSerial String?
  /// PRINT | SMS | WHATSAPP
  channel     String
  /// SMS/WhatsApp target (the customer's msisdn); null for a printed copy.
  sentTo      String?
  issuedAt    DateTime    @default(now())

  @@index([storeId, issuedAt])
  @@index([saleId])
  @@map("receipt")
}

/// Pricing is data, not code — every fee shown anywhere in the store
/// wizard reads one of these rows. No process.env price constants.
model PricingRule {
  id            String     @id @default(uuid()) @db.Uuid
  /// SUBDOMAIN_SETUP_FEE | SUBDOMAIN_MONTHLY_FEE | POS_MONTHLY_FEE |
  /// PLATFORM_FEE_PCT, etc. — read by key, never hardcoded elsewhere.
  key           String     @unique
  label         String
  amountKes     Decimal?   @db.Decimal(12, 2)
  amountPct     Decimal?   @db.Decimal(5, 2)
  /// ONE_TIME | MONTHLY | PER_ORDER
  billingPeriod String
  updatedAt     DateTime   @updatedAt
  updatedById   String?    @db.Uuid
  updatedBy     StaffUser? @relation(fields: [updatedById], references: [id])

  @@map("pricing_rule")
}

model Document {
  id             String        @id @default(uuid()) @db.Uuid
  partyId        String?       @db.Uuid
  party          Party?        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// Attached during registration, before a Party exists.
  registrationId String?       @db.Uuid
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  /// What the person called it. Their words, not a dropdown.
  title        String
  kind         String @default("OTHER")
  /// Opaque storage key. NEVER the user's filename — that is a path
  /// traversal and content-sniffing vector.
  storageKey   String @unique
  /// Kept only for display and download naming. Sanitised on the way in.
  originalName String
  mimeType     String
  sizeBytes    Int
  /// SHA-256 of the bytes. Detects duplicates and tampering.
  sha256       String

  status       DocumentStatus @default(PENDING_REVIEW)
  reviewNote   String?
  reviewedById String?        @db.Uuid
  reviewedAt   DateTime?

  uploadedAt     DateTime  @default(now())
  uploadedByType String    @default("SUBJECT")
  uploadedById   String?
  deletedAt      DateTime?

  extracted     Json?
  ocrConfidence Int?

  @@index([partyId, kind])
  @@index([registrationId])
  @@index([status, uploadedAt])
  @@map("document")
}

// ─────────────────────── AUTH SESSIONS (audit) ──────────────────

/// Redis holds live sessions. This is the durable record for audit
/// and for "sign me out everywhere".
model SessionRecord {
  id        String    @id @default(uuid()) @db.Uuid
  partyId   String?   @db.Uuid
  tokenHash String    @unique
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  deviceId  String?

  @@index([partyId, revokedAt])
  @@map("session_record")
}

// ─────────────────────────── STAFF & RBAC ───────────────────────

model StaffUser {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.Citext
  name           String
  pinHash        String
  orgId          String?   @db.Uuid
  /// Preset the capabilities were derived from. Display only — the
  /// capability list is the model, not this.
  rolePreset     String?   @default("VIEWER")
  /// Optional scope. Empty means national.
  countyScope    String[]  @default([])
  invitedById    String?   @db.Uuid
  mustChangePin  Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  suspendedAt    DateTime?
  /// Capability strings, e.g. "registration.read", "audit.read",
  /// "attestation.issue:GROUP_REGISTERED". Never a role enum —
  /// roles are presets of these, not the model itself.
  capabilities   String[]  @default([])
  active         Boolean   @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  approvals           PaymentApproval[]
  pricingRulesUpdated PricingRule[]

  @@index([active, rolePreset])
  @@map("staff_user")
}

// ──────────────────────────── AUDIT LOG ─────────────────────────

/// Append-only, hash-chained. If a row is altered or removed the chain
/// breaks and `pnpm audit:verify` will say so.
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now())
  actorType  String // SUBJECT | STAFF | AGENT | SYSTEM | ISSUER
  actorId    String?
  action     String // registration.created, consent.granted, otp.sent …
  targetType String?
  targetId   String?
  payload    Json     @default("{}")
  ip         String?
  /// SHA-256 over (prevHash + canonical(row)). Chain root uses AUDIT_CHAIN_SEED.
  prevHash   String
  hash       String   @unique

  @@index([occurredAt])
  @@index([action, occurredAt])
  @@index([actorId])
  @@map("audit_event")
}

// ──────────────────────── REFERENCE DATA ────────────────────────

model County {
  code            String    @id
  name            String    @unique
  hasFieldOfficer Boolean   @default(false)
  pricesLive      Boolean   @default(false)
  population      String?
  financeActRef   String?
  verifiedOn      DateTime?

  markets Market[]
  permits Permit[]

  @@map("county")
}

model Market {
  id         String  @id @default(uuid()) @db.Uuid
  name       String
  countyCode String
  county     County  @relation(fields: [countyCode], references: [code])
  marketDays String?
  reporting  Boolean @default(false)

  prices PriceQuote[]

  @@unique([name, countyCode])
  @@map("market")
}

model Permit {
  id         String     @id @default(uuid()) @db.Uuid
  countyCode String
  county     County     @relation(fields: [countyCode], references: [code])
  name       String
  issuedBy   String
  feeText    String
  note       String?
  claimType  ClaimType?

  @@index([countyCode])
  @@map("permit")
}

model Commodity {
  id       String @id @default(uuid()) @db.Uuid
  name     String @unique
  unit     String
  category String // veg | cereal | fruit | live | goods

  prices PriceQuote[]

  @@map("commodity")
}

/// One quote, one market, one day. Absence is meaningful — the UI must
/// say "not submitted today" rather than repeat yesterday's figure.
model PriceQuote {
  id          String    @id @default(uuid()) @db.Uuid
  commodityId String    @db.Uuid
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  marketId    String    @db.Uuid
  market      Market    @relation(fields: [marketId], references: [id])
  priceKes    Decimal   @db.Decimal(12, 2)
  quotedFor   DateTime  @db.Date
  collectedAt DateTime  @default(now())
  source      String
  collectedBy String?

  @@unique([commodityId, marketId, quotedFor])
  @@index([quotedFor])
  @@map("price_quote")
}

// ═══════════════════════ OUR JAMII (CECF community pages) ═══════════
//
// A public mini-site + crowdfunding layer on top of the Party/
// Organisation an org already has everywhere else on the platform.
// Deliberately NOT a parallel "community org" identity system — see
// the file header. JamiiPage is 1:1 with Organisation the same way
// Person/Organisation are 1:1 with Party.

enum JamiiPageStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum JamiiTeamRole {
  ADMIN
  EDITOR
  CONTRIBUTOR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DonationStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum JamiiInterestStatus {
  NEW
  CONTACTED
  CONVERTED
  DISMISSED
}

model JamiiPage {
  organisationId String       @id @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [partyId], onDelete: Cascade)

  /// Public URL segment — ourjamii.esoko.../o/{slug}. Unique platform-wide.
  slug   String          @unique
  status JamiiPageStatus @default(DRAFT)

  /// One-line pitch, shown on Discover cards and the hero carousel.
  tagline      String?
  /// Short mission used in cards/carousel where space is tight.
  missionShort String?
  /// Long-form "About" body shown on the public page's About section.
  aboutUs      String?

  logoStorageKey  String?
  logoUrl         String?
  coverStorageKey String?
  coverUrl        String?
  brandAccent     String?

  /// Free text, e.g. "Wednesdays, 4pm · Nyalenda B Social Hall".
  meetingSchedule String?
  contactEmail    String?
  contactPhone    String?
  website         String?
  facebook        String?
  instagram       String?
  twitter         String?
  whatsapp        String?

  /// [{ q, a }] — small and static enough that a table would be
  /// overkill, same precedent as Person.displayPrefs.
  faq Json @default("[]")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  photos    JamiiPhoto[]
  posts     JamiiPost[]
  programs  JamiiProgram[]
  campaigns Campaign[]
  team      JamiiTeamMember[]
  domain    JamiiDomain?

  @@index([status])
  @@map("jamii_page")
}

/// Gallery images a page puts on its public profile. Same storage-key
/// discipline as StorePhoto: opaque key, public URL via /img.
model JamiiPhoto {
  id         String    @id @default(uuid()) @db.Uuid
  pageId     String    @db.Uuid
  page       JamiiPage @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  storageKey String
  url        String
  caption    String?
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([pageId])
  @@map("jamii_photo")
}

/// The "Updates" carousel on the public page.
model JamiiPost {
  id              String        @id @default(uuid()) @db.Uuid
  pageId          String        @db.Uuid
  page            JamiiPage     @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  title           String
  excerpt         String?
  body            String
  imageStorageKey String?
  imageUrl        String?
  status          PublishStatus @default(DRAFT)
  authorPartyId   String?       @db.Uuid
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([pageId, status])
  @@map("jamii_post")
}

/// The "Programs" accordion on the public page.
model JamiiProgram {
  id           String    @id @default(uuid()) @db.Uuid
  pageId       String    @db.Uuid
  page         JamiiPage @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  title        String
  body         String
  icon         String?
  position     Int       @default(0)
  linkedPostId String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([pageId])
  @@map("jamii_program")
}

/// Platform-wide "no photo yet" placeholders for a JamiiPage's media
/// slots (hero cover, gallery, post cover) — never per-org. `patternKey`
/// is a code-authored, trusted abstract SVG pattern (see apps/jamii's
/// illustration registry), not stored SVG markup: an org's own page
/// content is never rendered as raw HTML/SVG, so there's no
/// stored-XSS surface here even though this table is staff-editable.
/// Staff (jamii-media.manage) curate which patterns are on offer and
/// in what order; apps/jamii picks one per empty slot by category.
model JamiiMediaAsset {
  id         String              @id @default(uuid()) @db.Uuid
  key        String              @unique
  label      String
  category   JamiiMediaCategory
  patternKey String
  active     Boolean             @default(true)
  position   Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([category, active])
  @@map("jamii_media_asset")
}

enum JamiiMediaCategory {
  HERO
  GALLERY
  POST
}

/// Who may manage a page, and at what level — deliberately separate
/// from Membership (a person's real role in the group: chairperson,
/// treasurer, ...). A treasurer isn't necessarily who edits the page,
/// and a page editor need not be an office-holder.
model JamiiTeamMember {
  id          String        @id @default(uuid()) @db.Uuid
  pageId      String        @db.Uuid
  page        JamiiPage     @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  /// Null while an invite is pending and no Party/Person exists yet
  /// for that email/phone.
  personId    String?       @db.Uuid
  person      Party?        @relation(fields: [personId], references: [id])
  inviteName  String
  inviteEmail String
  role        JamiiTeamRole @default(EDITOR)
  invitedAt   DateTime      @default(now())
  acceptedAt  DateTime?
  removedAt   DateTime?

  @@unique([pageId, inviteEmail])
  @@index([personId])
  @@map("jamii_team_member")
}

/// A group's own domain (e.g. mchamawetu.org), linked to their JamiiPage
/// so the page reads as their website instead of a page on ours. 1:1 with
/// JamiiPage on purpose — one active domain per page keeps both the UX
/// and the security surface (ownership proof, TLS, staff moderation)
/// simple; relax to many if a real need for it shows up.
///
/// Ownership is proven two independent ways before status ever reaches
/// ACTIVE: Cloudflare's own Custom Hostname verification, and our own
/// verificationToken as a TXT record — defense in depth so activation
/// never rests on trusting one vendor's check alone. See
/// services/core/src/routes/jamii-domains.ts for the reconciler that
/// drives PENDING_DNS -> VERIFYING -> ACTIVE/FAILED, and
/// dal/jamii-domain.ts for why the Cloudflare API token itself never
/// reaches this app or the browser.
model JamiiDomain {
  id     String @id @default(uuid()) @db.Uuid
  pageId String @unique @db.Uuid
  page   JamiiPage @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)

  /// Lowercased, punycoded, no scheme/path. Unique platform-wide so two
  /// groups can't race the same domain, and never silently reused by a
  /// different page after removal.
  hostname String            @unique
  status   JamiiDomainStatus @default(PENDING_DNS)

  /// Random value shown to the group as a TXT record — our own proof of
  /// control, independent of Cloudflare's.
  verificationToken String

  /// Cloudflare Custom Hostname bookkeeping — opaque IDs/status only,
  /// never a secret.
  cfHostnameId  String?
  cfStatus      String?
  lastCheckedAt DateTime?
  failureReason String?

  requestedByPartyId String    @db.Uuid
  activatedAt        DateTime?
  removedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@map("jamii_domain")
}

enum JamiiDomainStatus {
  /// Just requested — group still needs to add the CNAME + TXT records.
  PENDING_DNS
  /// Records seen at least once; Cloudflare is issuing the certificate.
  VERIFYING
  /// Live — resolveJamiiDomain() will route traffic for this hostname.
  ACTIVE
  /// Cloudflare rejected it, or verification never completed in time.
  FAILED
  /// Staff kill-switch — moderateJamiiPage's sibling for domains.
  SUSPENDED
}

model Campaign {
  id      String         @id @default(uuid()) @db.Uuid
  pageId  String         @db.Uuid
  page    JamiiPage      @relation(fields: [pageId], references: [organisationId], onDelete: Cascade)
  title   String
  /// Unique per page, not platform-wide — routed as /o/{pageSlug}/c/{slug}.
  slug    String
  summary String
  body    String?
  goalKes Decimal        @db.Decimal(12, 2)
  status  CampaignStatus @default(DRAFT)

  coverStorageKey String?
  coverUrl        String?
  startsAt        DateTime?
  endsAt          DateTime?

  /// One dedicated ledger account per campaign, opened alongside it.
  /// Kept apart from the org's GROUP_SAVINGS account on purpose.
  accountId String?  @unique @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates   CampaignUpdate[]
  donations Donation[]

  @@unique([pageId, slug])
  @@index([status])
  @@map("campaign")
}

model CampaignUpdate {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  body       String
  postedAt   DateTime @default(now())

  @@index([campaignId, postedAt])
  @@map("campaign_update")
}

/// A gift to a campaign. Mirrors StoreOrder: donor is an optional
/// Party (giving never requires an account — "Anonymous" just means
/// donorPartyId is null), paid via the same M-Pesa STK flow as
/// checkout, settled as a balanced JournalEntry.
model Donation {
  id           String         @id @default(uuid()) @db.Uuid
  campaignId   String         @db.Uuid
  campaign     Campaign       @relation(fields: [campaignId], references: [id])
  donorPartyId String?        @db.Uuid
  donorParty   Party?         @relation(fields: [donorPartyId], references: [id])
  donorName    String         @default("Anonymous")
  donorMsisdn  String
  anonymous    Boolean        @default(false)
  amountKes    Decimal        @db.Decimal(12, 2)
  status       DonationStatus @default(PENDING)

  mpesaCheckoutRequestId String?       @unique
  mpesaReceiptCode       String?
  /// The ESK-##### code shown to the donor — our own reference,
  /// independent of the M-Pesa receipt.
  receiptCode            String?       @unique
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([campaignId, status])
  @@map("donation")
}

/// A lead, not a Party. Someone tried to register on Our Jamii
/// (apps/jamii) with a phone/email that isn't an existing CECF member's
/// Person record — access is gated to CECF members, so instead of a
/// dead end they can leave their details here. Deliberately its own
/// table rather than a Registration: a Registration implies "this is
/// someone going through the join funnel"; this is "someone was turned
/// away and asked to be followed up with," reviewed by Esoko staff in
/// the admin app (see App\Support in cecf-wordpress for the analogous
/// non-CECF-member redirect on the WordPress side, and this record's
/// counterpart CTA on /join).
/// An application for Our Jamii access — CONVERTED is what actually
/// grants sign-in (see hasJamiiAccess in dal/jamii-interest.ts), so
/// every first-time Our Jamii sign-in traces back to one of these being
/// approved, whether the applicant was a brand-new person or someone
/// who already had a CECF/Esoko account.
model JamiiInterest {
  id     String              @id @default(uuid()) @db.Uuid
  status JamiiInterestStatus @default(NEW)

  /// Set at submission time when the identifier they applied with
  /// matched an existing Person, or at approval time when staff approve
  /// a brand-new applicant and a Person gets created for them. Null in
  /// between — a pending brand-new application has no Party yet.
  personId String? @db.Uuid
  person   Party?  @relation(fields: [personId], references: [id])

  fullName         String
  msisdn           String
  email            String? @db.Citext
  county           String?
  /// The group/organisation they named, if any — free text, since by
  /// definition nothing here is linked to a real Party yet.
  organisationName String?
  message          String?

  reviewedByStaffId String?   @db.Uuid
  reviewNote        String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([personId])
  @@map("jamii_interest")
}

// ═══════════════════════ GROUP TREASURY ═══════════════════════
//
//  See docs/proposals/esoko-group-treasury-and-payment-id.md for the
//  reasoning behind every shape here. Load-bearing decisions:
//
//  · GroupContribution supports BOTH capture paths — self-declared
//    (officer-confirmed, like RegistrationPayment) and a live M-Pesa
//    STK push (auto-confirmed by the Daraja callback, like StoreOrder)
//    — a group picks per-contribution, not platform-wide.
//  · WithdrawalSignature mirrors PaymentApproval's shape (HMAC
//    signature, one REJECT halts) but signs against a Party, not a
//    StaffUser — a withdrawal signer is a group member, not staff.
//  · GroupTreasuryPolicy.activeHoursStart/End matter: the standby
//    window pauses outside them, so a request raised Saturday night
//    does not quietly expire while every signer is asleep.
//  · The signer set is group-configurable (GroupSigner), not hardcoded
//    to the three officer roles — a group may want an auditor or a
//    fourth signer beyond CHAIRPERSON/TREASURER/SECRETARY.

enum AttendanceMethod {
  SELF_APP
  SELF_USSD
  /// An officer marked on a member's behalf — same trust model as
  /// Registration's AGENT_ASSISTED join path, never anonymous:
  /// AttendanceRecord.markedById always names who did it.
  AGENT_MARKED
}

model Meeting {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @db.Uuid
  org         Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  scheduledAt DateTime
  /// Physical venue, "virtual", or a WhatsApp/call-in description.
  location    String?
  agenda      String?
  /// % of active members needed for this meeting to count as quorate.
  quorumPct   Int          @default(50)
  calledById  String       @db.Uuid
  calledBy    Party        @relation("MeetingCalledBy", fields: [calledById], references: [id])
  createdAt   DateTime     @default(now())
  closedAt    DateTime?

  attendance  AttendanceRecord[]
  withdrawals WithdrawalRequest[]

  @@index([orgId, scheduledAt])
  @@map("meeting")
}

model AttendanceRecord {
  id         String           @id @default(uuid()) @db.Uuid
  meetingId  String           @db.Uuid
  meeting    Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  personId   String           @db.Uuid
  person     Party            @relation("AttendanceParty", fields: [personId], references: [id])
  present    Boolean
  method     AttendanceMethod
  /// Set only when an officer marked on someone's behalf.
  markedById String?          @db.Uuid
  markedBy   Party?           @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  markedAt   DateTime         @default(now())

  @@unique([meetingId, personId])
  @@index([personId])
  @@map("attendance_record")
}

/// One row per group. Created lazily on first configuration — a group
/// with none yet runs on the hardcoded defaults below.
model GroupTreasuryPolicy {
  orgId String       @id @db.Uuid
  org   Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)

  requiredSigners       Int     @default(2)
  /// Minutes of active-hours time a withdrawal must broadcast for
  /// before it can execute. 70 is the product default, not a constant.
  withdrawalLeadMinutes Int     @default(70)
  /// The standby window only counts minutes inside this local-hour
  /// range — it pauses overnight and resumes at activeHoursStart.
  activeHoursStart      Int     @default(7)
  activeHoursEnd        Int     @default(20)
  requireQuorateMeeting Boolean @default(false)

  /// Whether this group runs contributions at all — officers can switch
  /// it off for a group that only ever does one-off collections, without
  /// losing the amount/cycle they'd already set.
  contributionsEnabled  Boolean  @default(true)
  contributionAmountKes Decimal? @db.Decimal(12, 2)
  /// "weekly" | "monthly" | "custom" | null (no fixed cycle).
  contributionCycle     String?

  /// Null or zero = free to join. Otherwise a new member's Membership is
  /// created PENDING and only activates once this amount is paid and
  /// confirmed — see createJoinFeePayment in dal/treasury.ts.
  joinFeeKes Decimal? @db.Decimal(12, 2)

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("group_treasury_policy")
}

/// Who may sign a withdrawal for this group — group-configurable, not
/// hardcoded to the three officer roles.
model GroupSigner {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  org       Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  personId  String       @db.Uuid
  person    Party        @relation("GroupSignerParty", fields: [personId], references: [id])
  addedAt   DateTime     @default(now())
  addedById String       @db.Uuid
  /// Soft removal — a past signer's historical signatures stay valid
  /// and attributed; they just stop counting toward new thresholds.
  removedAt DateTime?

  @@unique([orgId, personId])
  @@index([orgId, removedAt])
  @@map("group_signer")
}

/// A declaration is not money — same rule as RegistrationPayment. Only
/// an officer's confirmation (self-declared path) or Safaricom's own
/// STK callback (direct path) moves this to CONFIRMED and posts it.
model GroupContribution {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @db.Uuid
  org           Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  accountId     String       @db.Uuid
  account       Account      @relation(fields: [accountId], references: [id])
  contributorId String       @db.Uuid
  contributor   Party        @relation("ContributionParty", fields: [contributorId], references: [id])

  amountKes         Decimal        @db.Decimal(12, 2)
  method            PaymentMethod?
  reference         String?
  declaredNote      String?
  status            PaymentStatus  @default(DECLARED)
  declaredAt        DateTime       @default(now())
  confirmedAt       DateTime?
  confirmedById     String?        @db.Uuid
  confirmedBy       Party?         @relation("ContributionConfirmedBy", fields: [confirmedById], references: [id])
  /// Daraja's CheckoutRequestID for the direct-STK path — same
  /// idempotency guard as RegistrationPayment.checkoutRequestId.
  checkoutRequestId String?        @unique
  journalEntryId    String?        @unique @db.Uuid
  journalEntry      JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  /// Set only for a join-fee payment (createJoinFeePayment in
  /// dal/treasury.ts) — confirming this contribution also activates the
  /// PENDING membership it belongs to. Null for an ordinary contribution.
  membershipId      String?        @db.Uuid
  membership        Membership?    @relation("JoinFeeMembership", fields: [membershipId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([contributorId])
  @@map("group_contribution")
}

enum WithdrawalStatus {
  /// Broadcast sent, standby window open, signatures still being collected.
  PENDING_SIGNATURES
  /// Threshold reached once the window closed — waiting on execution.
  APPROVED
  EXECUTED
  /// Any one signer rejected. Halts immediately, does not wait for the window.
  REJECTED
  /// Window closed without reaching threshold. Must be re-raised, no silent retry.
  EXPIRED
}

model WithdrawalRequest {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  org       Organisation @relation(fields: [orgId], references: [partyId], onDelete: Cascade)
  accountId String       @db.Uuid
  account   Account      @relation(fields: [accountId], references: [id])
  meetingId String?      @db.Uuid
  meeting   Meeting?     @relation(fields: [meetingId], references: [id])

  requestedById String @db.Uuid
  requestedBy   Party  @relation("WithdrawalRequestedBy", fields: [requestedById], references: [id])

  amountKes   Decimal @db.Decimal(12, 2)
  purpose     String
  payeeName   String
  payeeMsisdn String?

  /// Snapshotted from GroupTreasuryPolicy at request time — a later
  /// policy change never reaches back into an in-flight request.
  requiredSigners Int
  broadcastAt     DateTime         @default(now())
  /// Computed from policy.withdrawalLeadMinutes, walked forward through
  /// activeHours — see computeStandbyOpensAt in dal/treasury.ts.
  standbyOpensAt  DateTime
  status          WithdrawalStatus @default(PENDING_SIGNATURES)
  decidedAt       DateTime?

  journalEntryId String?       @unique @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  signatures WithdrawalSignature[]

  @@index([orgId, status])
  @@index([standbyOpensAt])
  @@map("withdrawal_request")
}

/// One signer's decision. Deliberately mirrors PaymentApproval rather
/// than reusing it — PaymentApproval.approverId is FK'd to StaffUser
/// (an internal reviewer); this signs against a Party (a group member).
model WithdrawalSignature {
  id            String            @id @default(uuid()) @db.Uuid
  withdrawalId  String            @db.Uuid
  withdrawal    WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  signerId      String            @db.Uuid
  signer        Party             @relation("WithdrawalSignerParty", fields: [signerId], references: [id])
  decision      ApprovalDecision
  /// The signer's PIN was freshly verified at this instant — never
  /// queued or replayed, see ADR note in the treasury proposal doc.
  pinVerifiedAt DateTime
  /// HMAC-SHA256(withdrawalId|signerId|decision|signedAt, SESSION_SECRET)
  signature     String
  signedAt      DateTime
  ip            String?

  @@unique([withdrawalId, signerId])
  @@index([withdrawalId])
  @@map("withdrawal_signature")
}

// ─────────────────────── ESOKO PAYMENT ID ────────────────────────

/// A short, verified, portable payment handle — issued once a Party
/// holds at least MSISDN_VERIFIED (see Attestation), reusing the
/// existing trust primitive rather than inventing a new one.
model EsokoPaymentId {
  partyId     String    @id @db.Uuid
  party       Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// e.g. "ESK-4471-KE" — human-typeable, verified-unique.
  code        String    @unique
  activatedAt DateTime  @default(now())
  suspendedAt DateTime?

  @@index([code])
  @@map("esoko_payment_id")
}

/// A SNAPSHOT, not a live score — same reasoning as balances being
/// derived, not stored: recomputing fresh each time it's needed is
/// what keeps it honest. This row records "what was disclosed, when,
/// under what formula version," not a cache.
///
/// v1 inputs are strictly limited to events this schema already
/// produces — GroupContribution (consistency), AttendanceRecord
/// (reliability), WithdrawalSignature (responsiveness/reject-rate).
/// Loan-repayment behaviour is a deliberate v2 addition, once an
/// internal-lending feature actually produces a repayment/default
/// event to score against.
model GroupCreditInsightSnapshot {
  id                          String   @id @default(uuid()) @db.Uuid
  partyId                     String   @db.Uuid
  party                       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  formulaVersion              String
  contributionScore           Int
  attendanceScore             Int
  signatureScore              Int
  computedAt                  DateTime @default(now())
  /// Set only when this snapshot was generated to satisfy a specific
  /// ConsentAccess — most snapshots are member-facing only.
  disclosedViaConsentAccessId String?  @db.Uuid

  @@index([partyId, computedAt])
  @@map("group_credit_insight_snapshot")
}

// ─────────────────────────── TICKETING ──────────────────────────
// Event companies, tour/travel operators and transport (bus/matatu
// SACCO) companies onboard the same way a shop does: a Party runs an
// Enterprise, an Enterprise opens a TicketOrg — no parallel merchant
// identity system, same reasoning as Store. See docs/proposals/
// esoko-ticketing-platform.md for the full design brief.

enum TicketVertical {
  EVENTS
  TRANSPORT
}

enum TicketOrgStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

model TicketOrg {
  id           String     @id @default(uuid()) @db.Uuid
  enterpriseId String     @db.Uuid
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  name     String
  slug     String          @unique
  vertical TicketVertical
  status   TicketOrgStatus @default(DRAFT)

  description     String?
  logoUrl         String?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  physicalAddress String?
  /// M-Pesa number settlements should be paid to. Informational, same
  /// as Store.settlementPhone — actual payouts run through the ledger.
  settlementPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff    TicketOrgStaff[]
  venues   Venue[]
  routes   Route[]
  listings Listing[]

  @@index([enterpriseId])
  @@index([status])
  @@map("ticket_org")
}

/// Org-scoped staff login — same shape as Cashier, not a Party. A
/// gate scanner on event night doesn't need (and shouldn't get) a
/// full Esoko identity, just a PIN scoped to this one org.
///
/// ADMIN   — everything: listings, schedules, pricing, staff, payouts.
/// MANAGER — day-to-day ops: listings, schedules, bookings, check-in.
///           Never staff.write or org settings.
/// SCANNER — check-in only, nothing else. See dal/ticketing.ts
///           TICKETING_STAFF_CAPABILITIES.
model TicketOrgStaff {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  pinHash   String
  role      String   @default("SCANNER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns Ticket[]

  @@index([orgId])
  @@map("ticket_org_staff")
}

/// Events vertical: where. Optional on Listing — a purely virtual
/// event has none.
model Venue {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  address   String?
  county    String?
  capacity  Int?
  createdAt DateTime @default(now())

  listings Listing[]

  @@index([orgId])
  @@map("venue")
}

/// Transport vertical: origin → destination. One Route can back many
/// Listings (a SACCO runs "Nairobi–Mombasa" every day as one route,
/// many scheduled departures).
model Route {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  originName      String
  destinationName String
  distanceKm      Int?
  createdAt       DateTime @default(now())

  listings Listing[]

  @@index([orgId])
  @@map("route")
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  CANCELLED
}

/// The sellable thing: an event ("Sauti Sol Live") or a service
/// ("Nairobi–Kisumu coach"). One Listing has many ticket classes
/// (price tiers) and many schedules (occurrences/departures) — the
/// classes are reused across every schedule of the same listing.
model Listing {
  id    String    @id @default(uuid()) @db.Uuid
  orgId String    @db.Uuid
  org   TicketOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title         String
  slug          String        @unique
  description   String?
  coverImageUrl String?
  status        ListingStatus @default(DRAFT)

  venueId String? @db.Uuid
  venue   Venue?  @relation(fields: [venueId], references: [id])
  routeId String? @db.Uuid
  route   Route?  @relation(fields: [routeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketClasses TicketClass[]
  schedules     ListingSchedule[]

  @@index([orgId, status])
  @@map("listing")
}

enum ScheduleStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

/// One occurrence: a specific showtime, or a specific departure. Seats
/// (when a TicketClass is seated) are generated per schedule, not per
/// listing — the same coach's seat 12A is a fresh, independently
/// sellable slot on every departure.
model ListingSchedule {
  id        String  @id @default(uuid()) @db.Uuid
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  departAt           DateTime
  /// Trip arrival estimate, or an event's advertised end time. Optional.
  arriveAt           DateTime?
  /// "Gate B", "Platform 3", "Boarding from 6pm" — free text shown to
  /// ticket holders.
  gateInfo           String?
  /// Vehicle plate / hall name for this specific run, when it varies
  /// occurrence to occurrence.
  vehicleOrHallLabel String?
  status             ScheduleStatus @default(SCHEDULED)
  createdAt          DateTime       @default(now())

  seats    Seat[]
  bookings Booking[]

  @@index([listingId, departAt])
  @@map("listing_schedule")
}

/// A price tier — "VIP", "Regular", "Economy seat", "Business class".
/// `seated: true` means every schedule of this listing gets numbered
/// Seat rows for this class (generated at schedule-creation time);
/// `seated: false` means general admission, sold against `capacity`
/// (remaining = capacity − COUNT(valid tickets) for that schedule).
model TicketClass {
  id        String  @id @default(uuid()) @db.Uuid
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  name      String
  priceKes  Decimal  @db.Decimal(12, 2)
  seated    Boolean  @default(false)
  /// Per-schedule capacity. For seated classes this is also how many
  /// Seat rows get generated per schedule.
  capacity  Int
  createdAt DateTime @default(now())

  seats   Seat[]
  tickets Ticket[]

  @@index([listingId])
  @@map("ticket_class")
}

enum SeatStatus {
  AVAILABLE
  BOOKED
}

/// A numbered seat for one schedule of one seated ticket class —
/// "12A" on the 6am Nairobi–Mombasa coach. Claimed atomically inside
/// createBooking's transaction (status AVAILABLE → BOOKED), which is
/// the whole double-booking guard; there is no separate hold/TTL step
/// in v1.
model Seat {
  id            String          @id @default(uuid()) @db.Uuid
  scheduleId    String          @db.Uuid
  schedule      ListingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  ticketClassId String          @db.Uuid
  ticketClass   TicketClass     @relation(fields: [ticketClassId], references: [id], onDelete: Cascade)

  label  String
  status SeatStatus @default(AVAILABLE)

  ticket Ticket?

  @@unique([scheduleId, label])
  @@index([ticketClassId, status])
  @@map("seat")
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum BookingPaymentMethod {
  MPESA_STK
  CASH
}

/// A checkout — mirrors StoreOrder. The buyer need not be a
/// registered Esoko subject; buyerParty is set only when they are.
model Booking {
  id         String          @id @default(uuid()) @db.Uuid
  scheduleId String          @db.Uuid
  schedule   ListingSchedule @relation(fields: [scheduleId], references: [id])

  buyerPartyId String? @db.Uuid
  buyerParty   Party?  @relation(fields: [buyerPartyId], references: [id])
  buyerName    String
  buyerMsisdn  String

  status        BookingStatus        @default(PENDING_PAYMENT)
  paymentMethod BookingPaymentMethod @default(MPESA_STK)
  totalKes      Decimal              @db.Decimal(12, 2)

  mpesaCheckoutRequestId String?       @unique
  journalEntryId         String?       @unique @db.Uuid
  journalEntry           JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  tickets Ticket[]

  @@index([scheduleId, status])
  @@map("booking")
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

/// One issued seat/slot. `code` is the QR/barcode token scanned at
/// the gate. `priceKes` is snapshotted at booking time so a later
/// TicketClass price change never rewrites history.
model Ticket {
  id            String      @id @default(uuid()) @db.Uuid
  bookingId     String      @db.Uuid
  booking       Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketClassId String      @db.Uuid
  ticketClass   TicketClass @relation(fields: [ticketClassId], references: [id])
  seatId        String?     @unique @db.Uuid
  seat          Seat?       @relation(fields: [seatId], references: [id])

  code         String       @unique
  holderName   String?
  holderMsisdn String?
  priceKes     Decimal      @db.Decimal(12, 2)
  status       TicketStatus @default(VALID)

  checkedInAt   DateTime?
  checkedInById String?         @db.Uuid
  checkedInBy   TicketOrgStaff? @relation(fields: [checkedInById], references: [id])

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([status])
  @@map("ticket")
}
