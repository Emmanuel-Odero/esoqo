# ════════════════════════════════════════════════════════════════════
#  Template for the env file consumed by create-ci-secrets.sh.
#
#      cp deploy/scripts/ci-secrets.env.template ~/esoqo-preview.ci-secrets.env
#      # fill it in, then:
#      deploy/scripts/create-ci-secrets.sh preview ~/esoqo-preview.ci-secrets.env
#
#  ⚠  Same rule as secrets.env.template: copy this OUT of the working
#  tree before filling it in. *.secrets.env is gitignored as a safety
#  net, not permission.
# ════════════════════════════════════════════════════════════════════

# The HMAC secret GitHub signs the push webhook payload with
# (X-Hub-Signature-256). Generate with `openssl rand -hex 32`, and set
# the exact same value as this hook's "Secret" field under the repo's
# Settings → Webhooks when creating it.
WEBHOOK_SECRET=

# A GitHub fine-grained PAT scoped to just this repo, Contents: Read.
# Used by the deployer Job to clone deploy/k8s/... at the triggering
# commit, and by every Kaniko Job to clone its own build context
# straight from GitHub via `--context=git://...`.
GIT_READ_TOKEN=

# A GitHub fine-grained PAT scoped to just this repo, Contents:
# Read and write. Used once per successful deploy to push the overlay
# tag-bump commit back to this branch.
GIT_WRITE_TOKEN=

# GHCR push credentials — same account, a PAT with write:packages.
# Separate from the existing read-only `ghcr` pull secret; this one is
# mounted only into the Kaniko build Jobs.
GHCR_USERNAME=Emmanuel-Odero
GHCR_TOKEN=
