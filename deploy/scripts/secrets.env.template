# ════════════════════════════════════════════════════════════════════
#  Template for the env file consumed by create-secrets.sh.
#
#      cp deploy/scripts/secrets.env.template ~/esoqo-preview.secrets.env
#      # fill it in, then:
#      deploy/scripts/create-secrets.sh preview ~/esoqo-preview.secrets.env
#
#  ⚠  Do not fill this file in and leave it in the repo. Copy it OUT to
#  a path outside the working tree first. The .gitignore entry for
#  *.secrets.env is a safety net, not permission.
#
#  The filled-in copy belongs in a password manager. Deleting it from
#  disk afterwards is fine — the cluster holds the values, and this
#  script can recreate the Secret from the manager at any time.
# ════════════════════════════════════════════════════════════════════

# ── Datastore credentials (required) ────────────────────────────────
# POSTGRES_USER/DB are `esoko`, not `esoqo`: the schema, the existing
# migrations and docker-compose.yml all use that spelling, and renaming
# the role would orphan every object it owns.
POSTGRES_USER=esoko
POSTGRES_DB=esoko
#   openssl rand -hex 24
POSTGRES_PASSWORD=
#   openssl rand -hex 24   — for the unprivileged esoqo_app role
APP_ROLE_PASSWORD=
#   openssl rand -hex 24
REDIS_PASSWORD=

# ── Signing material (required, min 32 chars) ───────────────────────
#   openssl rand -hex 32
#
# SESSION_SECRET  — rotating this signs everyone out. Survivable.
# OTP_PEPPER      — rotating this invalidates every OTP in flight.
#                   Survivable, briefly annoying.
# AUDIT_CHAIN_SEED— rotating this BREAKS the existing hash chain and
#                   `pnpm --filter @esoqo/db audit:verify` will fail
#                   permanently. Set it once, per environment, and never
#                   change it. Preview and production must have
#                   DIFFERENT values.
SESSION_SECRET=
OTP_PEPPER=
AUDIT_CHAIN_SEED=

# ── SMS — Africa's Talking ──────────────────────────────────────────
# Leave blank on preview (SMS_PROVIDER=console there logs instead of
# sending). On production these are required or every OTP throws.
# SMS_USERNAME is literally "sandbox" for the sandbox account.
SMS_USERNAME=
SMS_API_KEY=

# ── Email (SMTP) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── M-Pesa Daraja ───────────────────────────────────────────────────
# MPESA_CALLBACK_SECRET is REQUIRED in both environments — core-go
# refuses to boot with any MPESA_PROVIDER other than console unless it
# is set, and preview uses sandbox.
#
# It is appended to MPESA_CALLBACK_URL as its last path segment, and is
# the ONLY thing authenticating the callback — Daraja signs nothing.
# Generate with `openssl rand -hex 16` and build the URL to match, e.g.
#   MPESA_CALLBACK_SECRET=ab12...ef
#   MPESA_CALLBACK_URL=https://api.esoqo.com/webhooks/mpesa/stk-callback/ab12...ef
# core-go refuses to boot with MPESA_PROVIDER != console unless the
# secret is set.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_URL=

# ── Pesapal ─────────────────────────────────────────────────────────
# PESAPAL_IPN_ID comes from a one-time RegisterIPN call against the
# PESAPAL_IPN_URL in the overlay's config.yaml. It is static after that,
# not requested per order.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

# ── Object storage (Cloudflare R2) ──────────────────────────────────
# If blank, uploads fall back to LOCAL_STORAGE_DIR — which is pod-local
# and therefore LOST on every restart. Fine for preview, not for
# production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Jamii custom domains (Cloudflare for SaaS) ──────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
JAMII_DOMAIN_RECONCILE_SECRET=

# ── Misc ────────────────────────────────────────────────────────────
# FLEET_QR_SECRET is REQUIRED in both environments, not optional.
# core-go refuses to boot without it whenever APP_ENV is not
# development (which is both preview and production here) rather than
# fall back to the dev value published in this repo. Omit it and
# core-go CrashLoopBackOffs.
#   openssl rand -hex 32
FLEET_QR_SECRET=
CECF_SERVICE_SECRET=

# First-admin bootstrap. Set SEED_ADMIN_HASH (not the raw PIN) in
# production, and unset both once a real admin exists.
SEED_ADMIN_PIN=
SEED_ADMIN_HASH=
