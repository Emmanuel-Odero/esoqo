{
  "name": "@esoqo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=3584 next dev --turbopack -p 3000",
    "dev:https": "NODE_OPTIONS=--max-old-space-size=3584 next dev --turbopack --experimental-https -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:a11y": "playwright test",
    "test:pay": "PAY_E2E=1 playwright test --config=playwright.pay.config.ts",
    "test:parking": "PAY_E2E=1 playwright test --config=playwright.pay.config.ts e2e/parking.spec.ts"
  },
  "dependencies": {
    "@esoqo/a11y": "workspace:*",
    "@esoqo/auth": "workspace:*",
    "@esoqo/db": "workspace:*",
    "@esoqo/domain": "workspace:*",
    "@esoqo/payments": "workspace:*",
    "@esoqo/ui": "workspace:*",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@esoqo/config": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
