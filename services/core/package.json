{
  "name": "@esoqo/core-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "verify:pay": "tsx --env-file-if-exists=../../.env scripts/verify-pay-flow.mts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@esoqo/db": "workspace:*",
    "@esoqo/domain": "workspace:*",
    "@esoqo/auth": "workspace:*",
    "@esoqo/payments": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": { "tsx": "^4.19.2", "typescript": "^5.7.2" }
}
