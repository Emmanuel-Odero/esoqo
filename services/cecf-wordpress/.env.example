# Render has no managed MySQL, so cecf-mariadb is a private service we run
# ourselves — see render.yaml. Its internal hostname resolves the same way
# in local docker-compose (service name) and on Render (private service name).
DB_HOST='cecf-mariadb'
DB_PORT='3306'
DB_NAME='cecf'
DB_USER='cecf'
DB_PASSWORD='cecf_dev_only'
DB_PREFIX='wp_'

WP_ENV='development'
WP_HOME='http://childeldercare.test'
WP_SITEURL="${WP_HOME}/wp"

# ── Multisite (subdomain network) ─────────────────────────────
# See config/application.php — these are read there, not by Bedrock core.
MULTISITE_ENABLED='true'
MULTISITE_SUBDOMAIN='true'
MULTISITE_DOMAIN='childeldercare.test'
MULTISITE_PATH='/'
MULTISITE_SITE_ID='1'
MULTISITE_BLOG_ID='1'

# Optional debug.log path
# WP_DEBUG_LOG='/tmp/wp-debug.log'

# ── Object cache / sessions ────────────────────────────────────
REDIS_URL='redis://redis:6379/1'

# ── Media offload (Cloudflare R2, same account as the rest of esoko) ──
R2_ACCOUNT_ID=''
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
R2_BUCKET='cecf-media'
R2_PUBLIC_URL=''

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
