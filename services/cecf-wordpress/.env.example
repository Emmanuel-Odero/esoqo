# cecf-mariadb is a private MySQL/MariaDB service we run ourselves (there is
# no managed MySQL/MariaDB offering). Its internal hostname resolves the same
# way in local docker-compose and in-cluster (both by service name).
DB_HOST='cecf-mariadb'
DB_PORT='3306'
DB_NAME='cecf'
DB_USER='cecf'
DB_PASSWORD='cecf_dev_only'
DB_PREFIX='wp_'

WP_ENV='development'
WP_HOME='http://childeldercare.test'
WP_SITEURL="${WP_HOME}/wp"

# ── Multisite (subdomain network) ─────────────────────────────
# See config/application.php — these are read there, not by Bedrock core.
MULTISITE_ENABLED='true'
MULTISITE_SUBDOMAIN='true'
MULTISITE_DOMAIN='childeldercare.test'
MULTISITE_PATH='/'
MULTISITE_SITE_ID='1'
MULTISITE_BLOG_ID='1'

# Optional debug.log path
# WP_DEBUG_LOG='/tmp/wp-debug.log'

# Where every "Register"/"Apply" CTA sends people. Historically this
# pointed off-site at esoqo's own /join (the local /apply page had no
# working form) — now that the registration wizard is real
# (App\Providers\CecfRegistrationServiceProvider, partials/cecf/
# registrationForm.blade.php), PageUrl::resolve('apply') resolves
# locally by default. Set CECF_LOCAL_REGISTRATION_ENABLED=false to send
# every CTA back to this URL instead, without a deploy, if the local
# flow ever needs pulling in a hurry. See App\Support\PageUrl.
ESOQO_JOIN_URL='http://localhost:3001/join'
CECF_LOCAL_REGISTRATION_ENABLED='true'

# Every "page": "jamii" CTA (see pages/our-jamii.json) — the Our Jamii
# product only ever lives on Esoqo's own app, there's no local
# equivalent. See App\Support\PageUrl::esoqoJamiiUrl().
ESOQO_JAMII_URL='http://localhost:3004/'

# ── CECF ↔ Esoqo registration facade ───────────────────────────
# services/core's authenticated /api/cecf/* facade (App\Support\
# CecfApiClient) — never called from the browser, only from this site's
# own PHP. CECF_SERVICE_SECRET must match the same value in esoqo's own
# .env exactly; rotate both together. In docker-compose, cecf-wordpress
# and esoqo-dev run on the same network, so this is an internal service
# URL, not a public one.
ESOQO_CORE_API_URL='http://esoqo-dev:4000'
CECF_SERVICE_SECRET=''

# Where "Our Jamii" page's CTAs send people — apps/jamii, the community-
# pages platform (a separate app in this monorepo, not a WordPress page).
# See App\Support\PageUrl::jamiiUrl().
JAMII_URL='http://localhost:3004'

# ── Object cache / sessions ────────────────────────────────────
REDIS_URL='redis://redis:6379/1'

# ── Media offload (Cloudflare R2, same account as the rest of esoqo) ──
# Wired up in config/application.php + web/app/mu-plugins/media-policy.php
# (humanmade/s3-uploads plugin, network-activated by docker/entrypoint.sh
# only when R2_ACCOUNT_ID is set). Leave all four unset for local dev —
# uploads fall straight through to wp-content/uploads on local disk, the
# same "dev never touches the production bucket" rule as the rest of
# esoqo. R2_PUBLIC_URL is the bucket's public-read origin (an r2.dev
# subdomain, or a custom domain mapped to the bucket) — WordPress media
# is public content, so unlike apps/jamii's private-proxy /img route,
# this serves attachment URLs straight off that origin.
R2_ACCOUNT_ID=''
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
R2_BUCKET='cecf-media'
R2_PUBLIC_URL=''

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
