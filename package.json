{
  "name": "esoko",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:a11y": "turbo run test:a11y",
    "db:generate": "pnpm --filter @esoko/db generate",
    "db:migrate": "pnpm --filter @esoko/db migrate",
    "db:seed": "pnpm --filter @esoko/db seed",
    "db:studio": "pnpm --filter @esoko/db studio",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v && docker compose up -d",
    "stack:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "@types/node": "^22.10.2"
  }
}
